

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />

    <title>Đổi mật khẩu</title>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta name="description" content="">
    <meta name="keywords" content="">
    <meta name="author" content="">
    <meta name="MobileOptimized" content="320">
    <!--Start Style -->


    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.9.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

    <!-- Favicon Link -->
    <link href="~/Areas/assets/css/auth.css" rel="stylesheet" />

    <style>
        .ad-btl {
            min-width: 170px;
            padding: 0 15px;
            height: 50px;
            line-height: 52px;
            display: inline-block;
            text-align: center;
            color: #fff !important;
            background: var(--main-color);
            text-transform: capitalize;
            font-weight: 500;
            position: relative;
            overflow: hidden;
            border: none;
            border-radius: 5px;
        }

        .ad-auth-box {
            max-height: 600%; /* Tăng kích thước tối đa */
            background: #fff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        .ad-btl:hover,
        .ad-btl:focus {
            color: var(--main-white);
            background: var(--main-color);
        }

        @@media (min-width: 768px) {
            .display1 {
                display: none;
            }

            .ad-auth-box {
                display: flex;
                flex-direction: row;
            }

            .ad-auth-img {
                flex: 1;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 20px;
            }

                .ad-auth-img img {
                    max-width: 100%;
                    border-radius: 10px;
                }

            .ad-auth-content {
                flex: 1;
                padding: 20px;
            }
        }
    </style>
</head>

<body>
    <div class="ad-auth-wrapper">
        <div class="ad-auth-box">
            <div class="row align-items-center">
                <div class="display col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                    <div class="ad-auth-img display1">
                        <img src="~/Areas/Data/upload/files/imageedit_1_5875786148.png" alt="Welcome Image" style="max-width: 100%; height: auto;" />
                    </div>
                </div>
                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                    <div class="ad-auth-content">
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                @TempData["SuccessMessage"]
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                        }

                        <h4 class="mb-30">Đổi mật khẩu thành công</h4>
                        <p class="mb-30">Bạn đã đổi mật khẩu thành công. Vui lòng đăng nhập để tiếp tục.</p>
                        <a href="@Url.Action("Index", "Login")" class="btn btn-primary">Đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
