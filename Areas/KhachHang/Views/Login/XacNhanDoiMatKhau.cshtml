

@model cenDTO.DanhMucKhachHangDoiLenhXacNhanDoiMatKhauRequest
@{
    Layout = null;
    var idKhachHang = TempData["idKhachHang"] as string;
    var emailkhachhang = TempData["emailKhachHang"] as string;

}


<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />

    <title>Đổi mật khẩu</title>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta name="description" content="">
    <meta name="keywords" content="">
    <meta name="author" content="">
    <meta name="MobileOptimized" content="320">
    Start Style
    <link rel="stylesheet" type="text/css" href="~/Areas/assets/css/fonts.css">
    <link rel="stylesheet" type="text/css" href="~/Areas/assets/css/bootstrap.min.css">

    Favicon Link
    <link href="~/Areas/assets/css/auth.css" rel="stylesheet" />

    <style>
        .ad-btl {
            min-width: 170px;
            padding: 0 15px;
            height: 50px;
            line-height: 52px;
            display: inline-block;
            text-align: center;
            color: #fff !important;
            background: var(--main-color);
            text-transform: capitalize;
            font-weight: 500;
            position: relative;
            overflow: hidden;
            border: none;
            border-radius: 5px;
        }

        .ad-auth-box {
            max-height: 600%; /* Tăng kích thước tối đa */
            background: #fff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        .ad-btl:hover,
        .ad-btl:focus {
            color: var(--main-white);
            background: var(--main-color);
        }

        @@media (min-width: 768px) {
            .display1 {
                display: none;
            }

            .ad-auth-box {
                display: flex;
                flex-direction: row;
            }

            .ad-auth-img {
                flex: 1;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 20px;
            }

                .ad-auth-img img {
                    max-width: 100%;
                    border-radius: 10px;
                }

            .ad-auth-content {
                flex: 1;
                padding: 20px;
            }
        }
    </style>
</head>

<body>
    <div class="ad-auth-wrapper">
        <div class="ad-auth-box">
            <div class="row align-items-center">
                <div class="display col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                    <div class="ad-auth-img display1">
                        <img src="~/Areas/Data/upload/files/imageedit_1_5875786148.png" alt="Welcome Image" style="max-width: 100%; height: auto;" />
                    </div>
                </div>
                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                    <div class="ad-auth-content">

                        <div class="text-center mb-4">
                            <h4>Vui lòng nhập đủ thông tin!</h4>
                        </div>

                        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                    <div class="ad-auth-form">
                        @using (Html.BeginForm("XacNhanDoiMatKhau", "Login", FormMethod.Post))
                        {
                            @*<div class="ad-auth-feilds mb-30">
                <input type="hidden" name="ID" value="@idKhachHang" />
            </div>
            <div class="ad-auth-feilds mb-30">
                <input type="hidden" name="Email" value="@emailkhachhang" />
            </div>*@
                            @*@Html.HiddenFor(m => m.ID)
                            @Html.HiddenFor(m => m.Email)*@
                            <div class="ad-auth-feilds">
                                @Html.TextBoxFor(m => m.MatKhauMoi, new { @class = "ad-input mb-30", placeholder = "Mật khẩu mới", type = "password" })

                            </div>
                            <div class="ad-auth-feilds">
                                @Html.TextBoxFor(m => m.XacNhanMatKhauMoi, new { @class = "ad-input mb-30", placeholder = "Xác nhận mật khẩu mới", type = "password" })

                            </div>
                            <div class="ad-auth-feilds">
                                @Html.TextBoxFor(m => m.MaXacNhan, new { @class = "ad-input mb-30", placeholder = "Mã xác nhận" })
                                <button type="submit" class="ad-btl ad-login-member ">Đổi mật khẩu</button>
                            </div>
                        }


                    </div>


                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
