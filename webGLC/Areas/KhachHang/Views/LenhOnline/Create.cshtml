<script type="text/javascript">
    (function () {
        var wizard = document.querySelector('[data-wizard]');
        var resultSection = document.getElementById('query-result-section');
        if (!wizard) {
            return;
        }

        var currentStep = 1;
        var panels = wizard.querySelectorAll('[data-step-panel]');
        var triggers = wizard.querySelectorAll('[data-step-trigger]');
        var errorBox = wizard.querySelector('[data-step-error]');

        function setStep(step) {
            currentStep = step;

            for (var i = 0; i < panels.length; i++) {
                var panel = panels[i];
                var isActive = Number(panel.getAttribute('data-step-panel')) === step;
                panel.classList.toggle('is-active', isActive);
                panel.hidden = !isActive;
            }

            for (var j = 0; j < triggers.length; j++) {
                var trigger = triggers[j];
                var triggerStep = Number(trigger.getAttribute('data-step-trigger'));
                trigger.classList.toggle('is-active', triggerStep === step);
                trigger.classList.toggle('is-complete', triggerStep < step);
            }

            if (errorBox) {
                errorBox.hidden = true;
                errorBox.textContent = '';
            }
        }

        function validateStep(step) {
            var requiredFields = wizard.querySelectorAll('[data-required-step="' + step + '"]');
            for (var i = 0; i < requiredFields.length; i++) {
                var field = requiredFields[i];
                if (!field.value || !field.value.trim()) {
                    if (errorBox) {
                        errorBox.hidden = false;
                        errorBox.textContent = 'Vui lòng nhập ' + (field.getAttribute('data-label') || 'thông tin bắt buộc') + ' trước khi sang bước tiếp theo.';
                    }
                    field.focus();
                    return false;
                }
            }

            if (errorBox) {
                errorBox.hidden = true;
                errorBox.textContent = '';
            }
            return true;
        }

        wizard.addEventListener('click', function (event) {
            var nextButton = event.target.closest('[data-next-step]');
            var prevButton = event.target.closest('[data-prev-step]');
            var trigger = event.target.closest('[data-step-trigger]');

            if (nextButton) {
                var nextStep = Number(nextButton.getAttribute('data-next-step'));
                if (validateStep(currentStep)) {
                    setStep(nextStep);
                }
                return;
            }

            if (prevButton) {
                setStep(Number(prevButton.getAttribute('data-prev-step')));
                return;
            }

            if (trigger) {
                var requestedStep = Number(trigger.getAttribute('data-step-trigger'));
                if (requestedStep <= currentStep) {
                    setStep(requestedStep);
                    return;
                }

                var stepToValidate = currentStep;
                while (stepToValidate < requestedStep) {
                    if (!validateStep(stepToValidate)) {
                        return;
                    }
                    stepToValidate++;
                }
                setStep(requestedStep);
            }
        });

        document.getElementById('query_form').addEventListener('submit', function (event) {
            var firstValid = validateStep(1);
            var secondValid = firstValid ? validateStep(2) : false;
            var thirdValid = firstValid && secondValid ? validateStep(3) : false;

            if (!firstValid || !secondValid || !thirdValid) {
                event.preventDefault();
                if (!firstValid) {
                    setStep(1);
                } else if (!secondValid) {
                    setStep(2);
                } else {
                    setStep(3);
                }
                return;
            }

            event.preventDefault();
            window.renderLenhOnlineQueryResult({
                thuKho: 'Nguyễn Văn A',
                forwarder: 'GLC Logistics',
                tenTau: 'M/V GREEN OCEAN',
                chuHang: document.querySelector('[name="TenKH"]') ? document.querySelector('[name="TenKH"]').value : '',
                soCarton: '64',
                soChuyen: '21013S',
                tinhTrangThongQuan: 'Đã thông quan',
                soHouseBill: document.querySelector('[name="HouseBill"]') ? document.querySelector('[name="HouseBill"]').value : '',
                trongLuong: '1593',
                ngayTauCap: '26/07/2021',
                soCont: document.querySelector('[name="SoCont"]') ? document.querySelector('[name="SoCont"]').value : '',
                soKhoi: '12.5'
            });
        });

        window.hideLenhOnlineQueryResult = function () {
            if (resultSection) {
                resultSection.hidden = true;
            }
        };

        window.renderLenhOnlineQueryResult = function (data) {
            if (!resultSection || !data) {
                return;
            }

            var fields = resultSection.querySelectorAll('[data-query-field]');
            for (var i = 0; i < fields.length; i++) {
                var field = fields[i];
                var key = field.getAttribute('data-query-field');
                var value = data[key];
                field.textContent = value === undefined || value === null || value === '' ? '' : value;
                if (key === 'chuHang') {
                    field.setAttribute('title', field.textContent);
                }
            }

            resultSection.hidden = false;
            resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        };

        if (window.jQuery && jQuery.fn.datetimepicker) {
            jQuery.datetimepicker.setLocale('vi');
            jQuery('.js-order-date').datetimepicker({
                timepicker: false,
                format: 'd/m/Y',
                scrollInput: false,
                closeOnDateSelect: true
            });
        }

        setStep(1);
    })();
</script>

