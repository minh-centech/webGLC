@model webGLC.Areas.KhachHang.Models.KhachHangLoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập khách hàng</title>
    <link rel="stylesheet" type="text/css" href="~/Areas/assets/css/fonts.css">
    <link rel="stylesheet" type="text/css" href="~/Areas/assets/css/bootstrap.min.css">
    <link href="~/Areas/assets/css/auth.css" rel="stylesheet" />
    <style>
        .kh-login-shell {
            min-height: 100vh;
            background: linear-gradient(135deg, #f2fbf5 0%, #e4f6ea 48%, #d8f0df 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            font-family: 'Poppins', sans-serif;
        }

        .kh-login-card {
            width: min(1060px, 100%);
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            background: #fff;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 26px 70px rgba(6, 97, 39, 0.16);
        }

        .kh-login-aside {
            background: linear-gradient(160deg, #008f3d 0%, #0db456 100%);
            color: #fff;
            padding: 42px 38px;
            position: relative;
        }

        .kh-login-badge {
            display: inline-flex;
            padding: 6px 12px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.14);
            font-size: 12px;
            letter-spacing: .08em;
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .kh-login-title {
            font-size: 34px;
            line-height: 1.2;
            font-weight: 700;
            color: #fff;
            margin-bottom: 14px;
        }

        .kh-login-desc {
            color: rgba(255, 255, 255, 0.92);
            line-height: 1.85;
            font-size: 15px;
            margin-bottom: 26px;
        }

        .kh-login-points {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .kh-login-points li {
            position: relative;
            padding-left: 22px;
            margin-bottom: 14px;
            line-height: 1.7;
        }

        .kh-login-points li:before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #fff;
            position: absolute;
            top: 9px;
            left: 0;
        }

        .kh-login-formwrap {
            padding: 42px 38px;
        }

        .kh-login-brand {
            margin-bottom: 22px;
            text-align: center;
        }

        .kh-login-brand img {
            max-width: 180px;
            height: auto;
        }

        .kh-login-heading {
            text-align: center;
            margin-bottom: 22px;
        }

        .kh-login-heading h1 {
            font-size: 30px;
            color: #21352a;
            margin-bottom: 8px;
            font-weight: 700;
        }

        .kh-login-heading p {
            color: #617166;
            line-height: 1.7;
        }

        .kh-login-alert {
            border-radius: 14px;
            padding: 12px 14px;
            margin-bottom: 18px;
            font-size: 14px;
        }

        .kh-login-field {
            margin-bottom: 18px;
        }

        .kh-login-label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 600;
            color: #284332;
        }

        .kh-login-input {
            width: 100%;
            min-height: 52px;
            border-radius: 14px;
            border: 1px solid #d6e9db;
            background: #fbfdfb;
            padding: 0 16px;
            font-size: 15px;
            color: #1f2f24;
            transition: border-color .2s ease, box-shadow .2s ease, background-color .2s ease;
        }

        .kh-login-input:focus {
            border-color: #08a24b;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(8, 162, 75, 0.12);
        }

        .field-validation-error,
        .validation-summary-errors {
            color: #c83b2d;
            font-size: 13px;
        }

        .field-validation-error {
            display: block;
            margin-top: 7px;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }

        .kh-login-submit {
            width: 100%;
            min-height: 52px;
            border: 0;
            border-radius: 14px;
            background: linear-gradient(135deg, #008f3d 0%, #12b257 100%);
            color: #fff;
            font-size: 15px;
            font-weight: 700;
            box-shadow: 0 14px 30px rgba(0, 143, 61, 0.22);
        }

        .kh-login-submit:hover,
        .kh-login-submit:focus {
            color: #fff;
            opacity: .96;
        }

        .kh-login-links {
            margin-top: 18px;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .kh-login-link,
        .kh-login-secondary {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            min-height: 46px;
            padding: 10px 12px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 600;
            text-align: center;
        }

        .kh-login-link {
            background: #f4faf6;
            color: #0a8f40;
            border: 1px solid #d8ebde;
        }

        .kh-login-secondary {
            margin-top: 12px;
            width: 100%;
            border: 1px dashed #cfe3d5;
            color: #415548;
            background: #fff;
        }

        @@media (max-width: 991px) {
            .kh-login-card {
                grid-template-columns: 1fr;
            }

            .kh-login-aside,
            .kh-login-formwrap {
                padding: 28px 22px;
            }
        }

        @@media (max-width: 576px) {
            .kh-login-shell {
                padding: 14px;
            }

            .kh-login-card {
                border-radius: 20px;
            }

            .kh-login-title {
                font-size: 28px;
            }

            .kh-login-heading h1 {
                font-size: 26px;
            }

            .kh-login-links {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="kh-login-shell">
        <div class="kh-login-card">
            <aside class="kh-login-aside">
                <div class="kh-login-badge">GLC eWarehouse</div>
                <h2 class="kh-login-title">Đăng nhập để quản lý lệnh và tra cứu thông tin hàng nhanh hơn</h2>
                <p class="kh-login-desc">
                    Không gian khách hàng giúp bạn theo dõi trạng thái hồ sơ, tạo lệnh online và chủ động làm việc với bộ phận vận hành trong một luồng thống nhất.
                </p>
                <ul class="kh-login-points">
                    <li>Tạo và theo dõi lệnh online thuận tiện.</li>
                    <li>Tra cứu thông tin hàng nhập và lịch lấy hàng nhanh.</li>
                    <li>Giảm thao tác rời rạc, tập trung vào đúng nghiệp vụ cần xử lý.</li>
                </ul>
            </aside>

            <section class="kh-login-formwrap">
                <div class="kh-login-brand">
                    <img src="~/Areas/Data/upload/files/imageedit_1_5875786148.png" alt="GLC eWarehouse" />
                </div>

                <div class="kh-login-heading">
                    <h1>Đăng nhập khách hàng</h1>
                    <p>Vui lòng nhập email và mật khẩu đã được cấp để truy cập hệ thống.</p>
                </div>

                @using (Html.BeginForm("Index", "Login", FormMethod.Post, new { novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(false, "", new { @class = "kh-login-alert validation-summary-errors" })

                    <div class="kh-login-field">
                        <label class="kh-login-label" for="Email">Email</label>
                        @Html.TextBoxFor(m => m.Email, new
                        {
                            @class = "kh-login-input",
                            type = "email",
                            autocomplete = "username",
                            placeholder = "name@company.com"
                        })
                        @Html.ValidationMessageFor(m => m.Email)
                    </div>

                    <div class="kh-login-field">
                        <label class="kh-login-label" for="Password">Mật khẩu</label>
                        @Html.PasswordFor(m => m.Password, new
                        {
                            @class = "kh-login-input",
                            autocomplete = "current-password",
                            placeholder = "Nhập mật khẩu"
                        })
                        @Html.ValidationMessageFor(m => m.Password)
                    </div>

                    <button type="submit" class="kh-login-submit">Đăng nhập</button>

                    <div class="kh-login-links">
                        <a href="@Url.Action("Register", "Login")" class="kh-login-link">Đăng ký tài khoản</a>
                        <a href="@Url.Action("GetMaXacNhanByEmail", "Login")" class="kh-login-link">Quên mật khẩu</a>
                    </div>

                    <a href="@Url.Action("getMaKichHoatByEmail", "Login")" class="kh-login-secondary">Kích hoạt tài khoản</a>
                }
            </section>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>
