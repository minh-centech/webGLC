@model webGLC.Areas.KhachHang.Models.DangKyTaiKhoanViewModel
@using System.Configuration
@{
    Layout = "~/Areas/KhachHang/Views/Shared/_Layout.cshtml";
    var apiBaseUrl = ConfigurationManager.AppSettings["ApiBaseUrl"] ?? string.Empty;
}

<style>
    :root {
        --kh-green-50: #f3fbf5;
        --kh-green-100: #e5f6e9;
        --kh-green-200: #ccecd4;
        --kh-green-300: #a9ddb6;
        --kh-green-500: #2f9d57;
        --kh-green-600: #1f8b47;
        --kh-green-700: #166e37;
        --kh-green-900: #1f3528;
        --kh-accent: #ff6b42;
    }

    body {
        margin: 0;
        background: linear-gradient(180deg, #f4fbf5 0%, #edf8f0 100%);
        color: var(--kh-green-900);
    }

    .kh-register-shell {
        max-width: 1440px;
        margin: 0 auto;
        padding: 32px 24px 48px;
    }

    .kh-register-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid rgba(47, 157, 87, 0.10);
        box-shadow: 0 20px 52px rgba(20, 86, 44, 0.12);
        padding: 32px;
    }

    .kh-register-toolbar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 20px;
    }

    .kh-register-toolbar-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .kh-toolbar-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 16px;
        border-radius: 999px;
        border: 1px solid var(--kh-green-200);
        background: var(--kh-green-50);
        color: var(--kh-green-700);
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
    }

    .kh-toolbar-link:hover,
    .kh-toolbar-link:focus {
        background: var(--kh-green-100);
        color: var(--kh-green-700);
        text-decoration: none;
    }

    .kh-register-title {
        font-size: 40px;
        line-height: 1.1;
        color: var(--kh-green-700);
        margin: 0 0 8px;
        text-transform: uppercase;
    }

    .kh-register-note {
        margin-bottom: 28px;
        font-size: 15px;
        color: #365041;
    }

    .kh-register-note a {
        color: var(--kh-accent);
        font-weight: 700;
        text-decoration: none;
    }

    .kh-account-type {
        max-width: 380px;
        margin-bottom: 28px;
    }

    .kh-label {
        display: block;
        margin-bottom: 8px;
        font-size: 15px;
        color: var(--kh-green-700);
    }

    .kh-required {
        color: var(--kh-accent);
    }

    .kh-input,
    .kh-select,
    .kh-date,
    .kh-upload-status {
        width: 100%;
        min-height: 48px;
        border: 1px solid var(--kh-green-200);
        border-radius: 6px;
        padding: 12px 14px;
        font-size: 15px;
        color: var(--kh-green-900);
        background: #fcfefc;
        box-sizing: border-box;
    }

    .kh-input:focus,
    .kh-select:focus,
    .kh-date:focus {
        outline: none;
        border-color: var(--kh-green-500);
        box-shadow: 0 0 0 3px rgba(47, 157, 87, 0.14);
    }

    .kh-stepper {
        display: none;
        gap: 12px;
        margin-bottom: 24px;
    }

    .kh-stepper.enterprise {
        display: flex;
    }

    .kh-step-pill {
        flex: 1;
        padding: 14px 18px;
        border-radius: 999px;
        border: 1px solid var(--kh-green-200);
        background: var(--kh-green-50);
        color: #5f7a69;
        font-weight: 700;
        font-size: 14px;
    }

    .kh-step-pill.active {
        background: linear-gradient(135deg, var(--kh-green-600) 0%, var(--kh-green-500) 100%);
        border-color: var(--kh-green-600);
        color: #fff;
    }

    .kh-step-panel {
        display: none;
    }

    .kh-step-panel.active {
        display: block;
    }

    .kh-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px 24px;
    }

    .kh-inline-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .kh-inline-actions .kh-input {
        flex: 1;
    }

    .kh-inline-status {
        font-size: 13px;
        color: #5d7566;
    }

    .kh-inline-status.error {
        color: #d14c4c;
    }

    .kh-inline-status.success {
        color: #23783b;
    }

    .kh-col-span-2 {
        grid-column: span 2;
    }

    .kh-section-title {
        margin: 8px 0 4px;
        font-size: 17px;
        color: var(--kh-green-700);
        text-transform: uppercase;
    }

    .kh-form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .kh-hint {
        margin-top: -2px;
        font-size: 12px;
        color: #67826f;
        font-style: italic;
    }

    .kh-upload-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .kh-upload-button {
        position: relative;
        overflow: hidden;
        background: var(--kh-green-100);
        color: var(--kh-green-700);
        border: 1px solid var(--kh-green-200);
        border-radius: 6px;
        padding: 10px 14px;
        font-weight: 700;
        cursor: pointer;
    }

    .kh-upload-button input[type=file] {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    .kh-upload-status {
        flex: 1;
        display: flex;
        align-items: center;
        color: #5d7566;
    }

    .kh-upload-status.success {
        border-color: #79b871;
        background: #f4fbf3;
        color: #23783b;
    }

    .kh-upload-status.error {
        border-color: #f1a6a6;
        background: #fff4f4;
        color: #d14c4c;
    }

    .kh-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 28px;
    }

    .kh-btn {
        min-width: 160px;
        height: 48px;
        border: none;
        border-radius: 8px;
        padding: 0 18px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
    }

    .kh-btn-secondary {
        background: var(--kh-green-100);
        color: var(--kh-green-700);
        border: 1px solid var(--kh-green-200);
    }

    .kh-btn-primary {
        background: linear-gradient(135deg, var(--kh-green-600) 0%, var(--kh-green-500) 100%);
        color: #fff;
        box-shadow: 0 14px 28px rgba(31, 139, 71, 0.18);
    }

    .field-validation-error,
    .validation-summary-errors {
        color: #d33f49;
        font-size: 13px;
    }

    .validation-summary-errors ul {
        margin: 0 0 16px;
        padding-left: 18px;
    }

    .kh-personal-only.hidden,
    .kh-enterprise-only.hidden,
    .kh-enterprise-actions.hidden,
    .kh-personal-actions.hidden {
        display: none;
    }

    @@media (max-width: 991px) {
        .kh-register-shell {
            padding: 20px 12px 32px;
        }

        .kh-register-card {
            padding: 20px;
        }

        .kh-register-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .kh-register-title {
            font-size: 30px;
        }

        .kh-grid {
            grid-template-columns: 1fr;
        }

        .kh-col-span-2 {
            grid-column: span 1;
        }

        .kh-actions {
            flex-direction: column-reverse;
        }

        .kh-btn {
            width: 100%;
        }
    }
</style>

<div class="kh-register-shell">
    <div class="kh-register-card">
        @using (Html.BeginForm("Register", "Login", FormMethod.Post, new { autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.IsActive)
            @Html.HiddenFor(m => m.BanScanGiayPhepKinhDoanhPath)
            @Html.HiddenFor(m => m.BanDangKyEPortChuKySoPath)
            @Html.HiddenFor(m => m.BanScanSoCMNDCanCuocPath)
            @Html.HiddenFor(m => m.BanDangKyCaNhanCoChuKyPath)

            <div class="kh-register-toolbar">
                <div>
                    <h1 class="kh-register-title">Đăng ký tài khoản</h1>
                    <div class="kh-register-note">
                        Vui lòng điền thông tin vào form dưới đây hoặc đọc
                        <a href="~/Areas/Data/upload/files/Mau-dang-ky-dich-vu-%20E-%20Warehouse-GLC-doanh-nghiep.doc" target="_blank">file đăng ký</a>
                        và gửi về cho chúng tôi.
                    </div>
                </div>
                <div class="kh-register-toolbar-actions">
                    <a class="kh-toolbar-link" href="@Url.Action("Index", "Home", new { area = "KhachHang" })">Đóng</a>
                    <a class="kh-toolbar-link" href="javascript:void(0)" onclick="window.history.back(); return false;">Quay lại</a>
                </div>
            </div>

            @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })

            <div class="kh-account-type">
                <label class="kh-label" for="LoaiTaiKhoan">Loại tài khoản <span class="kh-required">*</span></label>
                @Html.DropDownListFor(
                    m => m.LoaiTaiKhoan,
                    new SelectList(new[]
                    {
                        new { Value = 1, Text = "Cá nhân" },
                        new { Value = 2, Text = "Doanh nghiệp" }
                    }, "Value", "Text", Model.LoaiTaiKhoan),
                    new { @class = "kh-select", id = "LoaiTaiKhoan" })
            </div>

            <div id="enterpriseStepper" class="kh-stepper">
                <div class="kh-step-pill active" data-step="1">Bước 1. Thông tin doanh nghiệp</div>
                <div class="kh-step-pill" data-step="2">Bước 2. Đại diện doanh nghiệp đăng ký dịch vụ</div>
            </div>

            <section id="enterpriseStep1" class="kh-step-panel active">
                <h2 class="kh-section-title kh-enterprise-only">Thông tin doanh nghiệp</h2>
                <div class="kh-grid">
                    <div class="kh-form-group kh-col-span-2 kh-enterprise-only">
                        <label class="kh-label">Tên doanh nghiệp <span class="kh-required">*</span></label>
                        @Html.TextBoxFor(m => m.TenDoanhNghiep, new { @class = "kh-input", placeholder = "Vui lòng nhập tên doanh nghiệp" })
                        @Html.ValidationMessageFor(m => m.TenDoanhNghiep)
                    </div>

                    <div class="kh-form-group kh-col-span-2 kh-enterprise-only">
                        <label class="kh-label">Địa chỉ <span class="kh-required">*</span></label>
                        @Html.TextBoxFor(m => m.DiaChi, new { @class = "kh-input", placeholder = "Vui lòng nhập địa chỉ" })
                        @Html.ValidationMessageFor(m => m.DiaChi)
                    </div>

                    <div class="kh-form-group kh-enterprise-only" id="taxCodeGroup">
                        <label class="kh-label">Mã số thuế <span class="kh-required">*</span></label>
                        <div class="kh-inline-actions">
                            @Html.TextBoxFor(m => m.MaSoThue, new { @class = "kh-input", placeholder = "Vui lòng nhập mã số thuế", id = "MaSoThue" })
                            <button type="button" id="fetchBusinessButton" class="kh-btn kh-btn-secondary">Lấy thông tin doanh nghiệp</button>
                        </div>
                        <div id="businessLookupStatus" class="kh-inline-status"></div>
                        @Html.ValidationMessageFor(m => m.MaSoThue)
                    </div>

                    <div class="kh-form-group kh-enterprise-only">
                        <label class="kh-label">SĐT doanh nghiệp <span class="kh-required">*</span></label>
                        @Html.TextBoxFor(m => m.SoDienThoaiDoanhNghiep, new { @class = "kh-input", placeholder = "Vui lòng nhập số điện thoại doanh nghiệp" })
                        @Html.ValidationMessageFor(m => m.SoDienThoaiDoanhNghiep)
                    </div>

                    <div class="kh-form-group kh-enterprise-only">
                        <label class="kh-label">Số fax</label>
                        @Html.TextBoxFor(m => m.SoFax, new { @class = "kh-input", placeholder = "Vui lòng nhập số fax" })
                    </div>

                    <div class="kh-form-group kh-enterprise-only">
                        <label class="kh-label">Email doanh nghiệp <span class="kh-required">*</span></label>
                        @Html.TextBoxFor(m => m.EmailDoanhNghiep, new { @class = "kh-input", placeholder = "Vui lòng nhập email doanh nghiệp" })
                        @Html.ValidationMessageFor(m => m.EmailDoanhNghiep)
                    </div>

                    <div class="kh-form-group kh-col-span-2 kh-enterprise-only">
                        <label class="kh-label">Giấy phép kinh doanh</label>
                        @Html.TextBoxFor(m => m.GiayPhepKinhDoanh, new { @class = "kh-input", placeholder = "Vui lòng nhập giấy phép kinh doanh" })
                    </div>

                    <div class="kh-form-group kh-enterprise-only">
                        <label class="kh-label">Ngày cấp</label>
                        @Html.TextBoxFor(m => m.NgayCap, "{0:yyyy-MM-dd}", new { @class = "kh-date", type = "date" })
                    </div>

                    <div class="kh-form-group kh-enterprise-only">
                        <label class="kh-label">Nơi cấp</label>
                        @Html.TextBoxFor(m => m.NoiCap, new { @class = "kh-input", placeholder = "Vui lòng nhập nơi cấp" })
                    </div>

                    <div class="kh-form-group kh-col-span-2 kh-enterprise-only">
                        <label class="kh-label">Bản scan giấy phép kinh doanh (PDF)</label>
                        <div class="kh-upload-wrap">
                            <label class="kh-upload-button">
                                Chọn file PDF
                                <input type="file" data-target="BanScanGiayPhepKinhDoanhPath" data-status="businessLicenseStatus" data-folder="NguoiDungDoanhNghiep/GiayPhepKinhDoanh" accept=".pdf" />
                            </label>
                            <div id="businessLicenseStatus" class="kh-upload-status">Chưa tải tài liệu</div>
                        </div>
                    </div>

                    <div class="kh-form-group kh-enterprise-only">
                        <label class="kh-label">Đại diện có thẩm quyền</label>
                        @Html.TextBoxFor(m => m.DaiDienCoThamQuyen, new { @class = "kh-input", placeholder = "Vui lòng nhập đại diện có thẩm quyền" })
                    </div>

                    <div class="kh-form-group kh-enterprise-only">
                        <label class="kh-label">Chức vụ</label>
                        @Html.TextBoxFor(m => m.ChucVu, new { @class = "kh-input", placeholder = "Vui lòng nhập chức vụ" })
                    </div>

                    <div class="kh-form-group kh-col-span-2 kh-enterprise-only">
                        <label class="kh-label">Doanh nghiệp/Công ty được ủy quyền</label>
                        @Html.TextBoxFor(m => m.DoanhNghiepCongTyDuocUyQuyen, new { @class = "kh-input", placeholder = "Vui lòng nhập doanh nghiệp/công ty được ủy quyền" })
                    </div>

                    <div class="kh-form-group kh-col-span-2 kh-enterprise-only">
                        <label class="kh-label">Bản đăng ký ePort có chữ ký số (PDF)</label>
                        <div class="kh-upload-wrap">
                            <label class="kh-upload-button">
                                Chọn file PDF
                                <input type="file" data-target="BanDangKyEPortChuKySoPath" data-status="eportStatus" data-folder="NguoiDungDoanhNghiep/DangKyEPort" accept=".pdf" />
                            </label>
                            <div id="eportStatus" class="kh-upload-status">Chưa tải tài liệu</div>
                        </div>
                    </div>

                    <div class="kh-form-group kh-col-span-2 kh-personal-only">
                        <label class="kh-label">Bản đăng ký scan của cá nhân có chữ ký (PDF)</label>
                        <div class="kh-upload-wrap">
                            <label class="kh-upload-button">
                                Chọn file PDF
                                <input type="file" data-target="BanDangKyCaNhanCoChuKyPath" data-status="personalRegistrationStatus" data-folder="KhachHangCaNhan/DangKy" accept=".pdf" />
                            </label>
                            <div id="personalRegistrationStatus" class="kh-upload-status">Chưa tải tài liệu</div>
                        </div>
                    </div>
                </div>
            </section>

            <section id="accountStep" class="kh-step-panel">
                <h2 class="kh-section-title">
                    <span class="kh-enterprise-only">Đại diện doanh nghiệp đăng ký dịch vụ ePort</span>
                    <span class="kh-personal-only">Thông tin tài khoản cá nhân</span>
                </h2>

                <div class="kh-grid">
                    <div class="kh-form-group">
                        <label class="kh-label">Tên đăng nhập</label>
                        @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "kh-input", placeholder = "Vui lòng nhập tên đăng nhập" })
                    </div>

                    <div class="kh-form-group">
                        <label class="kh-label">Mật khẩu <span class="kh-required">*</span></label>
                        @Html.PasswordFor(m => m.Password, new { @class = "kh-input", placeholder = "Vui lòng nhập mật khẩu" })
                        @Html.ValidationMessageFor(m => m.Password)
                        <div class="kh-hint">Mật khẩu nên có ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</div>
                    </div>

                    <div class="kh-form-group">
                        <label class="kh-label">Họ và tên <span class="kh-required">*</span></label>
                        @Html.TextBoxFor(m => m.Ten, new { @class = "kh-input", placeholder = "Vui lòng nhập họ và tên" })
                        @Html.ValidationMessageFor(m => m.Ten)
                    </div>

                    <div class="kh-form-group">
                        <label class="kh-label">Xác nhận mật khẩu <span class="kh-required">*</span></label>
                        @Html.PasswordFor(m => m.PasswordConfirm, new { @class = "kh-input", placeholder = "Vui lòng nhập lại mật khẩu" })
                        @Html.ValidationMessageFor(m => m.PasswordConfirm)
                    </div>

                    <div class="kh-form-group">
                        <label class="kh-label">Số điện thoại <span class="kh-required">*</span></label>
                        @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "kh-input", placeholder = "Vui lòng nhập số điện thoại" })
                        @Html.ValidationMessageFor(m => m.SoDienThoai)
                    </div>

                    <div class="kh-form-group">
                        <label class="kh-label">Email <span class="kh-required">*</span></label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "kh-input", placeholder = "Vui lòng nhập email" })
                        @Html.ValidationMessageFor(m => m.Email)
                    </div>

                    <div class="kh-form-group">
                        <label class="kh-label">Email xuất hóa đơn</label>
                        @Html.TextBoxFor(m => m.EmailXuatHoaDon, new { @class = "kh-input", placeholder = "Vui lòng nhập email xuất hóa đơn" })
                    </div>

                    <div class="kh-form-group">
                        <label class="kh-label">Số CMND / Căn cước</label>
                        @Html.TextBoxFor(m => m.SoCMNDCanCuoc, new { @class = "kh-input", placeholder = "Vui lòng nhập số CMND / căn cước" })
                    </div>

                    <div class="kh-form-group kh-col-span-2">
                        <label class="kh-label">Bản scan số CMND / Căn cước (PDF)</label>
                        <div class="kh-upload-wrap">
                            <label class="kh-upload-button">
                                Chọn file PDF
                                <input type="file" data-target="BanScanSoCMNDCanCuocPath" data-status="citizenStatus" data-folder="NguoiDungDoanhNghiep/CanCuoc" accept=".pdf" />
                            </label>
                            <div id="citizenStatus" class="kh-upload-status">Chưa tải tài liệu</div>
                        </div>
                    </div>
                </div>
            </section>

            <div id="enterpriseActions" class="kh-actions kh-enterprise-actions">
                <button type="button" id="nextStepButton" class="kh-btn kh-btn-primary">Tiếp tục bước 2</button>
            </div>

            <div id="accountActions" class="kh-actions kh-personal-actions">
                <button type="button" id="backStepButton" class="kh-btn kh-btn-secondary kh-enterprise-only">Quay lại bước 1</button>
                <button type="submit" class="kh-btn kh-btn-primary">Đăng ký tài khoản</button>
            </div>
        }
    </div>
</div>

<script>
    (function () {
        var apiBaseUrl = '@apiBaseUrl'.replace(/\/$/, '');
        var accountTypeSelect = document.getElementById('LoaiTaiKhoan');
        var enterpriseStepper = document.getElementById('enterpriseStepper');
        var enterpriseActions = document.getElementById('enterpriseActions');
        var accountActions = document.getElementById('accountActions');
        var enterpriseOnly = document.querySelectorAll('.kh-enterprise-only');
        var personalOnly = document.querySelectorAll('.kh-personal-only');
        var step1Panel = document.getElementById('enterpriseStep1');
        var accountStepPanel = document.getElementById('accountStep');
        var stepPills = document.querySelectorAll('.kh-step-pill');
        var nextStepButton = document.getElementById('nextStepButton');
        var backStepButton = document.getElementById('backStepButton');
        var fetchBusinessButton = document.getElementById('fetchBusinessButton');
        var taxCodeGroup = document.getElementById('taxCodeGroup');
        var maSoThueInput = document.getElementById('MaSoThue');
        var tenDoanhNghiepInput = document.getElementById('TenDoanhNghiep');
        var diaChiInput = document.getElementById('DiaChi');
        var businessLookupStatus = document.getElementById('businessLookupStatus');
        var hiddenInputs = {
            BanScanGiayPhepKinhDoanhPath: document.getElementById('BanScanGiayPhepKinhDoanhPath'),
            BanDangKyEPortChuKySoPath: document.getElementById('BanDangKyEPortChuKySoPath'),
            BanScanSoCMNDCanCuocPath: document.getElementById('BanScanSoCMNDCanCuocPath'),
            BanDangKyCaNhanCoChuKyPath: document.getElementById('BanDangKyCaNhanCoChuKyPath')
        };

        function ensurePersonalRegistrationUpload() {
            var accountGrid = accountStepPanel ? accountStepPanel.querySelector('.kh-grid') : null;
            if (!accountGrid || document.getElementById('personalRegistrationStatusRendered')) {
                return;
            }

            var wrapper = document.createElement('div');
            wrapper.className = 'kh-form-group kh-col-span-2 kh-personal-only';
            wrapper.innerHTML = [
                '<label class="kh-label">Bản đăng ký scan của cá nhân có chữ ký (PDF)</label>',
                '<div class="kh-upload-wrap">',
                '    <label class="kh-upload-button">',
                '        Chọn file PDF',
                '        <input type="file" data-target="BanDangKyCaNhanCoChuKyPath" data-status="personalRegistrationStatusRendered" data-folder="KhachHangCaNhan/DangKy" accept=".pdf" />',
                '    </label>',
                '    <div id="personalRegistrationStatusRendered" class="kh-upload-status">Chưa tải tài liệu</div>',
                '</div>'
            ].join('');

            accountGrid.appendChild(wrapper);
        }

        function setStep(stepNumber) {
            var isEnterprise = parseInt(accountTypeSelect.value || '1', 10) === 2;

            if (!isEnterprise) {
                step1Panel.classList.remove('active');
                accountStepPanel.classList.add('active');
                enterpriseStepper.classList.remove('enterprise');
                enterpriseActions.classList.add('hidden');
                accountActions.classList.remove('hidden');
                toggleElements(enterpriseOnly, false);
                toggleElements(personalOnly, true);
                return;
            }

            enterpriseStepper.classList.add('enterprise');
            toggleElements(enterpriseOnly, true);
            toggleElements(personalOnly, false);

            if (stepNumber === 1) {
                step1Panel.classList.add('active');
                accountStepPanel.classList.remove('active');
                enterpriseActions.classList.remove('hidden');
                accountActions.classList.add('hidden');
            } else {
                step1Panel.classList.remove('active');
                accountStepPanel.classList.add('active');
                enterpriseActions.classList.add('hidden');
                accountActions.classList.remove('hidden');
            }

            Array.prototype.forEach.call(stepPills, function (pill) {
                pill.classList.toggle('active', parseInt(pill.getAttribute('data-step'), 10) === stepNumber);
            });
        }

        function toggleElements(elements, visible) {
            Array.prototype.forEach.call(elements, function (element) {
                element.classList.toggle('hidden', !visible);
            });
        }

        function setBusinessLookupStatus(message, type) {
            if (!businessLookupStatus) {
                return;
            }

            businessLookupStatus.className = 'kh-inline-status' + (type ? ' ' + type : '');
            businessLookupStatus.textContent = message || '';
        }

        function moveTaxCodeToTop() {
            if (!taxCodeGroup || !taxCodeGroup.parentNode) {
                return;
            }

            taxCodeGroup.parentNode.insertBefore(taxCodeGroup, taxCodeGroup.parentNode.firstElementChild);
        }

        function fetchBusinessInfo() {
            var taxCode = maSoThueInput ? (maSoThueInput.value || '').trim() : '';
            if (!taxCode) {
                setBusinessLookupStatus('Vui lòng nhập mã số thuế trước khi lấy thông tin.', 'error');
                if (maSoThueInput) {
                    maSoThueInput.focus();
                }
                return;
            }

            setBusinessLookupStatus('Đang lấy thông tin doanh nghiệp...', '');
            fetch('https://api.vietqr.io/v2/business/' + encodeURIComponent(taxCode), {
                method: 'GET'
            })
            .then(function (response) {
                return response.json();
            })
            .then(function (result) {
                if (!result || result.code !== '00' || !result.data) {
                    throw new Error(result && result.desc ? result.desc : 'Không lấy được thông tin doanh nghiệp.');
                }

                if (tenDoanhNghiepInput) {
                    tenDoanhNghiepInput.value = result.data.name || '';
                }

                if (diaChiInput) {
                    diaChiInput.value = result.data.address || '';
                }

                setBusinessLookupStatus('Đã tự động điền tên doanh nghiệp và địa chỉ.', 'success');
            })
            .catch(function (error) {
                setBusinessLookupStatus(error.message || 'Không lấy được thông tin doanh nghiệp.', 'error');
            });
        }

        function uploadFile(fileInput) {
            if (!fileInput.files || fileInput.files.length === 0) {
                return;
            }

            var file = fileInput.files[0];
            var targetInput = hiddenInputs[fileInput.getAttribute('data-target')];
            var status = document.getElementById(fileInput.getAttribute('data-status'));
            var folder = fileInput.getAttribute('data-folder') || 'NguoiDungDoanhNghiep';

            if (!/\.pdf$/i.test(file.name)) {
                status.className = 'kh-upload-status error';
                status.textContent = 'Chỉ hỗ trợ file PDF.';
                fileInput.value = '';
                return;
            }

            var formData = new FormData();
            formData.append('file', file);

            status.className = 'kh-upload-status';
            status.textContent = 'Đang tải file...';

            fetch(apiBaseUrl + '/api/TaiLieu/UploadPdf?folder=' + encodeURIComponent(folder), {
                method: 'POST',
                body: formData
            })
            .then(function (response) { return response.json(); })
            .then(function (result) {
                if (!result || result.Status !== 0 || !result.Data) {
                    throw new Error(result && result.ErrorMsg ? result.ErrorMsg : 'Upload file không thành công.');
                }

                var data = JSON.parse(result.Data);
                targetInput.value = data.RelativePath || '';
                status.className = 'kh-upload-status success';
                status.textContent = data.OriginalFileName + ' đã tải thành công';
            })
            .catch(function (error) {
                targetInput.value = '';
                status.className = 'kh-upload-status error';
                status.textContent = error.message || 'Upload file không thành công.';
            });
        }

        accountTypeSelect.addEventListener('change', function () {
            setStep(parseInt(accountTypeSelect.value || '1', 10) === 2 ? 1 : 2);
        });

        nextStepButton.addEventListener('click', function () {
            setStep(2);
        });

        if (backStepButton) {
            backStepButton.addEventListener('click', function () {
                setStep(1);
            });
        }

        if (fetchBusinessButton) {
            fetchBusinessButton.addEventListener('click', function () {
                fetchBusinessInfo();
            });
        }

        ensurePersonalRegistrationUpload();

        Array.prototype.forEach.call(document.querySelectorAll('input[type="file"][data-target]'), function (input) {
            input.addEventListener('change', function () {
                uploadFile(input);
            });
        });

        moveTaxCodeToTop();
        setStep(parseInt(accountTypeSelect.value || '1', 10) === 2 ? 1 : 2);
    })();
</script>
