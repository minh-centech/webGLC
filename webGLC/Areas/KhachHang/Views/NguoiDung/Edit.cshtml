@model webGLC.Areas.KhachHang.Models.DoanhNghiepEditViewModel
@using System.Configuration
@{
    ViewBag.Title = Model.ID.HasValue ? "Cập nhật doanh nghiệp" : "Thêm doanh nghiệp";
    Layout = "~/Areas/KhachHang/Views/Shared/_Layout.cshtml";
    var apiBaseUrl = ConfigurationManager.AppSettings["ApiBaseUrl"] ?? string.Empty;
}

<style>
    .kh-company-form-shell { max-width: 1220px; margin: 0 auto; padding: 32px 24px 48px; }
    .kh-company-form-card { background:#fff; border-radius:20px; border:1px solid rgba(47,157,87,.10); box-shadow:0 20px 52px rgba(20,86,44,.12); padding:28px; }
    .kh-company-form-header { display:flex; justify-content:space-between; gap:16px; align-items:flex-start; margin-bottom:24px; }
    .kh-company-form-title { margin:0 0 8px; font-size:34px; color:#166e37; text-transform:uppercase; }
    .kh-company-form-subtitle { margin:0; color:#4a6552; line-height:1.7; }
    .kh-company-form-link { display:inline-flex; align-items:center; justify-content:center; min-height:42px; padding:10px 16px; border-radius:999px; background:#f3fbf5; color:#166e37; border:1px solid #ccecd4; font-weight:700; text-decoration:none; }
    .kh-company-grid { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:18px 24px; }
    .kh-company-col-span-2 { grid-column:span 2; }
    .kh-company-group { display:flex; flex-direction:column; gap:8px; }
    .kh-inline-actions { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
    .kh-inline-actions .kh-company-input { flex:1; }
    .kh-inline-status { font-size:13px; color:#5d7566; }
    .kh-inline-status.error { color:#d14c4c; }
    .kh-inline-status.success { color:#23783b; }
    .kh-company-label { display:block; margin-bottom:8px; font-size:15px; color:#166e37; }
    .kh-company-required { color:#ff6b42; }
    .kh-company-input, .kh-company-date, .kh-company-upload-status { width:100%; min-height:48px; border:1px solid #ccecd4; border-radius:10px; padding:12px 14px; font-size:15px; color:#1f3528; background:#fcfefc; box-sizing:border-box; }
    .kh-company-input:focus, .kh-company-date:focus { outline:none; border-color:#2f9d57; box-shadow:0 0 0 3px rgba(47,157,87,.14); }
    .field-validation-error, .validation-summary-errors { color:#d33f49; font-size:13px; }
    .validation-summary-errors ul { margin:0 0 16px; padding-left:18px; }
    .kh-company-upload-wrap { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
    .kh-company-upload-button { position:relative; overflow:hidden; background:#e5f6e9; color:#166e37; border:1px solid #ccecd4; border-radius:10px; padding:10px 14px; font-weight:700; cursor:pointer; }
    .kh-company-upload-button input[type=file] { position:absolute; inset:0; opacity:0; cursor:pointer; }
    .kh-company-upload-status { flex:1; display:flex; align-items:center; color:#5d7566; }
    .kh-company-upload-status.success { border-color:#79b871; background:#f4fbf3; color:#23783b; }
    .kh-company-upload-status.error { border-color:#f1a6a6; background:#fff4f4; color:#d14c4c; }
    .kh-company-file-link { display:inline-block; margin-top:6px; color:#166e37; font-weight:700; text-decoration:none; }
    .kh-company-actions { display:flex; justify-content:flex-end; gap:12px; margin-top:28px; }
    .kh-company-btn { min-width:160px; height:48px; border:none; border-radius:10px; padding:0 18px; font-size:15px; font-weight:700; cursor:pointer; }
    .kh-company-btn.secondary { background:#eef4ef; color:#1f3528; border:1px solid #d7e4da; }
    .kh-company-btn.primary { background:linear-gradient(135deg,#1f8b47 0%,#2f9d57 100%); color:#fff; }
    @@media (max-width: 991px) {
        .kh-company-form-shell { padding:20px 12px 32px; }
        .kh-company-form-card { padding:20px; }
        .kh-company-form-header { flex-direction:column; }
        .kh-company-form-title { font-size:28px; }
        .kh-company-grid { grid-template-columns:1fr; }
        .kh-company-col-span-2 { grid-column:span 1; }
        .kh-company-actions { flex-direction:column-reverse; }
        .kh-company-btn { width:100%; }
    }
</style>

<div class="kh-company-form-shell">
    <div class="kh-company-form-card">
        @using (Html.BeginForm("Save", "NguoiDung", FormMethod.Post, new { autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ID)
            @Html.HiddenFor(m => m.IDDanhMucKhachHangDoiLenh)
            @Html.HiddenFor(m => m.LoaiTaiKhoanNguoiDung)
            @Html.HiddenFor(m => m.BanScanGiayPhepKinhDoanhPath)
            @Html.HiddenFor(m => m.BanScanSoCMNDCanCuocPath)
            @Html.HiddenFor(m => m.BanDangKyEPortChuKySoPath)
            @Html.HiddenFor(m => m.IsActive)

            <div class="kh-company-form-header">
                <div>
                    <h1 class="kh-company-form-title">@(Model.ID.HasValue ? "Cập nhật doanh nghiệp" : "Thêm doanh nghiệp")</h1>
                    <p class="kh-company-form-subtitle">
                        @if (Model.LoaiTaiKhoanNguoiDung == 2)
                        {
                            @:Tài khoản doanh nghiệp chỉnh sửa hồ sơ đã đăng ký ban đầu.
                        }
                        else
                        {
                            @:Tài khoản cá nhân có thể thêm mới hoặc cập nhật hồ sơ doanh nghiệp đang quản lý.
                        }
                    </p>
                </div>
                <a class="kh-company-form-link" href="@Url.Action("Index", "NguoiDung", new { area = "KhachHang" })">Về danh sách</a>
            </div>

            @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })

            <div id="tai-lieu" class="kh-company-grid">
                <div class="kh-company-group kh-company-col-span-2">
                    <label class="kh-company-label">Tên doanh nghiệp <span class="kh-company-required">*</span></label>
                    @Html.TextBoxFor(m => m.TenDoanhNghiep, new { @class = "kh-company-input", placeholder = "Nhập tên doanh nghiệp", id = "TenDoanhNghiep" })
                    @Html.ValidationMessageFor(m => m.TenDoanhNghiep)
                </div>
                <div class="kh-company-group kh-company-col-span-2">
                    <label class="kh-company-label">Địa chỉ <span class="kh-company-required">*</span></label>
                    @Html.TextBoxFor(m => m.DiaChi, new { @class = "kh-company-input", placeholder = "Nhập địa chỉ doanh nghiệp", id = "DiaChi" })
                    @Html.ValidationMessageFor(m => m.DiaChi)
                </div>
                <div class="kh-company-group" id="taxCodeGroup">
                    <label class="kh-company-label">Mã số thuế <span class="kh-company-required">*</span></label>
                    <div class="kh-inline-actions">
                        @Html.TextBoxFor(m => m.MaSoThue, new { @class = "kh-company-input", placeholder = "Nhập mã số thuế", id = "MaSoThue" })
                        <button type="button" id="fetchBusinessButton" class="kh-company-btn secondary">Lấy thông tin</button>
                    </div>
                    <div id="businessLookupStatus" class="kh-inline-status"></div>
                    @Html.ValidationMessageFor(m => m.MaSoThue)
                </div>
                <div class="kh-company-group">
                    <label class="kh-company-label">SĐT doanh nghiệp <span class="kh-company-required">*</span></label>
                    @Html.TextBoxFor(m => m.SoDienThoaiDoanhNghiep, new { @class = "kh-company-input", placeholder = "Nhập số điện thoại doanh nghiệp" })
                    @Html.ValidationMessageFor(m => m.SoDienThoaiDoanhNghiep)
                </div>
                <div class="kh-company-group">
                    <label class="kh-company-label">Số fax</label>
                    @Html.TextBoxFor(m => m.SoFax, new { @class = "kh-company-input", placeholder = "Nhập số fax" })
                </div>
                <div class="kh-company-group">
                    <label class="kh-company-label">Email doanh nghiệp <span class="kh-company-required">*</span></label>
                    @Html.TextBoxFor(m => m.EmailDoanhNghiep, new { @class = "kh-company-input", placeholder = "Nhập email doanh nghiệp" })
                    @Html.ValidationMessageFor(m => m.EmailDoanhNghiep)
                </div>
                <div class="kh-company-group kh-company-col-span-2">
                    <label class="kh-company-label">Giấy phép kinh doanh</label>
                    @Html.TextBoxFor(m => m.GiayPhepKinhDoanh, new { @class = "kh-company-input", placeholder = "Nhập giấy phép kinh doanh" })
                </div>
                <div class="kh-company-group">
                    <label class="kh-company-label">Ngày cấp</label>
                    @Html.TextBoxFor(m => m.NgayCap, "{0:yyyy-MM-dd}", new { @class = "kh-company-date", type = "date" })
                </div>
                <div class="kh-company-group">
                    <label class="kh-company-label">Nơi cấp</label>
                    @Html.TextBoxFor(m => m.NoiCap, new { @class = "kh-company-input", placeholder = "Nhập nơi cấp" })
                </div>
                <div class="kh-company-group kh-company-col-span-2">
                    <label class="kh-company-label">Bản scan giấy phép kinh doanh (PDF)</label>
                    <div class="kh-company-upload-wrap">
                        <label class="kh-company-upload-button">
                            Chọn file PDF
                            <input type="file" data-target="BanScanGiayPhepKinhDoanhPath" data-status="businessLicenseStatus" data-folder="NguoiDungDoanhNghiep/GiayPhepKinhDoanh" accept=".pdf" />
                        </label>
                        <div id="businessLicenseStatus" class="kh-company-upload-status">@(string.IsNullOrWhiteSpace(Model.BanScanGiayPhepKinhDoanhPath) ? "Chưa tải tài liệu" : "Đã có tài liệu")</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.BanScanGiayPhepKinhDoanhPath))
                    {
                        <a class="kh-company-file-link" target="_blank" rel="noopener" href="@((apiBaseUrl.TrimEnd('/')) + "/api/TaiLieu/ViewPdf?path=" + Uri.EscapeDataString(Model.BanScanGiayPhepKinhDoanhPath))">Xem file hiện tại</a>
                    }
                </div>
                <div class="kh-company-group">
                    <label class="kh-company-label">Đại diện có thẩm quyền</label>
                    @Html.TextBoxFor(m => m.DaiDienCoThamQuyen, new { @class = "kh-company-input", placeholder = "Nhập đại diện có thẩm quyền" })
                </div>
                <div class="kh-company-group">
                    <label class="kh-company-label">Chức vụ</label>
                    @Html.TextBoxFor(m => m.ChucVu, new { @class = "kh-company-input", placeholder = "Nhập chức vụ" })
                </div>
                <div class="kh-company-group kh-company-col-span-2">
                    <label class="kh-company-label">Doanh nghiệp/Công ty được ủy quyền</label>
                    @Html.TextBoxFor(m => m.DoanhNghiepCongTyDuocUyQuyen, new { @class = "kh-company-input", placeholder = "Nhập doanh nghiệp/công ty được ủy quyền" })
                </div>
                <div class="kh-company-group">
                    <label class="kh-company-label">Tên đăng nhập đăng ký dịch vụ</label>
                    @Html.TextBoxFor(m => m.TenDangNhapDangKyDichVu, new { @class = "kh-company-input", placeholder = "Nhập tên đăng nhập dịch vụ" })
                </div>
                <div class="kh-company-group">
                    <label class="kh-company-label">Email xuất hóa đơn</label>
                    @Html.TextBoxFor(m => m.EmailXuatHoaDon, new { @class = "kh-company-input", placeholder = "Nhập email xuất hóa đơn" })
                </div>
                <div class="kh-company-group">
                    <label class="kh-company-label">Số CMND / Căn cước</label>
                    @Html.TextBoxFor(m => m.SoCMNDCanCuoc, new { @class = "kh-company-input", placeholder = "Nhập số CMND / căn cước" })
                </div>
                <div class="kh-company-group kh-company-col-span-2">
                    <label class="kh-company-label">Bản scan CMND / Căn cước (PDF)</label>
                    <div class="kh-company-upload-wrap">
                        <label class="kh-company-upload-button">
                            Chọn file PDF
                            <input type="file" data-target="BanScanSoCMNDCanCuocPath" data-status="citizenStatus" data-folder="NguoiDungDoanhNghiep/CanCuoc" accept=".pdf" />
                        </label>
                        <div id="citizenStatus" class="kh-company-upload-status">@(string.IsNullOrWhiteSpace(Model.BanScanSoCMNDCanCuocPath) ? "Chưa tải tài liệu" : "Đã có tài liệu")</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.BanScanSoCMNDCanCuocPath))
                    {
                        <a class="kh-company-file-link" target="_blank" rel="noopener" href="@((apiBaseUrl.TrimEnd('/')) + "/api/TaiLieu/ViewPdf?path=" + Uri.EscapeDataString(Model.BanScanSoCMNDCanCuocPath))">Xem file hiện tại</a>
                    }
                </div>
                <div class="kh-company-group kh-company-col-span-2">
                    <label class="kh-company-label">Bản đăng ký ePort có chữ ký số (PDF)</label>
                    <div class="kh-company-upload-wrap">
                        <label class="kh-company-upload-button">
                            Chọn file PDF
                            <input type="file" data-target="BanDangKyEPortChuKySoPath" data-status="eportStatus" data-folder="NguoiDungDoanhNghiep/DangKyEPort" accept=".pdf" />
                        </label>
                        <div id="eportStatus" class="kh-company-upload-status">@(string.IsNullOrWhiteSpace(Model.BanDangKyEPortChuKySoPath) ? "Chưa tải tài liệu" : "Đã có tài liệu")</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.BanDangKyEPortChuKySoPath))
                    {
                        <a class="kh-company-file-link" target="_blank" rel="noopener" href="@((apiBaseUrl.TrimEnd('/')) + "/api/TaiLieu/ViewPdf?path=" + Uri.EscapeDataString(Model.BanDangKyEPortChuKySoPath))">Xem file hiện tại</a>
                    }
                </div>
            </div>

            <div class="kh-company-actions">
                <a class="kh-company-btn secondary" href="@Url.Action("Index", "NguoiDung", new { area = "KhachHang" })">Quay lại</a>
                <button type="submit" class="kh-company-btn primary">Lưu doanh nghiệp</button>
            </div>
        }
    </div>
</div>

<script>
    (function () {
        var apiBaseUrl = '@apiBaseUrl'.replace(/\/$/, '');
        var fetchBusinessButton = document.getElementById('fetchBusinessButton');
        var taxCodeGroup = document.getElementById('taxCodeGroup');
        var maSoThueInput = document.getElementById('MaSoThue');
        var tenDoanhNghiepInput = document.getElementById('TenDoanhNghiep');
        var diaChiInput = document.getElementById('DiaChi');
        var businessLookupStatus = document.getElementById('businessLookupStatus');
        var hiddenInputs = {
            BanScanGiayPhepKinhDoanhPath: document.getElementById('BanScanGiayPhepKinhDoanhPath'),
            BanScanSoCMNDCanCuocPath: document.getElementById('BanScanSoCMNDCanCuocPath'),
            BanDangKyEPortChuKySoPath: document.getElementById('BanDangKyEPortChuKySoPath')
        };

        function setBusinessLookupStatus(message, type) {
            if (!businessLookupStatus) {
                return;
            }

            businessLookupStatus.className = 'kh-inline-status' + (type ? ' ' + type : '');
            businessLookupStatus.textContent = message || '';
        }

        function moveTaxCodeToTop() {
            if (!taxCodeGroup || !taxCodeGroup.parentNode) {
                return;
            }

            taxCodeGroup.parentNode.insertBefore(taxCodeGroup, taxCodeGroup.parentNode.firstElementChild);
        }

        function fetchBusinessInfo() {
            var taxCode = maSoThueInput ? (maSoThueInput.value || '').trim() : '';
            if (!taxCode) {
                setBusinessLookupStatus('Vui lòng nhập mã số thuế trước khi lấy thông tin.', 'error');
                if (maSoThueInput) {
                    maSoThueInput.focus();
                }
                return;
            }

            setBusinessLookupStatus('Đang lấy thông tin doanh nghiệp...', '');
            fetch('https://api.vietqr.io/v2/business/' + encodeURIComponent(taxCode), {
                method: 'GET'
            })
            .then(function (response) { return response.json(); })
            .then(function (result) {
                if (!result || result.code !== '00' || !result.data) {
                    throw new Error(result && result.desc ? result.desc : 'Không lấy được thông tin doanh nghiệp.');
                }

                if (tenDoanhNghiepInput) {
                    tenDoanhNghiepInput.value = result.data.name || '';
                }

                if (diaChiInput) {
                    diaChiInput.value = result.data.address || '';
                }

                setBusinessLookupStatus('Đã tự động điền tên doanh nghiệp và địa chỉ.', 'success');
            })
            .catch(function (error) {
                setBusinessLookupStatus(error.message || 'Không lấy được thông tin doanh nghiệp.', 'error');
            });
        }

        function uploadFile(fileInput) {
            if (!fileInput.files || fileInput.files.length === 0) {
                return;
            }

            var file = fileInput.files[0];
            var targetInput = hiddenInputs[fileInput.getAttribute('data-target')];
            var status = document.getElementById(fileInput.getAttribute('data-status'));
            var folder = fileInput.getAttribute('data-folder') || 'NguoiDungDoanhNghiep';

            if (!/\.pdf$/i.test(file.name)) {
                status.className = 'kh-company-upload-status error';
                status.textContent = 'Chỉ hỗ trợ file PDF.';
                fileInput.value = '';
                return;
            }

            var formData = new FormData();
            formData.append('file', file);

            status.className = 'kh-company-upload-status';
            status.textContent = 'Đang tải file...';

            fetch(apiBaseUrl + '/api/TaiLieu/UploadPdf?folder=' + encodeURIComponent(folder), {
                method: 'POST',
                body: formData
            })
            .then(function (response) { return response.json(); })
            .then(function (result) {
                if (!result || result.Status !== 0 || !result.Data) {
                    throw new Error(result && result.ErrorMsg ? result.ErrorMsg : 'Upload file không thành công.');
                }

                var data = JSON.parse(result.Data);
                targetInput.value = data.RelativePath || '';
                status.className = 'kh-company-upload-status success';
                status.textContent = data.OriginalFileName + ' đã tải thành công';
            })
            .catch(function (error) {
                targetInput.value = '';
                status.className = 'kh-company-upload-status error';
                status.textContent = error.message || 'Upload file không thành công.';
            });
        }

        Array.prototype.forEach.call(document.querySelectorAll('input[type="file"][data-target]'), function (input) {
            input.addEventListener('change', function () {
                uploadFile(input);
            });
        });

        if (fetchBusinessButton) {
            fetchBusinessButton.addEventListener('click', function () {
                fetchBusinessInfo();
            });
        }

        moveTaxCodeToTop();
    })();
</script>
