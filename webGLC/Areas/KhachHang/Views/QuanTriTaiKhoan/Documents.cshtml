@model webGLC.Areas.KhachHang.Models.HoSoDoanhNghiepViewModel
@{
    ViewBag.Title = "Hồ sơ tài liệu";
    Layout = "~/Areas/KhachHang/Views/Shared/_Layout.cshtml";
}

<style>
    .kh-doc-shell {
        max-width: 1180px;
        margin: 0 auto;
        padding: 32px 24px 48px;
    }

    .kh-doc-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid rgba(47, 157, 87, 0.10);
        box-shadow: 0 20px 52px rgba(20, 86, 44, 0.12);
        padding: 28px;
    }

    .kh-doc-header {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        align-items: flex-start;
        margin-bottom: 24px;
    }

    .kh-doc-title {
        margin: 0 0 8px;
        font-size: 32px;
        color: #166e37;
        text-transform: uppercase;
    }

    .kh-doc-subtitle {
        margin: 0;
        color: #4a6552;
        line-height: 1.7;
    }

    .kh-doc-actions-top {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .kh-doc-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 16px;
        border-radius: 999px;
        border: 1px solid #ccecd4;
        background: #f3fbf5;
        color: #166e37;
        font-weight: 700;
        text-decoration: none;
    }

    .kh-doc-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 24px;
    }

    .kh-doc-info {
        background: #f8fbf9;
        border: 1px solid #e2ece5;
        border-radius: 16px;
        padding: 18px;
    }

    .kh-doc-info-label {
        display: block;
        margin-bottom: 6px;
        color: #68816f;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .kh-doc-info-value {
        color: #1f3528;
        font-size: 16px;
        font-weight: 700;
        word-break: break-word;
    }

    .kh-doc-list {
        display: grid;
        gap: 16px;
    }

    .kh-doc-item {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        align-items: center;
        padding: 18px;
        border-radius: 16px;
        border: 1px solid #e2ece5;
        background: #fbfefb;
    }

    .kh-doc-item-name {
        margin: 0 0 6px;
        color: #166e37;
        font-size: 18px;
    }

    .kh-doc-item-path {
        margin: 0;
        color: #647a6a;
        font-size: 13px;
        word-break: break-all;
    }

    .kh-doc-status {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
    }

    .kh-doc-status.ok {
        background: #edf8f0;
        color: #166e37;
    }

    .kh-doc-status.missing {
        background: #fff3f0;
        color: #c95b36;
    }

    .kh-doc-view {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 16px;
        border-radius: 12px;
        background: linear-gradient(135deg, #1f8b47 0%, #2f9d57 100%);
        color: #fff;
        font-weight: 700;
        text-decoration: none;
        margin-left: 10px;
    }

    .kh-doc-approve-form {
        margin-top: 24px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .kh-doc-btn {
        min-width: 160px;
        min-height: 46px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        padding: 0 18px;
    }

    .kh-doc-btn.approve {
        border: none;
        background: linear-gradient(135deg, #1f8b47 0%, #2f9d57 100%);
        color: #fff;
    }

    .kh-doc-btn.lock {
        border: 1px solid #d7e4da;
        background: #eef4ef;
        color: #1f3528;
    }

    .kh-doc-alert {
        border-radius: 12px;
        padding: 12px 14px;
        margin-bottom: 18px;
        font-size: 14px;
        background: #fff4f4;
        color: #c93a3a;
        border: 1px solid #f0b6b6;
    }

    @@media (max-width: 991px) {
        .kh-doc-shell {
            padding: 20px 12px 32px;
        }

        .kh-doc-card {
            padding: 20px;
        }

        .kh-doc-header,
        .kh-doc-item {
            flex-direction: column;
            align-items: flex-start;
        }

        .kh-doc-grid {
            grid-template-columns: 1fr;
        }

        .kh-doc-view {
            margin-left: 0;
            margin-top: 10px;
        }
    }
</style>

<div class="kh-doc-shell">
    <div class="kh-doc-card">
        <div class="kh-doc-header">
            <div>
                <h1 class="kh-doc-title">Hồ sơ tài liệu</h1>
                <p class="kh-doc-subtitle">Admin có thể xem các PDF đã upload, đối chiếu hồ sơ và quyết định phê duyệt tài khoản ngay tại đây.</p>
            </div>
            <div class="kh-doc-actions-top">
                <a class="kh-doc-back" href="@Url.Action("Index", "QuanTriTaiKhoan", new { area = "KhachHang" })">Quay lại quản trị</a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="kh-doc-alert">@Model.ErrorMessage</div>
        }
        else
        {
            <div class="kh-doc-grid">
                <div class="kh-doc-info">
                    <span class="kh-doc-info-label">Tên người dùng</span>
                    <div class="kh-doc-info-value">@Model.Ten</div>
                </div>
                <div class="kh-doc-info">
                    <span class="kh-doc-info-label">Email đăng nhập</span>
                    <div class="kh-doc-info-value">@Model.Email</div>
                </div>
                <div class="kh-doc-info">
                    <span class="kh-doc-info-label">Loại tài khoản</span>
                    <div class="kh-doc-info-value">@Model.LoaiTaiKhoanText</div>
                </div>
                <div class="kh-doc-info">
                    <span class="kh-doc-info-label">Số điện thoại</span>
                    <div class="kh-doc-info-value">@Model.SoDienThoai</div>
                </div>
                @if (Model.LoaiTaiKhoan == 2)
                {
                    <div class="kh-doc-info">
                        <span class="kh-doc-info-label">Tên doanh nghiệp</span>
                        <div class="kh-doc-info-value">@Model.TenDoanhNghiep</div>
                    </div>
                    <div class="kh-doc-info">
                        <span class="kh-doc-info-label">Mã số thuế</span>
                        <div class="kh-doc-info-value">@Model.MaSoThue</div>
                    </div>
                }
            </div>

            <div class="kh-doc-list">
                @foreach (var document in Model.Documents)
                {
                    <div class="kh-doc-item">
                        <div>
                            <h2 class="kh-doc-item-name">@document.TenTaiLieu</h2>
                            <p class="kh-doc-item-path">@(document.HasFile ? document.RelativePath : "Chưa có file được upload")</p>
                        </div>
                        <div>
                            <span class="kh-doc-status @(document.HasFile ? "ok" : "missing")">
                                @(document.HasFile ? "Đã upload" : "Thiếu tài liệu")
                            </span>
                            @if (document.HasFile)
                            {
                                <a class="kh-doc-view" href="@document.ViewUrl" target="_blank" rel="noopener">Xem PDF</a>
                            }
                        </div>
                    </div>
                }
            </div>

            <form method="post" action="@Url.Action("SetActive", "QuanTriTaiKhoan", new { area = "KhachHang" })" class="kh-doc-approve-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ID" />
                <input type="hidden" name="isActive" value="@((!Model.IsActive).ToString())" />
                <input type="hidden" name="returnToDocuments" value="true" />
                <button type="submit" class="kh-doc-btn @(Model.IsActive ? "lock" : "approve")">
                    @(Model.IsActive ? "Khóa tài khoản" : "Phê duyệt và kích hoạt")
                </button>
            </form>
        }
    </div>
</div>
