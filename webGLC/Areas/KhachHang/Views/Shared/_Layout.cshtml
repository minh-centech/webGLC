


@{
    var khachHangDisplayName = Session["KhachHangDisplayName"] as string;
    var khachHangHeaderName = !string.IsNullOrWhiteSpace(khachHangDisplayName) ? khachHangDisplayName : "Khách hàng";
    var khachHangLoaiTaiKhoan = Session["KhachHangLoaiTaiKhoanName"] as string;
    var khachHangLoaiTaiKhoanDisplay = !string.IsNullOrWhiteSpace(khachHangLoaiTaiKhoan) ? khachHangLoaiTaiKhoan : "Tài khoản";
    var khachHangLoaiTaiKhoanValue = Session["KhachHangLoaiTaiKhoan"] as string;
    var isKhachHangAdmin = string.Equals(khachHangLoaiTaiKhoanValue, "0", StringComparison.OrdinalIgnoreCase);
    var isKhachHangUser = string.Equals(khachHangLoaiTaiKhoanValue, "1", StringComparison.OrdinalIgnoreCase)
        || string.Equals(khachHangLoaiTaiKhoanValue, "2", StringComparison.OrdinalIgnoreCase);
}

