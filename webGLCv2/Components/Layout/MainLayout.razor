@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<div class="support-chat-wrapper">
    <deep-chat
        id="chat-element"
        demo="true"
        style='{
            "width": "360px",
            "height": "520px",
            "border": "1px solid #0b6b36",
            "border-radius": "15px",
            "box-shadow": "0 4px 15px rgba(0,0,0,0.1)"
        }'
        messageStyles='{
            "default": {
                "ai": { "bubble": { "background-color": "#f0f4f2", "color": "#333" } },
                "user": { "bubble": { "background-color": "#0b6b36", "color": "white" } }
            }
        }'
        submitButtonStyles='{
            "submit": { "container": { "default": { "background-color": "#0b6b36" } } }
        }'
        textInput='{
            "placeholder": { "text": "Nhập tin nhắn...", "style": { "color": "#0b6b36" } }
        }'
        initialMessages='[
            {"text": "Chào bạn! Tôi là AI hỗ trợ với giao diện màu xanh. Bạn muốn hỏi gì?", "role": "ai"}
        ]'>
    </deep-chat>
</div>
