@page "/admin/orders/{OrderId:long}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject OnlineOrderService OnlineOrderService
@inject LegacyCustomerPortalService LegacyCustomerPortalService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Globalization
@using System.Threading

<PageTitle>Chi tiết lệnh online</PageTitle>

<section class="page-shell">
    <header class="page-header">
        <div>
            <p class="page-kicker">Admin Workspace</p>
            <h1>Chi tiết lệnh online</h1>
            <p class="page-subtitle">Xem chi tiết lệnh của người dùng trong chế độ quản trị, theo cùng cấu trúc dữ liệu như trang khách hàng.</p>
        </div>
        <button class="portal-secondary-action" @onclick="@(() => NavigationManager.NavigateTo("/admin/orders"))">Quay lại danh sách</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(DownloadToastMessage))
    {
        <div class="@GetDownloadToastClass()">
            <span class="portal-toast-icon">@GetDownloadToastIcon()</span>
            <span class="portal-toast-message">@DownloadToastMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="portal-alert portal-alert-error">@ErrorMessage</div>
    }
    else if (Order is null)
    {
        <div class="portal-empty-inline">Đang tải dữ liệu...</div>
    }
    else
    {
        <section class="workspace-card">
            <div class="section-heading">
                <h2>@Order.OrderCode</h2>
                <p>Trạng thái hiện tại: <span class="status-chip @GetStatusClass(Order.StatusCode)">@Order.Status</span></p>
            </div>

            <div class="field-grid">
                <div>
                    <label class="portal-label">ID user</label>
                    <input class="portal-input" value="@Order.UserId" readonly />
                </div>
                <div>
                    <label class="portal-label">Email user</label>
                    <input class="portal-input" value="@Order.UserEmail" readonly />
                </div>
                <div>
                    <label class="portal-label">Họ và tên</label>
                    <input class="portal-input" value="@Order.CustomerName" readonly />
                </div>
                <div>
                    <label class="portal-label">Số điện thoại</label>
                    <input class="portal-input" value="@Order.PhoneNumber" readonly />
                </div>
                <div>
                    <label class="portal-label">Số CMND/CCCD</label>
                    <input class="portal-input" value="@Order.IdentityNumber" readonly />
                </div>
                <div>
                    <label class="portal-label">Biển số xe</label>
                    <input class="portal-input" value="@Order.VehicleNumber" readonly />
                </div>
                <div>
                    <label class="portal-label">Mã số thuế</label>
                    <input class="portal-input" value="@Order.TaxCode" readonly />
                </div>
                <div>
                    <label class="portal-label">Tên công ty</label>
                    <input class="portal-input" value="@Order.CompanyName" readonly />
                </div>
                <div class="field-span-3">
                    <label class="portal-label">Địa chỉ DN</label>
                    <input class="portal-input" value="@Order.CompanyAddress" readonly />
                </div>
                <div>
                    <label class="portal-label">Email liên hệ</label>
                    <input class="portal-input" value="@Order.CompanyEmail" readonly />
                </div>
                <div>
                    <label class="portal-label">Số House Bill</label>
                    <input class="portal-input" value="@Order.HouseBill" readonly />
                </div>
                <div>
                    <label class="portal-label">Ngày làm lệnh</label>
                    <input class="portal-input" value="@Order.OrderDate.ToString("dd/MM/yyyy HH:mm")" readonly />
                </div>
                <div>
                    <label class="portal-label">Số Cont</label>
                    <input class="portal-input" value="@Order.ContainerNumber" readonly />
                </div>
                <div>
                    <label class="portal-label">Ngày lấy hàng</label>
                    <input class="portal-input" value="@(Order.PickupDate?.ToString("dd/MM/yyyy") ?? string.Empty)" readonly />
                </div>
                <div>
                    <label class="portal-label">Số tờ khai</label>
                    <input class="portal-input" value="@Order.DeclarationNumber" readonly />
                </div>

                @if (CanShowOrderInfoUpdate)
                {
                    <div class="field-span-3" style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                        <button type="button"
                                class="portal-primary-action"
                                @onclick="ToggleOrderInfoEditor">
                            @(ShowOrderInfoEditor ? "Ẩn cập nhật thông tin" : "Cập nhật thông tin lệnh online")
                        </button>
                        <span class="portal-text-muted">
                            Cho phép cập nhật khi chưa tạo lệnh xuất kho và biên nhận thanh toán.
                        </span>
                    </div>
                }
            </div>

            @if (ShowOrderInfoEditor && CanShowOrderInfoUpdate)
            {
                <div class="workspace-card" style="margin-top:18px; padding:18px;">
                    <div class="section-heading">
                        <h2>Cập nhật thông tin lệnh</h2>
                        <p>Cho phép thay đổi các thông tin (Họ tên, Số ĐT, CCCD và cập nhật MST).</p>
                    </div>

                    <div class="field-grid">
                        <div>
                            <label class="portal-label">Mã số thuế</label>
                            <div class="input-action-row">
                                <div class="input-action-field">
                                    <input class="portal-input" value="@SelectedCompanyTaxCode" readonly />
                                </div>
                                <button type="button" class="portal-secondary-action" @onclick="OpenTaxLookupPopup">Cập nhật MST</button>
                            </div>
                        </div>
                        <div>
                            <label class="portal-label">Họ và tên</label>
                            <input class="portal-input" @bind="EditableCustomerName" />
                        </div>
                        <div>
                            <label class="portal-label">Số điện thoại</label>
                            <input class="portal-input" @bind="EditablePhoneNumber" />
                        </div>
                        <div>
                            <label class="portal-label">Số CMND/CCCD</label>
                            <input class="portal-input" @bind="EditableIdentityNumber" />
                        </div>
                        <div>
                            <label class="portal-label">Biển số xe</label>
                            <input class="portal-input" @bind="EditableVehicleNumber" />
                        </div>
                        <div>
                            <label class="portal-label">Tên công ty</label>
                            <input class="portal-input" value="@EditableCompanyName" readonly />
                        </div>
                        <div class="field-span-3">
                            <label class="portal-label">Địa chỉ DN</label>
                            <input class="portal-input" value="@EditableCompanyAddress" readonly />
                        </div>
                        <div>
                            <label class="portal-label">Mã số thuế hiện tại</label>
                            <input class="portal-input" value="@Order.TaxCode" readonly />
                        </div>
                    </div>

                    <div style="display:flex; justify-content:flex-end; gap:12px; margin-top:16px; flex-wrap:wrap;">
                        <button type="button" class="portal-secondary-action" @onclick="ReloadOrderInfoEditorAsync">Làm mới dữ liệu</button>
                        <button type="button"
                                class="portal-primary-action"
                                disabled="@IsSavingOrderInfo"
                                @onclick="SaveOrderInfoAsync">
                            @(IsSavingOrderInfo ? "Đang lưu..." : "Lưu cập nhật")
                        </button>
                    </div>
                </div>
            }

            @if (IsTaxLookupPopupOpen)
            {
                <div class="portal-modal-backdrop" @onclick="CloseTaxLookupPopup">
                    <div class="portal-modal" @onclick:stopPropagation="true" style="max-width:760px; width:min(100%, 760px);">
                        <h3>Tra cứu mã số thuế</h3>
                        <p>Nhập mã số thuế, bấm tìm kiếm và hệ thống sẽ hiển thị dữ liệu doanh nghiệp để bạn dùng cho lệnh này.</p>

                        <div class="field-grid">
                            <div class="field-card wide">
                                <label class="portal-label">Mã số thuế</label>
                                <div class="input-action-row" style="align-items:flex-end;">
                                    <div class="input-action-row input-action-field" style="gap:8px; align-items:flex-end;">
                                        <input class="portal-input input-action-field"
                                               @bind="TaxLookupInput"
                                               @bind:event="oninput"
                                               placeholder="Nhập mã số thuế" />
                                    </div>
                                    <button type="button" class="portal-primary-action" disabled="@TaxLookupIsBusy" @onclick="SearchTaxLookupAsync">Tra cứu</button>
                                    <button type="button" class="portal-secondary-action lookup-clear-action" disabled="@TaxLookupIsBusy" @onclick="ClearTaxLookupAsync" title="Xóa thông tin" aria-label="Xóa mã số thuế">Xóa mã số thuế</button>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(TaxLookupMessage))
                        {
                            <div class="portal-alert @(TaxLookupIsError ? "portal-alert-error" : TaxLookupIsWarning ? "portal-alert-warning" : "portal-alert-success")" style="margin-top:12px;">@TaxLookupMessage</div>
                        }

                        @if (TaxLookupResult.Count > 0)
                        {
                            <div class="table-shell" style="margin-top:16px; max-height:360px; overflow:auto;">
                                <table class="portal-table dense">
                                    <tbody>
                                        @foreach (var item in TaxLookupResult)
                                        {
                                            <tr>
                                                <td style="width:220px;">@item.Key</td>
                                                <td>@item.Value</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="portal-modal-actions tax-lookup-actions" style="justify-content:flex-end; gap:12px; margin-top:16px;">
                            @if (TaxLookupResult.Count > 0)
                            {
                                <button type="button" class="portal-primary-action" @onclick="ApplyTaxLookupResultAsync" disabled="@TaxLookupIsBusy">Dùng dữ liệu này</button>
                            }
                            <button type="button" class="portal-secondary-action" @onclick="CloseTaxLookupPopup">Đóng</button>
                        </div>
                    </div>
                </div>
            }

            <section class="workflow-grid">
                <article class="workflow-card" style="display:none;">
                    <div class="section-heading">
                        <h2>1. Kiểm tra thông quan</h2>
                        <span class="status-chip @GetThongQuanClass(Workflow?.ThongQuan)">@GetThongQuanLabel(Workflow?.ThongQuan)</span>
                    </div>
                    <p class="workflow-message">@GetWorkflowMessage(Workflow?.ThongQuan)</p>
                </article>

                <article class="workflow-card" style="display:none;">
                    <div class="section-heading">
                        <h2>2. Phí lưu kho</h2>
                        <span class="status-chip @(HasPhiLuuKho ? "success" : "neutral")">@(HasPhiLuuKho ? "Đã lấy dữ liệu" : "Chưa có dữ liệu")</span>
                    </div>

                    @if (HasPhiLuuKho)
                    {
                        <div class="workflow-payment-row">
                            <span class="status-chip @GetPaymentStatusClass(Workflow!.PhiLuuKho!.Data!.TrangThaiThanhToan)">
                                @GetPaymentStatusLabel(Workflow!.PhiLuuKho!.Data!.TrangThaiThanhToan)
                            </span>
                        </div>

                        <div class="table-shell compact-table query-table-scroll">
                            <table class="portal-table">
                                <thead>
                                    <tr>
                                        <th>Diễn giải</th>
                                        <th>Đơn vị tính</th>
                                        <th class="text-start">Đơn giá</th>
                                        <th class="text-start">Tiền hàng</th>
                                        <th class="text-start">Thuế suất</th>
                                        <th class="text-start">Tiền thuế</th>
                                        <th class="text-start">Tổng tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Workflow!.PhiLuuKho!.Data!.ChiTietHoaDon)
                                    {
                                        <tr>
                                            <td>@item.MoTa</td>
                                            <td>@item.DonViTinh</td>
                                            <td class="text-start">@FormatMoney(item.DonGia)</td>
                                            <td class="text-start">@FormatMoney(item.TienHangThucTe)</td>
                                            <td class="text-start">@FormatVatPercent(item.ThueSuat)</td>
                                            <td class="text-start">@FormatMoney(item.TienThue)</td>
                                            <td class="text-start">@FormatMoney(item.TongTien)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="text-success fw-semibold">
                                        <td colspan="3"><strong>Tổng cộng</strong></td>
                                        <td class="text-start"><strong>@FormatMoney(GetPhiSubtotal(Workflow!.PhiLuuKho!))</strong></td>
                                        <td></td>
                                        <td class="text-start"><strong>@FormatMoney(GetPhiVatAmount(Workflow!.PhiLuuKho!))</strong></td>
                                        <td class="text-start"><strong>@FormatMoney(GetPhiGrandTotal(Workflow!.PhiLuuKho!))</strong></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="workflow-message">@GetPhiLuuKhoMessage(Workflow)</p>
                    }
                </article>

                @if (IsOverdueOrder)
                {
                    <article class="workflow-card workflow-card-overdue">
                        <div class="section-heading">
                            <h2>2b. Phí lưu kho quá hạn</h2>
                            <span class="status-chip @(HasPhiLuuKhoQuaHan ? "warning" : "neutral")">@(HasPhiLuuKhoQuaHan ? "Đã lấy dữ liệu" : "Chưa có dữ liệu")</span>
                        </div>

                        @if (HasPhiLuuKhoQuaHan)
                        {
                            <div class="workflow-payment-row">
                                <span class="status-chip @GetPaymentStatusClass(Workflow!.PhiLuuKhoQuaHan!.Data!.TrangThaiThanhToan)">
                                    @GetPaymentStatusLabel(Workflow!.PhiLuuKhoQuaHan!.Data!.TrangThaiThanhToan)
                                </span>
                            </div>

                            <div class="table-shell compact-table">
                                <table class="portal-table">
                                    <thead>
                                        <tr>
                                            <th>Mô tả</th>
                                            <th>Đơn vị tính</th>
                                            <th class="text-start">Số lượng</th>
                                            <th class="text-start">Đơn giá</th>
                                            <th class="text-start">Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Workflow!.PhiLuuKhoQuaHan!.Data!.ChiTietHoaDon)
                                        {
                                            <tr>
                                                <td>@item.MoTa</td>
                                                <td>@item.DonViTinh</td>
                                                <td class="text-start">@FormatNumber(item.SoLuong)</td>
                                                <td class="text-start">@FormatMoney(item.DonGia)</td>
                                                <td class="text-start">@FormatMoney(item.ThanhTien)</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td><strong>Tạm tính</strong></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td class="text-start">@FormatMoney(GetPhiSubtotal(Workflow!.PhiLuuKhoQuaHan!))</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Phí VAT (@FormatVatPercent(Workflow!.PhiLuuKhoQuaHan!.Data!.Vat))</strong></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td class="text-start">@FormatMoney(GetPhiVatAmount(Workflow!.PhiLuuKhoQuaHan!))</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Cộng phí + VAT</strong></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td class="text-start"><strong>@FormatMoney(GetPhiGrandTotal(Workflow!.PhiLuuKhoQuaHan!))</strong></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="workflow-message">@GetPhiLuuKhoQuaHanMessage(Workflow)</p>
                        }
                    </article>
                }

                <article class="workflow-card workflow-card-wide">
                    <div class="section-heading">
                        <h2>Thông tin chi tiết hàng hoá</h2>
                        <span class="status-chip @(HasChiTietHouseBill ? "success" : HasChiTietHouseBillEmptyData ? "danger" : "neutral")">
                            @(HasChiTietHouseBill ? "Đã lấy dữ liệu thành công" : HasChiTietHouseBillEmptyData ? "Không có dữ liệu" : "Không có dữ liệu chi tiết cho housebill")
                        </span>
                    </div>

                    @if (HasChiTietHouseBillEmptyData)
                    {
                        <div class="portal-empty-state compact" style="margin-top:12px;">
                            <div class="portal-empty-icon">0</div>
                            <h2>Không có dữ liệu chi tiết cho housebill</h2>
                            <p>API Thông tin chi tiết hàng hoá trả về rỗng. Không có dữ liệu để hiển thị.</p>
                        </div>
                    }
                    else if (HasChiTietHouseBill)
                    {
                        <div class="workflow-payment-row" style="margin-bottom:12px;">
                            <span class="status-chip @GetChiTietHouseBillStatusClass(Workflow!.ChiTietHouseBill!.ParsedData!.IsHoanThanh)">
                                @GetChiTietHouseBillStatusLabel(Workflow!.ChiTietHouseBill!.ParsedData!.IsHoanThanh)
                            </span>
                        </div>

                        <div class="table-shell compact-table">
                            <table class="portal-table">
                                <thead>
                                    <tr>
                                        <th>Trường</th>
                                        <th>Giá trị</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var chiTiet = Workflow!.ChiTietHouseBill!.ParsedData!;
                                    }
                                    <tr><td>Số vận đơn</td><td>@chiTiet.SoVanDon</td></tr>
                                    <tr><td>Trạng thái khóa</td><td>@FormatYesNo(chiTiet.TrangThaiKhoa == true)</td></tr>
                                    <tr><td>Số container</td><td>@chiTiet.SoContainer</td></tr>
                                    <tr><td>Mô tả hàng hóa</td><td>@chiTiet.MoTaHangHoa</td></tr>
                                    <tr><td>Tên chủ hàng</td><td>@chiTiet.TenChuHang</td></tr>
                                    <tr><td>Mã danh mục đơn vị tính</td><td>@chiTiet.MaDanhMucDonViTinh</td></tr>
                                    <tr><td>Số lượng kiện nhập</td><td>@FormatNumber(chiTiet.SoLuongKienNhap)</td></tr>
                                    <tr><td>Khối lượng nhập</td><td>@FormatNumber(chiTiet.KhoiLuongNhap)</td></tr>
                                    <tr><td>CBM nhập</td><td>@FormatNumber(chiTiet.CBMNhap)</td></tr>
                                    <tr><td>Hàng nguy hiểm</td><td>@FormatYesNo(chiTiet.HangNguyHiem)</td></tr>
                                    <tr><td>Hàng quá khổ</td><td>@FormatYesNo(chiTiet.HangQuaKho)</td></tr>
                                    <tr><td>Số lượng quá khổ</td><td>@FormatNumber(chiTiet.SoLuongQuaKho)</td></tr>
                                    <tr><td>Hàng quá tải</td><td>@FormatYesNo(chiTiet.HangQuaTai)</td></tr>
                                    <tr><td>Số lượng quá tải</td><td>@FormatNumber(chiTiet.SoLuongQuaTai)</td></tr>
                                    <tr><td>EDO</td><td>@chiTiet.EDO</td></tr>
                                    <tr><td>Mã danh mục cửa làm hàng</td><td>@chiTiet.MaDanhMucCuaLamHang</td></tr>
                                    <tr><td>Ngày nhập kho</td><td>@FormatDateTime(chiTiet.NgayNhapKho)</td></tr>
                                    <tr><td>Ngày gia hạn cuối</td><td>@FormatDateTime(chiTiet.NgayGiaHanCuoi)</td></tr>
                                    <tr><td>Mã danh mục đại lý</td><td>@chiTiet.MaDanhMucDaiLy</td></tr>
                                    <tr><td>Số seal</td><td>@chiTiet.SoSeal</td></tr>
                                    <tr><td>Mã danh mục loại container</td><td>@chiTiet.MaDanhMucLoaiContainer</td></tr>
                                    <tr><td>Master Bill</td><td>@chiTiet.MasterBill</td></tr>
                                    <tr><td>Mã danh mục hãng tàu</td><td>@chiTiet.MaDanhMucHangTau</td></tr>
                                    <tr><td>Tên tàu</td><td>@chiTiet.TenTau</td></tr>
                                    <tr><td>Số chuyến</td><td>@chiTiet.SoChuyen</td></tr>
                                    <tr><td>Ngày tàu đến</td><td>@FormatDateTime(chiTiet.NgayTauDen)</td></tr>
                                    <tr><td>Ghi chú</td><td>@chiTiet.GhiChu</td></tr>
                                </tbody>
                            </table>
                        </div>
                    }
                </article>

                <article class="workflow-card workflow-card-wide">
                    <div class="section-heading workflow-section-heading">
                        <div class="workflow-heading-text" style="margin-bottom:5px">
                            <h2>Lệnh xuất kho</h2>
                            <span class="status-chip @(Workflow?.LenhXuatKhoHangNhapKhauTemps?.Success == true ? "success" : "neutral")">
                                @(Workflow?.LenhXuatKhoHangNhapKhauTemps?.Success == true
                                    ? "Vui lòng thanh toán biên nhận để hoàn tất tải lệnh về máy"
                                    : "Chưa có dữ liệu")
                            </span>
                        </div>
                    </div>

                    @{
                        var lenhXuatKhoTempMessage = GetLenhXuatKhoTempMessage(Workflow);
                    }

                    @if (!string.IsNullOrWhiteSpace(lenhXuatKhoTempMessage))
                    {
                        <div class="portal-alert portal-alert-warning">@lenhXuatKhoTempMessage</div>
                    }
                    else
                    {
                        <div class="table-shell compact-table query-table-scroll">
                            <table class="portal-table">
                                <thead>
                                    <tr>
                                        <th>Mã lệnh</th>
                                        <th>Ngày lập</th>
                                        <th>Hạn lưu kho</th>
                                        <th>Số vận đơn</th>
                                        <th>PDF</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Workflow!.LenhXuatKhoHangNhapKhauTemps!.Data)
                                    {
                                        <tr>
                                            <td>@item.So</td>
                                            <td>@FormatDateTime(item.NgayLap)</td>
                                            <td>
                                                <span class="status-badge @GetStorageExpiryStatusClass(item.NgayGiaHan)">
                                                    @FormatDateTime(item.NgayGiaHan)
                                                </span>
                                            </td>
                                            <td>@item.SoVanDon</td>
                                            <td>
                                                @{
                                                    var canDownloadLenhXuat = CanDownloadLenhXuatPdf;
                                                }
                                                <button type="button" title="Tải lệnh xuất kho Pdf"
                                                        class="portal-secondary-action"
                                                        disabled="@(!canDownloadLenhXuat)"
                                                        style="display: inline-flex; align-items: center; gap: 6px; @GetLenhXuatDownloadButtonStyle(item.So, canDownloadLenhXuat)"
                                                        @onclick="() => DownloadLenhXuatPdfAsync(item)">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="flex-shrink: 0;">
