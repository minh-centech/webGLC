        SetActiveReceiptAction(item.FKey, "invoice");
        try
        {
            var file = await OnlineOrderService.DownloadHoaDonDienTuHangNhapKhauTempPdfAsync(item.FKey);
            await DownloadPdfToBrowserAsync(file);
        }
                catch (Exception ex)
        {
            Console.WriteLine($"[DownloadHoaDonDienTu][Admin] {ex}");
            await ShowDownloadToastAsync("Không thể tải hoá đơn điện tử từ dịch vụ.", true);
