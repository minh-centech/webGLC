    private bool CanDownloadElectronicInvoice(BienNhanThanhToanHangNhapKhauTempListItem? item)
        => item?.DaThanhToan == true && !string.IsNullOrWhiteSpace(item.FKey);

    private bool CanDownloadLenhXuatPdf
    {
        get
        {
            var receipts = Workflow?.BienNhanThanhToanHangNhapKhauTemps;
            if (receipts?.Success != true || receipts.Data.Count == 0)
            {
                return false;
            }

            return receipts.Data.All(item => item.DaThanhToan);
        }
