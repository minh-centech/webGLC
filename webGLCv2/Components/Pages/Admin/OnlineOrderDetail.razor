                                                                <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 1A1.5 1.5 0 0 0 11 2.5V3h2.5L9.5 1zM4.5 9.5c0-.83.655-1.5 1.45-1.5.57 0 1.05.347 1.253.844-.143.196-.396.483-.733.824-.42.42-.767.652-1.043.766-.234-.236-.374-.553-.374-.935zm.789 2.215c.245-.075.58-.287 1.006-.714.282-.282.522-.544.717-.773a14.1 14.1 0 0 0 2.053.447c.18.577.29 1.154.29 1.637 0 .84-.336 1.343-.883 1.343-.466 0-.742-.315-.815-.715-.054-.3-.005-.675.14-1.122zm-.114-4.856c0-.525.102-.915.263-1.15.16-.237.382-.357.66-.357.288 0 .506.12.651.357.144.235.217.625.217 1.15 0 .53-.073.922-.217 1.16-.145.237-.363.357-.651.357-.278 0-.5-.12-.66-.357-.16-.238-.263-.63-.263-1.16zm5.834 5.2c-.37-.09-.766-.235-1.173-.424a14.2 14.2 0 0 0 1.657-.272c.11-.03.208-.053.292-.072.072.247.111.492.111.727 0 .393-.165.59-.444.59-.14 0-.294-.06-.443-.223z" />
                                                            </svg>
                                                            Tải PDF
                                                        </button>
                                                    }

                                                    @* @if (CanDownloadElectronicInvoice(item))
                                                    {
                                                        <button type="button" title="Tải hoá đơn điện tử pdf"
                                                                class="portal-primary-action"
                                                                style="display: inline-flex; align-items: center; gap: 6px; @GetReceiptElectronicInvoiceButtonStyle(item.FKey)"
                                                                @onclick="() => DownloadHoaDonDienTuAsync(item)">
