    private static string GetLenhXuatKhoTempMessage(OnlineOrderWorkflowResult? workflow)
    {
        if (workflow?.LenhXuatKhoHangNhapKhauTemps is null)
        {
            return "Chưa có dữ liệu danh sách lệnh xuất kho.";
        }

        if (!workflow.LenhXuatKhoHangNhapKhauTemps.Success)
        {
            return string.IsNullOrWhiteSpace(workflow.LenhXuatKhoHangNhapKhauTemps.Message)
                ? "Không thể tải danh sách lệnh xuất kho."
                : workflow.LenhXuatKhoHangNhapKhauTemps.Message;
        }

        if (workflow.LenhXuatKhoHangNhapKhauTemps.Data.Count == 0)
        {
            return "Chưa có lệnh xuất kho.";
        }

        return string.Empty;
    }

    private static string GetBienNhanThanhToanTempMessage(OnlineOrderWorkflowResult? workflow)
    {
        if (workflow?.BienNhanThanhToanHangNhapKhauTemps is null)
        {
            return "Chưa có dữ liệu biên nhận thanh toán.";
        }

        if (!workflow.BienNhanThanhToanHangNhapKhauTemps.Success)
        {
            return string.IsNullOrWhiteSpace(workflow.BienNhanThanhToanHangNhapKhauTemps.Message)
                ? "Không thể tải danh sách biên nhận thanh toán."
                : workflow.BienNhanThanhToanHangNhapKhauTemps.Message;
        }

        if (workflow.BienNhanThanhToanHangNhapKhauTemps.Data.Count == 0)
        {
            return "Chưa có biên nhận thanh toán.";
        }

        return string.Empty;
