    private bool HasPhiLuuKho
        => Workflow?.ThongQuan?.IsThongQuan == true
           && Workflow?.PhiLuuKho?.Success == true
           && Workflow.PhiLuuKho.Data is not null
           && Workflow.PhiLuuKho.Data.ChiTietHoaDon.Count > 0;

    private bool HasChiTietHouseBill
        => Workflow?.ChiTietHouseBill?.Success == true
           && Workflow.ChiTietHouseBill.ParsedData is not null;

    private bool HasChiTietHouseBillEmptyData
        => Workflow?.ChiTietHouseBill is not null
           && Workflow.ChiTietHouseBill.Success
           && string.Equals(Workflow.ChiTietHouseBill.Data?.Trim(), "[]", StringComparison.Ordinal);

    private bool CanShowOrderInfoUpdate
        => Workflow?.LenhXuatKhoHangNhapKhauTemps is not null
           && Workflow.LenhXuatKhoHangNhapKhauTemps.Success
           && Workflow.LenhXuatKhoHangNhapKhauTemps.Data.Count == 0
           && Workflow?.BienNhanThanhToanHangNhapKhauTemps is not null
           && Workflow.BienNhanThanhToanHangNhapKhauTemps.Success
           && Workflow.BienNhanThanhToanHangNhapKhauTemps.Data.Count == 0;

    private bool IsOverdueOrder
        => Order?.PickupDate.HasValue == true
           && Order.PickupDate.Value.Date < DateTime.Today
           && Workflow?.ThongQuan?.IsThongQuan == true;

    private bool HasPhiLuuKhoQuaHan
        => Workflow?.PhiLuuKhoQuaHan?.Success == true
           && Workflow.PhiLuuKhoQuaHan.Data is not null
           && Workflow.PhiLuuKhoQuaHan.Data.ChiTietHoaDon.Count > 0;

    private static decimal GetPhiSubtotal(PhiLuuKhoResponse response)
        => response.Data?.ChiTietHoaDon.Sum(item => item.TienHangThucTe) ?? 0m;

    private static decimal GetPhiSubtotal(PhiLuuKhoQuaHanResponse response)
        => response.Data?.ChiTietHoaDon.Sum(item => item.ThanhTien) ?? 0m;

    private static decimal GetPhiVatAmount(PhiLuuKhoResponse response)
    {
        var data = response.Data;
        if (data is null)
        {
            return 0m;
        }

        var explicitVat = data.ChiTietHoaDon.Sum(item => item.TienThue);
        return explicitVat > 0m ? explicitVat : GetPhiSubtotal(response) * data.Vat / 100m;
    }

    private static decimal GetPhiVatAmount(PhiLuuKhoQuaHanResponse response)
    {
        var data = response.Data;
        if (data is null)
        {
            return 0m;
        }

        var explicitVat = data.ChiTietHoaDon.Sum(item => item.TienThue);
        return explicitVat > 0m ? explicitVat : GetPhiSubtotal(response) * data.Vat / 100m;
    }

    private static decimal GetPhiGrandTotal(PhiLuuKhoResponse response)
    {
        var data = response.Data;
        if (data is null)
        {
            return 0m;
        }

        var explicitGrandTotal = data.ChiTietHoaDon.Sum(item => item.TongTien);
        return explicitGrandTotal > GetPhiSubtotal(response)
            ? explicitGrandTotal
            : GetPhiSubtotal(response) + GetPhiVatAmount(response);
    }

    private static decimal GetPhiGrandTotal(PhiLuuKhoQuaHanResponse response)
    {
        var data = response.Data;
        if (data is null)
        {
            return 0m;
        }

        var explicitGrandTotal = data.ChiTietHoaDon.Sum(item => item.TongTien);
        return explicitGrandTotal > GetPhiSubtotal(response)
            ? explicitGrandTotal
            : GetPhiSubtotal(response) + GetPhiVatAmount(response);
    }

