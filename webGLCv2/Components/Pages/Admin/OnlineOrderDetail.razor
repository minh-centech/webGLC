    private async Task DownloadLenhXuatPdfAsync(LenhXuatKhoHangNhapKhauTempListItem? item)
    {
        if (item is null || string.IsNullOrWhiteSpace(item.So))
        {
            return;
        }

        if (!CanDownloadLenhXuatPdf)
        {
            await ShowDownloadToastAsync("Vui lòng thanh toán tất cả biên nhận trước khi tải lệnh xuất kho.", true);
            return;
        }

        var file = await OnlineOrderService.DownloadLenhXuatKhoHangNhapKhauTempPdfAsync(item.So);
        await DownloadPdfToBrowserAsync(file);
    }

    private async Task DownloadBienNhanPdfAsync(BienNhanThanhToanHangNhapKhauTempListItem? item)
    {
        if (item is null || string.IsNullOrWhiteSpace(item.So))
        {
            return;
        }

        if (item.DaThanhToan != true)
        {
            await ShowDownloadToastAsync("Vui lòng thanh toán để tải biên nhận PDF.", true);
            return;
        }

        var file = await OnlineOrderService.DownloadBienNhanThanhToanHangNhapKhauTempPdfAsync(item.So);
        await DownloadPdfToBrowserAsync(file);
    }

    private async Task DownloadHoaDonDienTuAsync(BienNhanThanhToanHangNhapKhauTempListItem? item)
    {
        if (item is null || item.DaThanhToan != true || string.IsNullOrWhiteSpace(item.FKey))
        {
            return;
        }

        SetActiveReceiptAction(item.FKey, "invoice");
        try
        {
            var file = await OnlineOrderService.DownloadHoaDonDienTuHangNhapKhauTempPdfAsync(item.FKey);
            await DownloadPdfToBrowserAsync(file);
        }
                catch (Exception ex)
        {
            Console.WriteLine($"[DownloadHoaDonDienTu][Admin] {ex}");
            await ShowDownloadToastAsync("Không thể tải hoá đơn điện tử từ dịch vụ.", true);
        }
        finally
        {
            _ = ClearActiveReceiptActionAfterDelayAsync(item.FKey, "invoice", 1200);
        }
    }

    private async Task DownloadPdfToBrowserAsync(PdfDownloadResult file)
    {
        if (file.Content.Length == 0)
        {
            await ShowDownloadToastAsync("Không thể tạo file PDF để tải xuống.", true);
            return;
        }

        var started = await JSRuntime.InvokeAsync<bool>(
            "paymentQr.downloadFile",
            file.FileName,
            file.ContentType,
            Convert.ToBase64String(file.Content));

        await ShowDownloadToastAsync(
            started ? "Đã bắt đầu tải PDF." : "Không thể tạo file PDF để tải xuống.",
            !started);
    }

    private async Task ShowDownloadToastAsync(string message, bool isError)
    {
        DownloadToastMessage = message;
        DownloadToastIsError = isError;
        _ = InvokeAsync(StateHasChanged);
        if (DownloadToastCts is not null)
        {
            try
            {
                DownloadToastCts.Cancel();
            }
            catch (ObjectDisposedException)
            {
            }

            DownloadToastCts.Dispose();
            DownloadToastCts = null;
        }

        DownloadToastCts = new CancellationTokenSource();
        var token = DownloadToastCts.Token;

        try
        {
            await Task.Delay(2400, token);
            if (token.IsCancellationRequested)
            {
                return;
            }

            DownloadToastMessage = null;
            DownloadToastCts.Dispose();
            DownloadToastCts = null;
            _ = InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private string? DownloadToastMessage;
    private bool DownloadToastIsError;
    private CancellationTokenSource? DownloadToastCts;

    private string GetDownloadToastClass()
        => DownloadToastIsError ? "portal-toast portal-toast-error" : "portal-toast portal-toast-success";

    private string GetDownloadToastIcon()
        => DownloadToastIsError ? "!" : "✓";

    private bool IsReceiptActionActive(string? receiptNo, string kind)
        => !string.IsNullOrWhiteSpace(receiptNo)
           && string.Equals(ActiveReceiptActionSo, receiptNo, StringComparison.Ordinal)
           && string.Equals(ActiveReceiptActionKind, kind, StringComparison.Ordinal);

    private void SetActiveReceiptAction(string receiptNo, string kind)
    {
        ActiveReceiptActionSo = receiptNo;
        ActiveReceiptActionKind = kind;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ClearActiveReceiptActionAfterDelayAsync(string receiptNo, string kind, int delayMs)
    {
        try
        {
            await Task.Delay(delayMs);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (!string.Equals(ActiveReceiptActionSo, receiptNo, StringComparison.Ordinal) ||
            !string.Equals(ActiveReceiptActionKind, kind, StringComparison.Ordinal))
        {
            return;
        }

        ActiveReceiptActionSo = null;
        ActiveReceiptActionKind = null;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task UpdateReceiptPollingStateAsync()
    {
        await Task.CompletedTask;
    }

    private async Task OpenTaxLookupPopup()
    {
        if (Order is null)
        {
            return;
        }

        ShowOrderInfoEditor = true;
        TaxLookupInput = Order.TaxCode;
        TaxLookupMessage = null;
        TaxLookupIsError = false;
        TaxLookupIsWarning = false;
        TaxLookupResult.Clear();
        IsTaxLookupPopupOpen = true;

        try
        {
            if (!string.IsNullOrWhiteSpace(TaxLookupInput))
            {
                await SearchTaxLookupAsync();
            }
            else
            {
                TaxLookupMessage = "Vui lòng nhập mã số thuế trước khi tra cứu.";
                TaxLookupIsError = true;
                TaxLookupIsWarning = false;
            }
        }
        catch
        {
            TaxLookupMessage = "Không thể mở tra cứu mã số thuế.";
            TaxLookupIsError = true;
        }
    }

    private async Task CloseTaxLookupPopup()
    {
        IsTaxLookupPopupOpen = false;
        TaxLookupIsBusy = false;
        TaxLookupMessage = null;
        TaxLookupIsError = false;
        TaxLookupIsWarning = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadOrderInfoEditorAsync()
    {
        if (Order is null)
        {
            return;
        }

        SyncOrderInfoEditorFromOrder();
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleOrderInfoEditor()
    {
        ShowOrderInfoEditor = !ShowOrderInfoEditor;
    }

    private void SyncOrderInfoEditorFromOrder()
    {
        if (Order is null)
        {
            return;
        }

        SelectedCompanyTaxCode = Order.TaxCode;
        EditableCustomerName = Order.CustomerName;
        EditablePhoneNumber = Order.PhoneNumber;
        EditableIdentityNumber = Order.IdentityNumber;
        EditableVehicleNumber = Order.VehicleNumber;
        EditableCompanyName = Order.CompanyName;
        EditableCompanyAddress = Order.CompanyAddress;
    }

    private async Task ClearTaxLookupAsync()
    {
        TaxLookupInput = string.Empty;
        TaxLookupResult.Clear();
        TaxLookupMessage = "Đã xoá dữ liệu tra cứu.";
        TaxLookupIsError = false;
        TaxLookupIsWarning = false;

        SelectedCompanyTaxCode = string.Empty;
        EditableCompanyName = string.Empty;
        EditableCompanyAddress = string.Empty;
        Order!.TaxCode = string.Empty;
        Order!.CompanyName = string.Empty;
        Order!.CompanyAddress = string.Empty;

        await InvokeAsync(StateHasChanged);
    }

    private async Task SearchTaxLookupAsync()
    {
        TaxLookupMessage = null;
        TaxLookupIsError = false;
        TaxLookupIsWarning = false;
        TaxLookupResult.Clear();

        var taxCode = TaxLookupInput.Trim();
        if (string.IsNullOrWhiteSpace(taxCode))
        {
            TaxLookupMessage = "Vui lòng nhập mã số thuế.";
            TaxLookupIsError = true;
            return;
        }

        TaxLookupIsBusy = true;
        try
        {
            var result = await OnlineOrderService.LookupCompanyByMaSoThueAsync(taxCode);
            if (result is null)
            {
                TaxLookupMessage = "Không tìm thấy dữ liệu phù hợp cho mã số thuế này.";
                TaxLookupIsError = true;
                return;
            }

            TaxLookupResult.Add(new TaxLookupRow("Mã số thuế", result.MaSoThue, result.CreateDate));
            TaxLookupResult.Add(new TaxLookupRow("Tên công ty", result.Ten, result.CreateDate));
            TaxLookupResult.Add(new TaxLookupRow("Địa chỉ", result.DiaChi, result.CreateDate));


            if (!string.IsNullOrWhiteSpace(result.Email))
            {
                TaxLookupResult.Add(new TaxLookupRow("Email", result.Email, result.CreateDate));
            }

            if (!string.IsNullOrWhiteSpace(result.SoDienThoai))
            {
                TaxLookupResult.Add(new TaxLookupRow("Số điện thoại", result.SoDienThoai, result.CreateDate));
            }

            if (!string.IsNullOrWhiteSpace(result.NguoiDaiDien))
            {
                TaxLookupResult.Add(new TaxLookupRow("Người đại diện", result.NguoiDaiDien, result.CreateDate));
            }

            if (!string.IsNullOrWhiteSpace(result.ChucVuNguoiDaiDien))
            {
                TaxLookupResult.Add(new TaxLookupRow("Chức vụ người đại diện", result.ChucVuNguoiDaiDien, result.CreateDate));
            }

            TaxLookupResult.Add(new TaxLookupRow("Ngày cập nhật", FormatVietnameseDate(result.CreateDate), result.CreateDate));
            TaxLookupMessage = "Nhấn Dùng dữ liệu này để áp dụng thông tin doanh nghiệp vào lệnh.";
            TaxLookupIsWarning = true;
        }
        catch (Exception ex)
        {
            TaxLookupMessage = ex.Message;
            TaxLookupIsError = true;
        }
        finally
        {
            TaxLookupIsBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveOrderInfoAsync()
    {
        if (Order is null)
        {
            return;
        }

        IsSavingOrderInfo = true;
        try
        {
            Order.CustomerName = EditableCustomerName.Trim();
            Order.PhoneNumber = EditablePhoneNumber.Trim();
            Order.IdentityNumber = EditableIdentityNumber.Trim();
            Order.VehicleNumber = EditableVehicleNumber.Trim();
            Order.TaxCode = SelectedCompanyTaxCode.Trim();
            Order.CompanyName = EditableCompanyName.Trim();
            Order.CompanyAddress = EditableCompanyAddress.Trim();

            await LegacyCustomerPortalService.UpdateOrderInfoAsync(Order);
            ErrorMessage = null;
            DownloadToastMessage = "Đã cập nhật thông tin lệnh online.";
            DownloadToastIsError = false;
            IsTaxLookupPopupOpen = false;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSavingOrderInfo = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyTaxLookupResultAsync()
    {
        var taxCode = GetTaxLookupValue("mã số thuế");
        if (!string.IsNullOrWhiteSpace(taxCode))
        {
            SelectedCompanyTaxCode = taxCode;
            Order!.TaxCode = taxCode;
        }

        var companyName = GetTaxLookupValue("tên công ty");
        if (!string.IsNullOrWhiteSpace(companyName))
        {
            EditableCompanyName = companyName;
            Order!.CompanyName = companyName;
        }

        var address = GetTaxLookupValue("địa chỉ");
        if (!string.IsNullOrWhiteSpace(address))
        {
            EditableCompanyAddress = address;
            Order!.CompanyAddress = address;
        }

        if (!string.IsNullOrWhiteSpace(SelectedCompanyTaxCode))
        {
            Order!.TaxCode = SelectedCompanyTaxCode;
        }

        await CloseTaxLookupPopup();
        await InvokeAsync(StateHasChanged);
    }

    private string GetTaxLookupValue(string key)
    {
        var item = TaxLookupResult.FirstOrDefault(x => string.Equals(x.Key, key, StringComparison.OrdinalIgnoreCase));
        return item?.Value ?? string.Empty;
    }

    private static string FormatVietnameseDate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        return value;
    }

    private sealed record TaxLookupRow(string Key, string Value, string UpdateDate);

