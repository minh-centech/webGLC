@page "/admin/users/{Id}/documents"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.DependencyInjection
@inject LegacyCustomerPortalService LegacyCustomerPortalService
@inject OnlineOrderService OnlineOrderService
@inject NavigationManager NavigationManager
@inject IServiceScopeFactory ServiceScopeFactory
@inject ILogger<UserDocuments> Logger

<PageTitle>Hồ sơ tài liệu</PageTitle>

<section class="page-shell">
    <header class="page-header">
        <div>
            <p class="page-kicker">Admin Workspace</p>
            <h1>Hồ sơ tài liệu người dùng</h1>
            <p class="page-subtitle">Admin có thể bổ sung tài liệu còn thiếu, đối chiếu hồ sơ và kích hoạt tài khoản ngay trên phân hệ mới.</p>
        </div>
        <button class="portal-secondary-action" @onclick="@(() => NavigationManager.NavigateTo("/admin/users"))">Quay lại quản lý</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="portal-alert portal-alert-error">@ErrorMessage</div>
    }
    else if (Details is null)
    {
        <div class="portal-empty-state compact">
            <div class="portal-empty-icon">...</div>
            <h2>Đang tải hồ sơ</h2>
            <p>Hệ thống đang lấy thông tin upload từ dữ liệu hiện tại.</p>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(FeedbackMessage))
        {
            <div class="portal-alert @(FeedbackIsError ? "portal-alert-error" : "portal-alert-success")">@FeedbackMessage</div>
        }

        <section class="workspace-card">
            <div class="stats-grid docs-summary-grid">
                <article class="stat-card">
                    <span class="stat-label">Người dùng</span>
                    <strong>@Details.Name</strong>
                    <div class="cell-subtitle">@Details.Email</div>
                </article>
                <article class="stat-card">
                    <span class="stat-label">Loại tài khoản</span>
                    <strong>@Details.AccountTypeText</strong>
                    <div class="cell-subtitle">@Details.Phone</div>
                </article>
                <article class="stat-card">
                    <span class="stat-label">Trạng thái hồ sơ</span>
                    <strong>@(Details.HasAllRequiredDocuments ? "Đủ điều kiện" : "Thiếu tài liệu")</strong>
                    <div class="cell-subtitle">@(Details.IsActive ? "Tài khoản đang hoạt động" : "Tài khoản chưa kích hoạt")</div>
                </article>
            </div>

            <section class="workspace-card" style="margin-top:15px;">
                <div class="section-heading">
                    <h2>Cập nhật thông tin hiển thị</h2>
                    <p>Admin có thể chỉnh sửa tên hiển thị, email và số điện thoại của tài khoản ngay tại đây.</p>
                </div>

                <EditForm Model="ProfileEditModel" OnValidSubmit="SaveProfileAsync" FormName="admin-profile-edit-form">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="portal-alert portal-alert-error" />

                    <div class="field-grid">
                        <div class="field-card">
                            <label class="portal-label" for="DisplayName">
                                @(Details.AccountType == 2 ? "Tên doanh nghiệp" : "Tên hiển thị")
                            </label>
                            <InputText id="DisplayName" class="portal-input" @bind-Value="ProfileEditModel.DisplayName" />
                            <ValidationMessage For="@(() => ProfileEditModel.DisplayName)" class="validation-message" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="EmailAddress">
                                @(Details.AccountType == 2 ? "Email doanh nghiệp" : "Email")
                            </label>
                            <InputText id="EmailAddress" class="portal-input" @bind-Value="ProfileEditModel.Email" />
                            <ValidationMessage For="@(() => ProfileEditModel.Email)" class="validation-message" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="AccountPhone">
                                @(Details.AccountType == 2 ? "Số điện thoại doanh nghiệp" : "Số điện thoại người dùng")
                            </label>
                            <InputText id="AccountPhone" class="portal-input" @bind-Value="ProfileEditModel.PhoneNumber" />
                            <ValidationMessage For="@(() => ProfileEditModel.PhoneNumber)" class="validation-message" />
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="portal-primary-action" disabled="@IsSubmitting">
                            @(IsSubmitting ? "Đang lưu..." : "Lưu thông tin")
                        </button>
                    </div>
                </EditForm>
            </section>

            @if (Details.AccountType == 2)
            {
                <div class="docs-company-grid">
                    <div class="docs-info-card">
                        <span class="stat-label">Doanh nghiệp</span>
                        <strong>@Details.CompanyName</strong>
                    </div>
                    <div class="docs-info-card">
                        <span class="stat-label">Mã số thuế</span>
                        <strong>@Details.TaxCode</strong>
                    </div>
                    <div class="docs-info-card">
                        <span class="stat-label">Email doanh nghiệp</span>
                        <strong>@Details.CompanyEmail</strong>
                    </div>
                    <div class="docs-info-card">
                        <span class="stat-label">Email nhận hoá đơn</span>
                        <strong>@DisplayValue(Details.BillingEmail)</strong>
                    </div>
                    <div class="docs-info-card">
                        <span class="stat-label">Địa chỉ</span>
                        <strong>@DisplayValue(Details.CompanyAddress)</strong>
                    </div>
                    <div class="docs-info-card">
                        <span class="stat-label">Số điện thoại doanh nghiệp</span>
                        <strong>@DisplayValue(Details.CompanyPhone)</strong>
                    </div>
                </div>
            }

            @if (Details.AccountType == 1)
            {
                <section class="workspace-card">
                    <div class="section-heading">
                        <h2>Doanh nghiệp theo tài khoản cá nhân</h2>
                        <p>Dữ liệu lấy từ bảng NguoiDungDoanhNghiep theo IDDanhMucKhachHangDoiLenh = @Details.Id.</p>
                    </div>

                    @if (EnterpriseCompanies.Count == 0)
                    {
                        <div class="portal-empty-state compact">
                            <div class="portal-empty-icon">0</div>
                            <h2>Chưa có doanh nghiệp nào</h2>
                            <p>Tài khoản này chưa tạo doanh nghiệp để duyệt.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-shell">
                            <table class="portal-table">
                                <thead>
                                    <tr>
                                        <th>Tên doanh nghiệp</th>
                                        <th>Mã số thuế</th>
                                        <th>Email</th>
                                        <th>Trạng thái duyệt</th>
                                        <th class="text-end">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var company in EnterpriseCompanies)
                                    {
                                        <tr>
                                            <td>@company.TenDoanhNghiep</td>
                                            <td>@company.MaSoThue</td>
                                            <td>@company.EmailDoanhNghiep</td>
                                            <td>
                                                <span class="status-chip @(company.IsActive ? "success" : "warning")">@(company.IsActive ? "Đã duyệt" : "Chờ duyệt")</span>
                                            </td>
                                            <td class="text-end">
                                                <button class="table-action success"
                                                        disabled="@(company.IsActive || IsSubmitting)"
                                                        @onclick="() => ApproveEnterpriseAsync(company)">
                                                    Phê duyệt doanh nghiệp
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }

            <div class="docs-list" style="margin-top:15px;">
                @foreach (var file in Details.Documents)
                {
                    <article class="docs-item" @key="file.FieldKey">
                        <div>
                            <h2>@file.Name</h2>
                            <p>@(file.HasFile ? file.RelativePath : "Chưa có file được upload")</p>
                        </div>
                        <div class="docs-item-actions">
                            <span class="status-chip @(file.HasFile ? "success" : "warning")">
                                @(file.HasFile ? "Đã upload" : "Thiếu tài liệu")
                            </span>
                            @if (file.HasFile)
                            {
                                <a class="portal-primary-action docs-open-btn" href="@file.ViewUrl" target="_blank" rel="noopener">Xem PDF</a>
                                <label class="portal-secondary-action upload-inline-label upload-inline-replace-label">
                                    Thay thế tài liệu
                                    <InputFile class="admin-upload-input"
                                               OnChange="@(args => UploadDocumentAsync(file, args, true))"
                                               accept=".pdf,application/pdf" />
                                </label>
                            }
                            else
                            {
                                <label class="portal-secondary-action upload-inline-label">
                                    Tải tài liệu bổ sung
                                    <InputFile class="admin-upload-input"
                                               OnChange="@(args => UploadDocumentAsync(file, args, false))"
                                               accept=".pdf,application/pdf" />
                                </label>
                            }
                            <span class="upload-status admin-upload-status">@GetUploadStatus(file)</span>
                        </div>
                    </article>
                }
            </div>

            <div class="form-actions">
                @if (!Details.IsActive)
                {
                    <button class="portal-primary-action"
                            disabled="@(!Details.HasAllRequiredDocuments || IsSubmitting)"
                            @onclick="ApproveAsync">
                        Phê duyệt và kích hoạt
                    </button>
                }
                else if (Details.AccountType != 0)
                {
                    <button class="portal-secondary-action" disabled="@IsSubmitting" @onclick="LockAsync">Khóa tài khoản</button>
                }

                @if (!Details.HasAllRequiredDocuments && !Details.IsActive)
                {
                    <span class="docs-warning-text">Chỉ có thể phê duyệt khi hồ sơ đã đủ tài liệu bắt buộc.</span>
                }
            </div>
        </section>
    }
</section>

@code {
    private const long MaxUploadSize = 30 * 1024 * 1024;

    [Parameter]
    public string Id { get; set; } = string.Empty;

    private readonly Dictionary<string, string> UploadStatuses = new();
    private readonly List<LegacyCompanyProfile> EnterpriseCompanies = new();
    private readonly ProfileEditFormModel ProfileEditModel = new();
    private AccountDocumentDetails? Details;
    private string? ErrorMessage;
    private string? FeedbackMessage;
    private bool FeedbackIsError;
    private bool IsSubmitting;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        ErrorMessage = null;
        FeedbackMessage = null;

        try
        {
            Details = await LegacyCustomerPortalService.GetAccountDocumentsAsync(Id);
            EnterpriseCompanies.Clear();
            if (Details is not null)
            {
                if (Details.AccountType == 2)
                {
                    var latestProfile = await LegacyCustomerPortalService.GetLatestEnterpriseProfileAsync(Details.Id);
                    ProfileEditModel.DisplayName = latestProfile?.TenDoanhNghiep ?? Details.CompanyName;
                    ProfileEditModel.Email = latestProfile?.EmailDoanhNghiep ?? Details.CompanyEmail;
                    ProfileEditModel.PhoneNumber = latestProfile?.SoDienThoaiDoanhNghiep ?? Details.CompanyPhone;
                }
                else
                {
                    ProfileEditModel.DisplayName = Details.Name;
                    ProfileEditModel.Email = Details.Email;
                    ProfileEditModel.PhoneNumber = Details.Phone;
                }

                foreach (var document in Details.Documents)
                {
                    UploadStatuses[document.FieldKey] = document.HasFile ? "Đã có tài liệu." : "Sẵn sàng bổ sung.";
                }

                if (Details.AccountType == 1)
                {
                    EnterpriseCompanies.AddRange(await LegacyCustomerPortalService.GetCompaniesByCustomerAsync(Details.Id));
                }
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private static string DisplayValue(string value)
        => string.IsNullOrWhiteSpace(value) ? "Chưa cập nhật" : value;

    private async Task SaveProfileAsync()
    {
        if (Details is null)
        {
            return;
        }

        var displayName = ProfileEditModel.DisplayName.Trim();
        var email = ProfileEditModel.Email.Trim();
        var phone = ProfileEditModel.PhoneNumber.Trim();

        IsSubmitting = true;
        FeedbackMessage = null;
        ErrorMessage = null;

        try
        {
            if (Details.AccountType == 2)
            {
                var profile = await LegacyCustomerPortalService.GetLatestEnterpriseProfileAsync(Details.Id);
                if (profile is null)
                {
                    throw new InvalidOperationException("Không tìm thấy hồ sơ doanh nghiệp để cập nhật thông tin.");
                }

                await LegacyCustomerPortalService.UpdateCompanyProfileAsync(
                    profile,
                    displayName,
                    email,
                    profile.DiaChi,
                    phone);
            }
            else
            {
                await LegacyCustomerPortalService.UpdatePersonalProfileAsync(
                    Details.Id,
                    displayName,
                    phone,
                    string.IsNullOrWhiteSpace(Details.BillingEmail) ? email : Details.BillingEmail,
                    email);
            }

            Details.Name = displayName;
            Details.Email = email;
            Details.Phone = phone;
            if (Details.AccountType == 2)
            {
                Details.CompanyName = displayName;
                Details.CompanyEmail = email;
                Details.CompanyPhone = phone;
            }

            FeedbackMessage = "Đã cập nhật thông tin hiển thị thành công.";
            FeedbackIsError = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            FeedbackMessage = ex.Message;
            FeedbackIsError = true;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task UploadDocumentAsync(DocumentFileItem document, InputFileChangeEventArgs args, bool isReplace)
    {
        if (Details is null)
        {
            return;
        }

        var file = args.File;
        FeedbackMessage = null;
        ErrorMessage = null;

        if (!file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            UploadStatuses[document.FieldKey] = "Chỉ chấp nhận file PDF.";
            return;
        }

        IsSubmitting = true;
        UploadStatuses[document.FieldKey] = isReplace
            ? "Đang thay thế tài liệu..."
            : "Đang tải và cập nhật...";

        try
        {
            await using var stream = file.OpenReadStream(MaxUploadSize);
            var uploadResult = await LegacyCustomerPortalService.UploadPdfAsync(stream, file.Name, document.UploadFolder);

            if (Details.AccountType == 2)
            {
                await LegacyCustomerPortalService.UpdateEnterpriseDocumentAsync(Details.Id, document.FieldKey, uploadResult.RelativePath);
            }
            else
            {
                await LegacyCustomerPortalService.UpdatePersonalDocumentsAsync(
                    Details.Id,
                    GetCurrentDocumentPath("BanScanSoCMNDCanCuocPathCaNhan"),
                    GetCurrentDocumentPath("BanDangKyCaNhanCoChuKyPath"),
                    document.FieldKey,
                    uploadResult.RelativePath);
            }

            UploadStatuses[document.FieldKey] = isReplace
                ? "Đã thay thế tài liệu thành công."
                : "Đã bổ sung tài liệu thành công.";
            FeedbackMessage = isReplace
                ? $"Đã thay thế tài liệu: {document.Name}."
                : $"Đã bổ sung tài liệu: {document.Name}.";
            FeedbackIsError = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            UploadStatuses[document.FieldKey] = "Tải file thất bại.";
            FeedbackMessage = ex.Message;
            FeedbackIsError = true;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task ApproveAsync()
    {
        if (Details is null || !Details.HasAllRequiredDocuments)
        {
            return;
        }

        IsSubmitting = true;
        try
        {
            if (Details.AccountType == 2)
            {
                var taxCode = Details.TaxCode?.Trim();
                if (string.IsNullOrWhiteSpace(taxCode))
                {
                    throw new InvalidOperationException("Vui lòng bổ sung mã số thuế trước khi phê duyệt.");
                }

                var lookupStatus = await OnlineOrderService.GetMaSoThueLookupStatusAsync(taxCode);
                if (lookupStatus != 0 && lookupStatus != 1)
                {
                    throw new InvalidOperationException($"Không xác định được trạng thái mã số thuế: {taxCode}");
                }

                var isUpdate = lookupStatus == 0;
                var invoiceEmail = Details.BillingEmail
                    ?? Details.CompanyEmail
                    ?? Details.Email;

                var upsertResult = await OnlineOrderService.UpsertDanhMucKhachHangAsync(
                    taxCode,
                    Details.CompanyName,
                    Details.CompanyAddress,
                    taxCode,
                    Details.AuthorizedRepresentative,
                    Details.RepresentativeTitle,
                    invoiceEmail,
                    Details.CompanyPhone,
                    string.Empty,
                    isUpdate);

                if (!upsertResult.Success)
                {
                    throw new InvalidOperationException(upsertResult.Message);
                }
            }

            await LegacyCustomerPortalService.SetAccountStateAsync(Details.Id, true, false);
            Details.IsActive = true;
            Details.IsLockAccount = false;
            FeedbackMessage = "Đã phê duyệt và kích hoạt tài khoản thành công.";
            FeedbackIsError = false;
            QueueApprovalEmail(Details.Email);
        }
        catch (Exception ex)
        {
            FeedbackMessage = ex.Message;
            FeedbackIsError = true;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task LockAsync()
    {
        if (Details is null)
        {
            return;
        }

        IsSubmitting = true;
        try
        {
            await LegacyCustomerPortalService.SetAccountStateAsync(Details.Id, true, true);
            Details.IsActive = true;
            Details.IsLockAccount = true;
            FeedbackMessage = "Đã khóa tài khoản.";
            FeedbackIsError = false;
        }
        catch (Exception ex)
        {
            FeedbackMessage = ex.Message;
            FeedbackIsError = true;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task ApproveEnterpriseAsync(LegacyCompanyProfile company)
    {
        IsSubmitting = true;
        FeedbackMessage = null;

        try
        {
            await LegacyCustomerPortalService.SetEnterpriseApprovalAsync(company, true);
            company.IsActive = true;
            FeedbackMessage = $"Đã phê duyệt doanh nghiệp: {company.TenDoanhNghiep}.";
            FeedbackIsError = false;
            QueueApprovalEmail(Details?.Email ?? company.EmailDoanhNghiep);
        }
        catch (Exception ex)
        {
            FeedbackMessage = ex.Message;
            FeedbackIsError = true;
        }
        finally
        {
            IsSubmitting = false;
        }
    }
    private string GetCurrentDocumentPath(string fieldKey)
        => Details?.Documents.FirstOrDefault(x => x.FieldKey == fieldKey)?.RelativePath ?? string.Empty;

    private string GetUploadStatus(DocumentFileItem document)
        => UploadStatuses.TryGetValue(document.FieldKey, out var status)
            ? status
            : "Sẵn sàng bổ sung.";

    private void QueueApprovalEmail(string email)
    {
        var recipient = email?.Trim();
        if (string.IsNullOrWhiteSpace(recipient))
        {
            return;
        }

        _ = Task.Run(async () =>
        {
            try
            {
                using var scope = ServiceScopeFactory.CreateScope();
                var emailHelper = scope.ServiceProvider.GetRequiredService<EmailHelper>();
                await emailHelper.SendEmailAsync(recipient, EmailHelper.AccountApprovedSuccessTemplateId);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Không gửi được email phê duyệt tài khoản cho {Email}.", recipient);
            }
        });
    }

    private sealed class ProfileEditFormModel
    {
        [Required(ErrorMessage = "Vui lòng nhập tên hiển thị.")]
        public string DisplayName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng nhập email.")]
        [EmailAddress(ErrorMessage = "Email không đúng định dạng.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng nhập số điện thoại.")]
        [Phone(ErrorMessage = "Số điện thoại không đúng định dạng.")]
        public string PhoneNumber { get; set; } = string.Empty;
    }
}
