@page "/admin/users"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject LegacyCustomerPortalService LegacyCustomerPortalService
@inject OnlineOrderService OnlineOrderService
@inject IJSRuntime JSRuntime

<PageTitle>Quản trị tài khoản</PageTitle>

<section class="page-shell">
    <header class="page-header">
        <div>
            <p class="page-kicker">Admin Workspace</p>
            <h1>Quản lý và kích hoạt tài khoản</h1>
            <p class="page-subtitle">Chức năng xem danh sách, lọc trạng thái và kích hoạt hoặc khóa user.</p>
        </div>
        <button class="portal-secondary-action" @onclick="LoadAccountsAsync">Tải lại dữ liệu</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(FeedbackMessage))
    {
        <div class="portal-alert @(FeedbackIsError ? "portal-alert-error" : "portal-alert-success")">@FeedbackMessage</div>
    }

    <div class="stats-grid">
        <article class="stat-card">
            <span class="stat-label">Tổng tài khoản</span>
            <strong>@Accounts.Count</strong>
        </article>
        <article class="stat-card">
            <span class="stat-label">Đang hoạt động</span>
            <strong>@Accounts.Count(x => x.IsActive && !x.IsLockAccount)</strong>
        </article>
        <article class="stat-card">
            <span class="stat-label">Bị khóa</span>
            <strong>@Accounts.Count(x => x.IsLockAccount)</strong>
        </article>
    </div>

    <section class="workspace-card">
        <div class="toolbar-row">
            <div class="toolbar-search">
                <div class="input-action-row">
                    <div class="input-action-field">
                        <input class="portal-input"
                               @bind="SearchDraft"
                               @bind:event="oninput"
                               @onkeydown="HandleSearchKeyDown"
                               placeholder="Tìm theo tên, email hoặc số điện thoại" />
                    </div>
                    <button type="button" class="portal-primary-action" @onclick="SearchAsync">Tìm kiếm</button>
                    <button type="button" class="portal-secondary-action" @onclick="ClearFiltersAsync">Xóa bộ lọc</button>
                </div>
            </div>
            <label class="toolbar-toggle">
                <input type="checkbox"
                       checked="@ShowPendingActivationOnly"
                       @onchange="HandlePendingActivationOnlyChanged" />
                <span>Chỉ hiện tài khoản chưa kích hoạt</span>
            </label>
        </div>

        @if (IsBusy)
        {
            <div class="portal-empty-state compact">
                <div class="portal-empty-icon">...</div>
                <h2>Đang đồng bộ tài khoản</h2>
                <p>Hệ thống đang lấy dữ liệu từ API quản trị hiện hữu.</p>
            </div>
        }
        else if (FilteredAccounts.Count == 0)
        {
            <div class="portal-empty-state compact">
                <div class="portal-empty-icon">0</div>
                <h2>Không có bản ghi phù hợp</h2>
                <p>Thử đổi bộ lọc hoặc tải lại danh sách tài khoản.</p>
            </div>
        }
        else
        {
            <div class="table-shell">
                <table class="portal-table">
                    <thead>
                        <tr>
                            <th>Tài khoản</th>
                            <th>Loại</th>
                            <th>Liên hệ</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in PagedAccounts)
                        {
                            <tr>
                                <td>
                                    <div class="cell-title">@account.Name</div>
                                    <div class="cell-subtitle">@account.Email</div>
                                </td>
                                <td>
                                    <span class="status-chip @(account.AccountType == 0 ? "danger" : account.AccountType == 2 ? "success" : "neutral")">@account.AccountTypeText</span>
                                </td>
                                <td>
                                    <div class="cell-title">@account.Phone</div>
                                    <div class="cell-subtitle">ID: @account.Id</div>
                                </td>
                                <td>
                                    <span class="status-chip @(account.IsLockAccount ? "danger" : account.IsActive ? "success" : "warning")">@account.StatusText</span>
                                </td>
                                <td class="text-end">
                                    <a class="portal-secondary-action table-link-btn me-1" href="/admin/users/@account.Id/documents">Hồ sơ</a>
                                    @if (account.AccountType == 1 && account.HasPendingEnterpriseApproval)
                                    {
                                        <a class="portal-primary-action table-link-btn" style="margin:0 4px;" href="/admin/users/@account.Id/documents">Duyệt doanh nghiệp</a>
                                    }
                                    @if (!account.IsActive && !account.IsLockAccount)
                                    {
                                        <button class="table-action danger me-1"
                                                @onclick="() => DeleteAccountAsync(account)">
                                            Xóa
                                        </button>
                                    }
                                    <button class="table-action @(account.IsLockAccount || !account.IsActive ? "success" : "danger")"
                                            @onclick="() => ToggleAccountAsync(account)">
                                        @(account.IsLockAccount || !account.IsActive ? "Kích hoạt" : "Khóa")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <footer class="workspace-footer">
            <div class="footer-summary">
                <span>Kết quả lọc: <strong>@FilteredAccounts.Count</strong> tài khoản</span>
                <span>Trang <strong>@CurrentPage</strong> / @TotalPages</span>
            </div>
            <div class="footer-pagination">
                <label class="portal-label pager-label">Hiển thị</label>
                <select class="portal-input pager-size-select" @bind="PageSize" @bind:after="HandlePageSizeChangedAsync">
                    <option value="10">10 dòng</option>
                    <option value="20">20 dòng</option>
                    <option value="50">50 dòng</option>
                </select>
                <button class="portal-secondary-action pager-button" @onclick="PreviousPageAsync" disabled="@IsFirstPage">Trang trước</button>
                <span>Hiển thị <strong>@PagedAccounts.Count</strong> / @FilteredAccounts.Count</span>
                <button class="portal-secondary-action pager-button" @onclick="NextPageAsync" disabled="@IsLastPage">Trang sau</button>
            </div>
        </footer>
    </section>
</section>

@code {
    private readonly List<AccountListItem> Accounts = new();
    private bool IsBusy = true;
    private bool ShowPendingActivationOnly;
    private string SearchDraft = string.Empty;
    private string SearchTerm = string.Empty;
    private string? FeedbackMessage;
    private bool FeedbackIsError;
    private int CurrentPage = 1;
    private int PageSize = 10;

    private List<AccountListItem> FilteredAccounts =>
        Accounts
            .Where(account =>
                (!ShowPendingActivationOnly || (!account.IsActive && !account.IsLockAccount)) &&
                (string.IsNullOrWhiteSpace(SearchTerm) ||
                 account.Name.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                 account.Email.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                 account.Phone.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                 account.Id.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(account => !account.IsActive && !account.IsLockAccount)
            .ThenBy(account => account.IsLockAccount)
            .ThenByDescending(account => account.IsActive)
            .ThenBy(account => account.Name)
            .ToList();

    private List<AccountListItem> PagedAccounts =>
        FilteredAccounts
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredAccounts.Count / (double)PageSize));
    private bool IsFirstPage => CurrentPage <= 1;
    private bool IsLastPage => CurrentPage >= TotalPages;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
    }

    private void ApplyFilters()
    {
        SearchTerm = SearchDraft.Trim();
        CurrentPage = 1;
    }

    private async Task PreviousPageAsync()
    {
        if (!IsFirstPage)
        {
            CurrentPage--;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task NextPageAsync()
    {
        if (!IsLastPage)
        {
            CurrentPage++;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandlePendingActivationOnlyChanged(ChangeEventArgs e)
    {
        ShowPendingActivationOnly = e.Value is bool isChecked && isChecked;
        CurrentPage = 1;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandlePageSizeChangedAsync()
    {
        CurrentPage = 1;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAccountsAsync()
    {
        FeedbackMessage = null;
        FeedbackIsError = false;
        IsBusy = true;

        try
        {
            var accounts = await LegacyCustomerPortalService.GetAccountsAsync();
            foreach (var account in accounts.Where(x => x.AccountType == 1))
            {
                try
                {
                    var companies = await LegacyCustomerPortalService.GetCompaniesByCustomerAsync(account.Id);
                    account.HasPendingEnterpriseApproval = companies.Any(c => !c.IsActive);
                }
                catch
                {
                    account.HasPendingEnterpriseApproval = false;
                }
            }

            Accounts.Clear();
            Accounts.AddRange(accounts);
        }
        catch (Exception ex)
        {
            FeedbackMessage = ex.Message;
            FeedbackIsError = true;
        }
        finally
        {
            IsBusy = false;
            CurrentPage = 1;
        }
    }

    private async Task SearchAsync()
    {
        SearchTerm = SearchDraft.Trim();
        CurrentPage = 1;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearFiltersAsync()
    {
        SearchDraft = string.Empty;
        SearchTerm = string.Empty;
        ShowPendingActivationOnly = false;
        CurrentPage = 1;
        PageSize = 10;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task ToggleAccountAsync(AccountListItem account)
    {
        try
        {
            var nextIsLock = account.IsActive && !account.IsLockAccount;
            if (account.IsLockAccount || !account.IsActive)
            {
                nextIsLock = false;
            }

            var actionLabel = nextIsLock ? "khóa" : "kích hoạt";
            var confirmed = await JSRuntime.InvokeAsync<bool>(
                "confirm",
                $"Bạn có chắc chắn muốn {actionLabel} tài khoản {account.Email} không?");
            if (!confirmed)
            {
                return;
            }

            if (!nextIsLock && account.AccountType == 2)
            {
                var companyProfile = await LegacyCustomerPortalService.GetLatestEnterpriseProfileAsync(account.Id);
                if (companyProfile is not null)
                {
                    var glcLookup = await OnlineOrderService.LookupCompanyByMaSoThueAsync(companyProfile.MaSoThue);
                    var isUpdate = await OnlineOrderService.HasValidMaSoThueAsync(companyProfile.MaSoThue);
                    var upsertResult = await OnlineOrderService.UpsertDanhMucKhachHangAsync(
                        companyProfile.MaSoThue,
                        glcLookup?.Ten ?? companyProfile.TenDoanhNghiep,
                        glcLookup?.DiaChi ?? companyProfile.DiaChi,
                        companyProfile.MaSoThue,
                        glcLookup?.NguoiDaiDien ?? companyProfile.DaiDienCoThamQuyen,
                        glcLookup?.ChucVuNguoiDaiDien ?? companyProfile.ChucVu,
                        glcLookup?.Email ?? companyProfile.EmailDoanhNghiep,
                        glcLookup?.SoDienThoai ?? companyProfile.SoDienThoaiDoanhNghiep,
                        string.Empty,
                        isUpdate);

                    if (!upsertResult.Success)
                    {
                        throw new InvalidOperationException(upsertResult.Message);
                    }
                }
            }

            await LegacyCustomerPortalService.SetAccountStateAsync(account.Id, true, nextIsLock);
            account.IsActive = true;
            account.IsLockAccount = nextIsLock;
            account.StatusText = account.IsLockAccount
                ? "Đã khóa"
                : account.IsActive
                    ? "Đang hoạt động"
                    : "Chờ kích hoạt";
            FeedbackMessage = account.IsLockAccount
                ? $"Đã khóa tài khoản {account.Email}."
                : $"Đã kích hoạt tài khoản {account.Email}.";
            FeedbackIsError = false;
        }
        catch (Exception ex)
        {
            FeedbackMessage = ex.Message;
            FeedbackIsError = true;
        }
    }

    private async Task DeleteAccountAsync(AccountListItem account)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>(
                "confirm",
                $"Bạn có chắc chắn muốn xoá tài khoản {account.Email} không? Thao tác này không thể hoàn tác.");
            if (!confirmed)
            {
                return;
            }

            await LegacyCustomerPortalService.DeleteAccountAsync(account.Id);
            await LoadAccountsAsync();
            FeedbackMessage = $"Đã xoá tài khoản {account.Email}.";
            FeedbackIsError = false;
        }
        catch (Exception ex)
        {
            FeedbackMessage = ex.Message;
            FeedbackIsError = true;
        }
    }
}







