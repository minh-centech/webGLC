@inject NavigationManager NavigationManager

<section class="portal-empty-state">
    <div class="portal-empty-icon">!</div>
    <h1>Phiên làm việc chưa sẵn sàng</h1>
    <p>Bạn cần đăng nhập để truy cập portal hoặc tài khoản hiện tại không có quyền vào phân hệ này.</p>
    <a class="portal-primary-action" href="@BuildLoginUrl()">Đăng nhập</a>
</section>

@code {
    private string BuildLoginUrl()
    {
        var relative = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (string.IsNullOrWhiteSpace(relative) || relative == "/")
        {
            return "/login";
        }

        return $"/login?returnUrl={Uri.EscapeDataString(relative)}";
    }
}
