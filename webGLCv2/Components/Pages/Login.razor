@page "/login"
@rendermode InteractiveServer
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject LegacyCustomerPortalService LegacyCustomerPortalService

<PageTitle>Dang nhap khach hang</PageTitle>

<div class="login-shell">
    <div class="login-card">
        <aside class="login-aside">
            <div class="login-badge">Cong EverHouse</div>
            <h1 class="login-title">Quan ly lenh va tra cuu thong tin hang</h1>
            <p class="login-description">
                Theo doi trang thai ho so, tao lenh online va chu dong lam viec voi bo phan van hanh trong mot luong thong nhat.
            </p>

            <div class="login-highlight">
                <strong>GLC</strong>

                <ul class="login-points">
                    <li>Tao va theo doi lenh online thuan tien.</li>
                    <li>Tra cuu thong tin hang nhap va lich lay hang nhanh.</li>
                    <li>Giam thao tac roi rac, tap trung vao dung nghiep vu can xu ly.</li>
                </ul>
            </div>
        </aside>

        <section class="login-form-panel">
            <div class="login-brandline">
                <img class="login-brand-image" src="/images/glc-logo.png" alt="GLC logo" />
                <div>
                    <div class="login-brandname">GLC Portal v2</div>
                    <div class="login-brandmeta">Customer workspace</div>
                </div>
            </div>

            <div class="login-form-header">
                <h2>Dang nhap he thong</h2>
                <p>Vui long nhap email, mat khau va ma captcha de truy cap he thong.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="portal-alert portal-alert-error">@Error</div>
            }

            <form class="login-form" method="post" action="/auth/login">
                <input type="hidden" name="CaptchaToken" value="@Captcha.CaptchaToken" />
                <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />

                <label class="portal-label" for="email">Email</label>
                <input id="email" class="portal-input" type="email" name="Email" value="@Email" placeholder="name@company.com" required />

                <label class="portal-label" for="password">Mat khau</label>
                <input id="password" class="portal-input" type="password" name="Password" placeholder="Nhap mat khau" required />

                <label class="portal-label" for="captcha">Ma captcha</label>
                <div class="login-captcha-row">
                    <input id="captcha" class="portal-input" type="text" name="CaptchaCode" placeholder="Nhap ma captcha" required />
                    <div class="login-captcha-box">
                        <span>@Captcha.CaptchaDisplayText</span>
                        <a href="@RefreshUrl" class="login-captcha-refresh" aria-label="Tai lai captcha">↻</a>
                    </div>
                </div>
                <p class="portal-help">Khong phan biet chu hoa thuong. Neu kho doc, hay lam moi captcha.</p>

                <button type="submit" class="portal-primary-action login-submit">Dang nhap</button>
            </form>

            <div class="login-secondary-actions">
                <a class="portal-secondary-action" href="/register">Dang ky tai khoan</a>
                <a class="portal-secondary-action" href="/huong-dan-su-dung">Xem huong dan su dung</a>
                <button type="button" class="portal-secondary-action portal-secondary-button" @onclick="ShowForgotPasswordPopup">Quen mat khau</button>
            </div>
        </section>
    </div>
</div>

@if (IsForgotPasswordPopupOpen)
{
    <div class="portal-modal-backdrop" @onclick="HideForgotPasswordPopup">
        <div class="portal-modal" @onclick:stopPropagation="true">
            <h3>Quen mat khau</h3>
            <p>Vui long lien he quan tri vien de duoc ho tro cap lai mat khau tai khoan.</p>
            <div class="portal-modal-actions">
                <button type="button" class="portal-primary-action" @onclick="HideForgotPasswordPopup">Da hieu</button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    private LoginCaptchaDto Captcha { get; set; } = new();
    private bool IsForgotPasswordPopupOpen { get; set; }

    private string RefreshUrl => BuildLoginUrl(includeEmail: true, bustCache: true);

    protected override async Task OnParametersSetAsync()
    {
        Captcha = await LegacyCustomerPortalService.GetLoginCaptchaAsync();
    }

    private string BuildLoginUrl(bool includeEmail, bool bustCache)
    {
        var queryParts = new List<string>();

        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            queryParts.Add($"returnUrl={Uri.EscapeDataString(ReturnUrl)}");
        }

        if (includeEmail && !string.IsNullOrWhiteSpace(Email))
        {
            queryParts.Add($"email={Uri.EscapeDataString(Email)}");
        }

        if (bustCache)
        {
            queryParts.Add($"t={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}");
        }

        return queryParts.Count == 0 ? "/login" : $"/login?{string.Join("&", queryParts)}";
    }

    private void ShowForgotPasswordPopup()
        => IsForgotPasswordPopupOpen = true;

    private void HideForgotPasswordPopup()
        => IsForgotPasswordPopupOpen = false;
}
