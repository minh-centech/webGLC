@page "/login"
@rendermode InteractiveServer
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject Microsoft.Extensions.Options.IOptions<webGLCv2.Models.TurnstileOptions> TurnstileConfiguration
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager
@inject LegacyCustomerPortalService LegacyCustomerPortalService
@inject EmailHelper EmailHelper
@inject TurnstileValidationService TurnstileValidationService

<PageTitle>GLC - Đăng nhập khách hàng</PageTitle>
<HeadContent>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
</HeadContent>

<div class="login-shell">
    <div class="login-card">
        <aside class="login-aside">
            <div class="login-badge">everWareHouse</div>
            <h1 class="login-title">Quản lý lệnh và tra cứu trạng thái thái hàng nhập</h1>
            <p class="login-description">
                Cổng thông tin được thiết kế nhằm mang lại trải nghiệm làm việc xuyên suốt và minh bạch cho quý khách hàng. Tại đây, bạn có thể dễ dàng tạo lệnh online, theo dõi trạng thái hồ sơ theo thời gian thực và tương tác trực tiếp với bộ phận vận hành. Tất cả thao tác được tích hợp trong một luồng quy trình thống nhất, giúp tối ưu hóa thời gian và nâng cao hiệu quả công việc
            </p>

            <div class="login-highlight">
                <strong>GLC</strong>

                <ul class="login-points">
                    <li>Tạo và quản lý lệnh trực tuyến.</li>
                    <li>Tra cứu hàng nhập & Lịch lấy hàng nhanh.</li>
                    <li>Tối ưu hóa quy trình xử lý.</li>
                </ul>
            </div>

            <footer class="login-aside-footer">
                <img class="login-aside-footer-logo" src="/images/EVERLINK.png" alt="Everlink logo" />
                <div class="login-aside-footer-copy">
                    <span class="login-highlight-label">Đơn vị phát triển</span>
                    <strong>Công ty cổ phần Everlink</strong>
                    <p>Liên hệ tư vấn, phát triển phần mềm: admin@everlink.com.vn.</p>
                </div>
            </footer>
        </aside>

        <section class="login-form-panel">
            <div class="login-brandline">
                <img class="login-brand-image" src="/images/glc-logo.png" alt="GLC logo" />
                <div>
                    <div class="login-brandname">GREEN LOGISTICS CENTRE</div>
                    <div class="login-brandmeta">everWareHouse</div>
                </div>
            </div>

            <div class="login-form-header">
                <h2>ĐĂNG NHẬP HỆ THỐNG</h2>
                <p>Chào mừng bạn quay trở lại! Hãy nhập email, mật khẩu và xác thực để bắt đầu làm việc.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="portal-alert portal-alert-error">@Error</div>
            }

            @if (!HasTurnstileConfiguration)
            {
                <div class="portal-alert portal-alert-error">
                    Chua cau hinh Cloudflare Turnstile. Liên hệ quản trị viên.
                </div>
            }

            <form id="login-form" class="login-form" method="post" action="/auth/login" @formname="login-form">
                <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
                <input type="hidden" id="login-turnstile-token" name="cf-turnstile-response" />

                <label class="portal-label" for="email">Email</label>
                <input id="email" class="portal-input" type="email" name="Email" value="@Email" placeholder="name@company.com" required />

                <label class="portal-label" for="password">Mật khẩu</label>
                <input id="password" class="portal-input" type="password" name="Password" placeholder="Nhập mật khẩu" required />

                <label class="portal-label">Xác thực bảo mật</label>
                <div class="login-turnstile-wrap">
                    <div id="login-turnstile"></div>
                </div>
                <button type="button"
                        class="portal-secondary-action portal-secondary-button"
                        @onclick="RefreshTurnstileAsync"
                        disabled="@(!HasTurnstileConfiguration)">
                    Nếu xác thực không hiển thị, bấm để tải lại
                </button>
                <p class="portal-help"></p>

                <button type="submit" class="portal-primary-action login-submit" disabled="@(!HasTurnstileConfiguration)">Đăng nhập</button>
            </form>

            <div class="login-secondary-actions">
                <a class="portal-secondary-action" href="/register">Đăng ký tài khoản</a>
                <a class="portal-secondary-action" href="/huong-dan-su-dung">Hướng dẫn sử dụng</a>
                <button type="button" class="portal-secondary-action portal-secondary-button" @onclick="ShowForgotPasswordPopup">Quên mật khẩu</button>
            </div>
        </section>
    </div>
</div>

@if (IsForgotPasswordPopupOpen)
{
    <div class="portal-modal-backdrop" @onclick="HideForgotPasswordPopup">
        <div class="portal-modal" @onclick:stopPropagation="true">
            <h3>Quên mật khẩu</h3>
            <p>Vui lòng nhập email đăng ký để hệ thống kiểm tra và cấp lại mật khẩu mới.</p>
            <label class="portal-label" for="forgot-email">Email</label>
            <input id="forgot-email" class="portal-input" type="email" @bind="ForgotPasswordEmail" placeholder="name@company.com" />
            <label class="portal-label">Xác thực bảo mật</label>
            <div class="login-turnstile-wrap">
                <div id="forgot-password-turnstile"></div>
            </div>
            <input type="hidden" id="forgot-password-turnstile-token" @bind="ForgotPasswordTurnstileToken" @bind:event="oninput" />
            <button type="button"
                    class="portal-secondary-action portal-secondary-button"
                    @onclick="RefreshForgotPasswordTurnstileAsync"
                    disabled="@(!HasTurnstileConfiguration)">
                Nếu xác thực không hiển thị, bấm để tải lại
            </button>
            @if (!string.IsNullOrWhiteSpace(ForgotPasswordMessage))
            {
                <div class="portal-alert @(ForgotPasswordIsError ? "portal-alert-error" : "portal-alert-success")">@ForgotPasswordMessage</div>
            }
            <div class="portal-modal-actions">
                <button type="button" class="portal-primary-action" disabled="@IsForgotPasswordBusy" @onclick="SubmitForgotPasswordAsync">Gửi mật khẩu mới</button>
                <button type="button" class="portal-primary-action" @onclick="HideForgotPasswordPopup">Đóng lại</button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "reload")]
    public string? ReloadToken { get; set; }

    [SupplyParameterFromQuery(Name = "t")]
    public string? CacheBustToken { get; set; }

    private bool IsForgotPasswordPopupOpen { get; set; }
    private bool IsForgotPasswordBusy { get; set; }
    private bool ForgotPasswordIsError { get; set; }
    private string? ForgotPasswordEmail { get; set; }
    private string? ForgotPasswordMessage { get; set; }
    private string? ForgotPasswordTurnstileToken { get; set; }
    private string? _lastTurnstileReloadToken;
    private bool _hasForcedCacheBust;
    private bool _shouldRenderTurnstile = true;
    private bool _shouldRenderForgotPasswordTurnstile;
    private string SiteKey => TurnstileConfiguration.Value.SiteKey;
    private bool HasTurnstileConfiguration =>
        !string.IsNullOrWhiteSpace(TurnstileConfiguration.Value.SiteKey)
        && !string.IsNullOrWhiteSpace(TurnstileConfiguration.Value.SecretKey);

    protected override void OnInitialized()
    {
        if (HasTurnstileConfiguration && string.IsNullOrWhiteSpace(CacheBustToken) && !_hasForcedCacheBust)
        {
            _hasForcedCacheBust = true;
            var bustedUrl = NavManager.GetUriWithQueryParameter("t", DateTimeOffset.UtcNow.ToUnixTimeMilliseconds());
            NavManager.NavigateTo(bustedUrl, forceLoad: true, replace: true);
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.Equals(_lastTurnstileReloadToken, ReloadToken, StringComparison.Ordinal))
        {
            _lastTurnstileReloadToken = ReloadToken;
            _shouldRenderTurnstile = true;
        }
    }

    private void ShowForgotPasswordPopup()
    {
        ForgotPasswordMessage = null;
        ForgotPasswordIsError = false;
        ForgotPasswordTurnstileToken = null;
        _shouldRenderForgotPasswordTurnstile = true;
        IsForgotPasswordPopupOpen = true;
    }

    private void HideForgotPasswordPopup()
    {
        IsForgotPasswordPopupOpen = false;
        ForgotPasswordTurnstileToken = null;
        _shouldRenderForgotPasswordTurnstile = false;
    }

    private async Task SubmitForgotPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(ForgotPasswordEmail))
        {
            ForgotPasswordMessage = "Vui lòng nhập email.";
            ForgotPasswordIsError = true;
            return;
        }

        IsForgotPasswordBusy = true;
        ForgotPasswordMessage = null;
        ForgotPasswordIsError = false;

        try
        {
            if (string.IsNullOrWhiteSpace(ForgotPasswordTurnstileToken))
            {
                ForgotPasswordMessage = "Vui lòng xác thực bảo mật trước khi gửi yêu cầu.";
                ForgotPasswordIsError = true;
                return;
            }

            var turnstileResult = await TurnstileValidationService.ValidateDetailedAsync(
                ForgotPasswordTurnstileToken,
                null,
                CancellationToken.None);

            if (!turnstileResult.Success)
            {
                var errorDetail = string.IsNullOrWhiteSpace(turnstileResult.ErrorDetail)
                    ? "unknown-turnstile-error"
                    : turnstileResult.ErrorDetail;

                ForgotPasswordMessage = $"Xác thực Turnstile không thành công. Vui lòng thử lại. ({errorDetail})";
                ForgotPasswordIsError = true;
                ForgotPasswordTurnstileToken = null;
                _shouldRenderForgotPasswordTurnstile = true;
                return;
            }

            var newPassword = await LegacyCustomerPortalService.RecoverPasswordAsync(ForgotPasswordEmail);
            await EmailHelper.SendPasswordResetEmailAsync(ForgotPasswordEmail, newPassword);
            Console.WriteLine($"Mật khẩu mới: { newPassword}.");
            ForgotPasswordMessage = $"Mật khẩu mới đã được gửi đến email: {ForgotPasswordEmail}.";
            ForgotPasswordIsError = false;
            ForgotPasswordTurnstileToken = null;
            _shouldRenderForgotPasswordTurnstile = true;
        }
        catch (Exception ex)
        {
            ForgotPasswordMessage = ex.Message;
            ForgotPasswordIsError = true;
            ForgotPasswordTurnstileToken = null;
            _shouldRenderForgotPasswordTurnstile = true;
        }
        finally
        {
            IsForgotPasswordBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldRenderTurnstile && HasTurnstileConfiguration)
        {
            _shouldRenderTurnstile = false;
            await JSRuntime.InvokeVoidAsync("glcTurnstile.forceRenderLogin", "login-turnstile", SiteKey);
        }

        if (_shouldRenderForgotPasswordTurnstile && HasTurnstileConfiguration)
        {
            _shouldRenderForgotPasswordTurnstile = false;
            await JSRuntime.InvokeVoidAsync("glcTurnstile.render", "forgot-password-turnstile", SiteKey, "forgot-password-turnstile-token");
        }
    }

    private async Task RefreshForgotPasswordTurnstileAsync()
    {
        if (!HasTurnstileConfiguration)
        {
            return;
        }

        _shouldRenderForgotPasswordTurnstile = true;
        ForgotPasswordTurnstileToken = null;
        await JSRuntime.InvokeVoidAsync("glcTurnstile.render", "forgot-password-turnstile", SiteKey, "forgot-password-turnstile-token");
        _shouldRenderForgotPasswordTurnstile = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshTurnstileAsync()
    {
        if (!HasTurnstileConfiguration)
        {
            return;
        }

        _shouldRenderTurnstile = true;
        await JSRuntime.InvokeVoidAsync("glcTurnstile.forceRenderLogin", "login-turnstile", SiteKey);
        _shouldRenderTurnstile = false;
        await InvokeAsync(StateHasChanged);
    }
}


