@page "/login"
@rendermode InteractiveServer
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject Microsoft.Extensions.Options.IOptions<webGLCv2.Models.TurnstileOptions> TurnstileConfiguration
@inject IJSRuntime JSRuntime

<PageTitle>Dang nhap khach hang</PageTitle>
<HeadContent>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
</HeadContent>

<div class="login-shell">
    <div class="login-card">
        <aside class="login-aside">
            <div class="login-badge">everWareHouse</div>
            <h1 class="login-title">Quản lý lệnh và tra cứu trạng thái thái hàng nhập</h1>
            <p class="login-description">
                Cổng thông tin được thiết kế nhằm mang lại trải nghiệm làm việc xuyên suốt và minh bạch cho quý khách hàng. Tại đây, bạn có thể dễ dàng tạo lệnh online, theo dõi trạng thái hồ sơ theo thời gian thực và tương tác trực tiếp với bộ phận vận hành. Tất cả thao tác được tích hợp trong một luồng quy trình thống nhất, giúp tối ưu hóa thời gian và nâng cao hiệu quả công việc
            </p>

            <div class="login-highlight">
                <strong>GLC</strong>

                <ul class="login-points">
                    <li>Tạo và quản lý lệnh trực tuyến.</li>
                    <li>Tra cứu hàng nhập & Lịch lấy hàng nhanh.</li>
                    <li>Tối ưu hóa quy trình xử lý.</li>
                </ul>
            </div>
        </aside>

        <section class="login-form-panel">
            <div class="login-brandline">
                <img class="login-brand-image" src="/images/glc-logo.png" alt="GLC logo" />
                <div>
                    <div class="login-brandname">GREEN LOGISTICS CENTRE</div>
                    <div class="login-brandmeta">everWareHouse</div>
                </div>
            </div>

            <div class="login-form-header">
                <h2>ĐĂNG NHẬP HỆ THỐNG</h2>
                <p>Chào mừng bạn quay trở lại! Hãy nhập email, mật khẩu và xác thực để bắt đầu làm việc.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="portal-alert portal-alert-error">@Error</div>
            }

            @if (!HasTurnstileConfiguration)
            {
                <div class="portal-alert portal-alert-error">
                    Chua cau hinh Cloudflare Turnstile. Liên hệ quản trị viên.
                </div>
            }

            <form id="login-form" class="login-form" method="post" action="/auth/login" @formname="login-form">
                <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
                <input type="hidden" id="login-turnstile-token" name="cf-turnstile-response" />

                <label class="portal-label" for="email">Email</label>
                <input id="email" class="portal-input" type="email" name="Email" value="@Email" placeholder="name@company.com" required />

                <label class="portal-label" for="password">Mật khẩu</label>
                <input id="password" class="portal-input" type="password" name="Password" placeholder="Nhập mật khẩu" required />

                <label class="portal-label">Xác thực bảo mật</label>
                <div class="login-turnstile-wrap">
                    <div id="login-turnstile"></div>
                </div>
                <p class="portal-help"></p>

                <button type="submit" class="portal-primary-action login-submit" disabled="@(!HasTurnstileConfiguration)">Đăng nhập</button>
            </form>

            <div class="login-secondary-actions">
                <a class="portal-secondary-action" href="/register">Đăng ký tài khoản</a>
                <a class="portal-secondary-action" href="/huong-dan-su-dung">Hướng dẫn sử dụng</a>
                <button type="button" class="portal-secondary-action portal-secondary-button" @onclick="ShowForgotPasswordPopup">Quên mật khẩu</button>
            </div>
        </section>
    </div>
</div>

@if (IsForgotPasswordPopupOpen)
{
    <div class="portal-modal-backdrop" @onclick="HideForgotPasswordPopup">
        <div class="portal-modal" @onclick:stopPropagation="true">
            <h3>Quên mật khẩu</h3>
            <p>Quý khách vui lòng liên hệ Quản trị viên để được hỗ trợ cấp lại mật khẩu tài khoản.</p>
            <div class="portal-modal-actions">
                <button type="button" class="portal-primary-action" @onclick="HideForgotPasswordPopup">Đóng lại</button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    private bool IsForgotPasswordPopupOpen { get; set; }
    private string SiteKey => TurnstileConfiguration.Value.SiteKey;
    private bool HasTurnstileConfiguration =>
        !string.IsNullOrWhiteSpace(TurnstileConfiguration.Value.SiteKey)
        && !string.IsNullOrWhiteSpace(TurnstileConfiguration.Value.SecretKey);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && HasTurnstileConfiguration)
        {
            await JSRuntime.InvokeVoidAsync("glcTurnstile.renderLogin", "login-turnstile", SiteKey);
        }
    }

    private void ShowForgotPasswordPopup()
        => IsForgotPasswordPopupOpen = true;

    private void HideForgotPasswordPopup()
        => IsForgotPasswordPopupOpen = false;
}


