    private async Task SendRegistrationEmailsAsync(RegisterAccountModel model)
    {
        try
        {
            await EmailHelper.SendEmailAsync(model.Email, EmailHelper.RegistrationPendingApprovalTemplateId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Không gửi được email xác nhận đăng ký cho người dùng {Email}.", model.Email);
        }

        try
        {
            await EmailHelper.SendRegistrationPendingApprovalNotificationAsync(model);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Không gửi được email thông báo đăng ký cho quản trị.");
        }
    }

    private async Task LookupEnterpriseInfoAsync()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        LookupStatus = string.Empty;
        LookupIsError = false;

        var taxCode = Model.MaSoThue?.Trim();
        if (string.IsNullOrWhiteSpace(taxCode))
        {
            LookupStatus = "Vui lòng nhập mã số thuế trước khi lấy thông tin.";
            LookupIsError = true;
            ResetEnterpriseLookupFields();
            return;
        }

        IsLookupBusy = true;
        try
        {
            OnlineOrderService.CompanyTaxLookupResult? glcLookup = null;
            try
            {
                glcLookup = await OnlineOrderService.LookupCompanyByMaSoThueAsync(taxCode);
            }
            catch (InvalidOperationException)
            {
                glcLookup = null;
            }

            if (glcLookup is not null)
            {
                ApplyEnterpriseLookup(
                    taxCode,
                    glcLookup.Ten,
                    glcLookup.DiaChi,
                    glcLookup.SoDienThoai,
                    glcLookup.NguoiDaiDien,
                    glcLookup.ChucVuNguoiDaiDien,
                    glcLookup.Email);

                LookupStatus = $"Mã số thuế của Quý khách đã tồn tại trong hệ thống GLC, ngày cập nhật: <span class='mst-updated-date'>{FormatVietnamDateTime(glcLookup.CreateDate)}</span>. Quý khách vui lòng kiểm tra lại các thông tin đã điền; nếu có sai sót, vui lòng đính chính để đảm bảo dữ liệu chính xác hoặc vui lòng thử";
                LookupIsError = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            var payload = await MaSoThueHelper.ProcessTaxInfoV2(taxCode);
            if (string.IsNullOrWhiteSpace(payload))
            {
                LookupStatus = "Thông báo: Vui lòng thử lại sau 10 giây, nếu vẫn gặp sự cố lấy thông tin mã số thuế tự động, Quý khách hàng vui lòng bổ sung thông tin thủ công để tiếp tục.";
                LookupIsError = true;
                ResetEnterpriseLookupFields();
                return;
            }

            using var document = JsonDocument.Parse(payload);
            var root = document.RootElement;
            if (root.ValueKind != JsonValueKind.Object || root.EnumerateObject().Count() == 0)
            {
                LookupStatus = "Thông báo: Vui lòng thử lại sau 10 giây, nếu vẫn gặp sự cố lấy thông tin mã số thuế tự động, Quý khách hàng vui lòng bổ sung thông tin thủ công để tiếp tục.";
                LookupIsError = true;
                ResetEnterpriseLookupFields();
                return;
            }

            ApplyEnterpriseLookup(
                GetString(root, "ma_so_thue", taxCode),
                GetString(root, "ten_cong_ty"),
                FirstNonEmpty(GetString(root, "dia_chi_thue"), GetString(root, "dia_chi")),
                GetString(root, "dien_thoai"),
                GetString(root, "nguoi_dai_dien"),
                GetString(root, "chuc_vu_nguoi_dai_dien"),
                GetString(root, "email"));

            var ngay_cap_nhat = GetString(root, "ngay_cap_nhat");
            LookupStatus = $"Mã số thuế được đồng bộ tự động từ nguồn masothue.com ngày cập nhật <span class='mst-updated-date'>{FormatVietnamDateTime(ngay_cap_nhat)}</span>. Quý khách vui lòng kiểm tra kỹ các thông tin hệ thống đã điền; nếu có sai sót, vui lòng chỉnh sửa lại cho chính xác.";
            LookupIsError = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            LookupStatus = "Thông báo: Mã số thuế không tồn tại trên hệ thống GLC và masothue.com. Vui lòng bổ sung thông tin thủ công để tiếp tục.";
            LookupIsError = true;
            ResetEnterpriseLookupFields();
        }
        finally
        {
            IsLookupBusy = false;
        }
    }

