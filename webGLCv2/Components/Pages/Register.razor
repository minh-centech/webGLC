    private async Task<string?> ConvertImagesToPdfAndUploadAsync(
        InputFileChangeEventArgs args,
        string folder,
        string filePrefix,
        Action<string> setStatus)
    {
        ErrorMessage = null;

        var files = args.GetMultipleFiles(12).ToList();
        if (files.Count == 0)
        {
            setStatus("Chưa chọn hình ảnh.");
            return null;
        }

        var invalidFile = files.FirstOrDefault(file => !file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase));
        if (invalidFile is not null)
        {
            setStatus("Chỉ chấp nhận hình ảnh.");
            ErrorMessage = $"File {invalidFile.Name} không phải hình ảnh.";
            return null;
        }

        try
        {
            setStatus("Đang xử lý hình ảnh...");
            var images = new List<string>();
            foreach (var file in files)
            {
                await using var stream = file.OpenReadStream(8 * 1024 * 1024);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                images.Add(Convert.ToBase64String(memoryStream.ToArray()));
            }

            var pdfBytes = BuildPdfFromImages(images, filePrefix);
            if (pdfBytes.Length == 0)
            {
                setStatus("Không tạo được file PDF.");
                ErrorMessage = "Không tạo được file PDF từ hình ảnh.";
                return null;
            }

            await using var pdfStream = new MemoryStream(pdfBytes);
            var uploadResult = await LegacyCustomerPortalService.UploadPdfAsync(
                pdfStream,
                $"{filePrefix}-{DateTime.Now:yyyyMMddHHmmss}.pdf",
                folder,
                CancellationToken.None);

            setStatus($"{files.Count} hình ảnh đã chuyển sang PDF và tải lên thành công.");
            return uploadResult.RelativePath;
        }
        catch (Exception ex)
        {
            setStatus("Tải ảnh thất bại.");
            ErrorMessage = ex.Message;
            return null;
        }
    }

    private async Task<string?> UploadPdfAsync(IBrowserFile file, string folder, Action<string> setStatus)
    {
        ErrorMessage = null;

        if (!file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            setStatus("Chỉ chấp nhận file PDF.");
            return null;
        }

        try
        {
            setStatus("Đang tải file...");
            await using var stream = file.OpenReadStream(MaxUploadSize);
            var result = await LegacyCustomerPortalService.UploadPdfAsync(stream, file.Name, folder);
            setStatus($"{result.OriginalFileName} đã tải thành công.");
            return result.RelativePath;
        }
        catch (Exception ex)
        {
            setStatus("Tải file thất bại.");
            ErrorMessage = ex.Message;
            return null;
        }
    }

    private static string GetString(JsonElement element, string propertyName, string fallback = "")
        => element.TryGetProperty(propertyName, out var property) && property.ValueKind != JsonValueKind.Null
            ? property.ToString() ?? fallback
            : fallback;

    private static string FirstNonEmpty(params string[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

