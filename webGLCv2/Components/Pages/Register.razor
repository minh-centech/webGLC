    private static byte[] BuildPdfFromImages(IReadOnlyList<string> base64Images, string title)
    {
        if (base64Images.Count == 0)
        {
            return Array.Empty<byte>();
        }

        using var document = new PdfDocument();
        document.Info.Title = title;

        for (var index = 0; index < base64Images.Count; index++)
        {
            var bytes = Convert.FromBase64String(base64Images[index]);
            using var imageStream = new MemoryStream(bytes);
            using var xImage = XImage.FromStream(() => imageStream);

            var page = document.AddPage();
            page.Size = PdfSharpCore.PageSize.A4;
            using var gfx = XGraphics.FromPdfPage(page);

            const double margin = 24;
            var maxWidth = page.Width - margin * 2;
            var maxHeight = page.Height - margin * 2;
            var scale = Math.Min(maxWidth / xImage.PixelWidth, maxHeight / xImage.PixelHeight);
            var drawWidth = xImage.PixelWidth * scale;
            var drawHeight = xImage.PixelHeight * scale;
            var x = (page.Width - drawWidth) / 2;
            var y = (page.Height - drawHeight) / 2;

            gfx.DrawImage(xImage, x, y, drawWidth, drawHeight);
        }

        using var output = new MemoryStream();
        document.Save(output, false);
        return output.ToArray();
    }
