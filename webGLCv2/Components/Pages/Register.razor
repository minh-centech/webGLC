@page "/register"
@rendermode InteractiveServer
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject LegacyCustomerPortalService LegacyCustomerPortalService
@inject OnlineOrderService OnlineOrderService
@inject MaSoThueHelper MaSoThueHelper
@inject EmailHelper EmailHelper
@inject ILogger<Register> Logger
@inject Microsoft.Extensions.Options.IOptions<webGLCv2.Models.TurnstileOptions> TurnstileConfiguration
@inject TurnstileValidationService TurnstileValidationService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Text
@using PdfSharpCore.Drawing
@using PdfSharpCore.Pdf
@using System.Text.Json

<HeadContent>
    @if (HasTurnstileUiConfiguration)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
    }
</HeadContent>

<PageTitle>Đăng ký tài khoản</PageTitle>

<div class="register-shell">
    <div class="register-card">
        <aside class="register-aside">
            <div class="login-brandline register-brandline">
                <img class="login-brand-image" src="/images/glc-logo.png" alt="GLC logo" />
                <div>
                    <div class="login-brandname">GREEN LOGISTICS CENTRE</div>
                    <div class="login-brandmeta">Đăng ký tài khoản mới</div>
                </div>
            </div>

            <h1>Đăng ký tài khoản Cá nhân/Doanh nghiệp.</h1>
            <p>
                Chào mừng bạn đến với hệ thống giao dịch thế hệ mới. Vui lòng cung cấp đầy đủ thông tin theo biểu mẫu bên dưới. Đội ngũ quản trị sẽ phê duyệt và gửi thông báo xác nhận trực tiếp qua email của bạn trong thời gian sớm nhất.
            </p>

            <ul class="login-points">
                <li>
                    <strong>Khách hàng Cá nhân:</strong> Chuẩn bị thông tin liên lạc, bản sao CCCD và đơn đăng ký có chữ ký xác nhận.
                    <div style="margin-top:8px;">
                        <a class="portal-secondary-action register-download-button" href="/downloads/Mau-dang-ky-dich-vu-E-Warehouse-GLC-ca-nhan.docx" target="_blank" rel="noopener noreferrer">
                            Tải biểu mẫu cá nhân
                        </a>
                    </div>
                </li>
                <li>
                    <strong>Khách hàng Doanh nghiệp:</strong> Cung cấp mã số thuế, bộ hồ sơ pháp lý, thông tin người đại diện hợp pháp và biểu mẫu ePort bản gốc.
                    <div style="margin-top:8px;">
                        <a class="portal-secondary-action register-download-button" href="/downloads/Mau-dang-ky-dich-vu-E-Warehouse-GLC-doanh-nghiep.docx" target="_blank" rel="noopener noreferrer">
                            Tải biểu mẫu doanh nghiệp
                        </a>
                    </div>
                </li>
            </ul>

            <div class="register-side-actions">
                <a class="portal-secondary-action" href="/login">Quay lại đăng nhập</a>
            </div>

            <footer class="login-aside-footer">
                <img class="login-aside-footer-logo" src="/images/EVERLINK.png" alt="Everlink logo" />
                <div class="login-aside-footer-copy">
                    <span class="login-highlight-label">Đơn vị phát triển</span>
                    <strong>Công ty cổ phần Everlink</strong>
                    <p>Liên hệ tư vấn, phát triển phần mềm: admin@everlink.com.vn.</p>
                </div>
            </footer>
