@code {
    private const long MaxUploadSize = 30 * 1024 * 1024;

    private RegisterAccountModel Model { get; set; } = new();
    private bool IsSubmitting { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private string? _lastTurnstileReloadToken;
    private bool _shouldRenderTurnstile = true;
    private string _turnstileRenderSeed = Guid.NewGuid().ToString("N");
    private string? RegisterTurnstileToken { get; set; }
    private string CitizenCardStatus { get; set; } = "Chưa tải tài liệu.";
    private string BusinessLicenseStatus { get; set; } = "Chưa tải tài liệu.";
    private string EportFormStatus { get; set; } = "Chưa tải tài liệu.";
    private string PersonalFormStatus { get; set; } = "Chưa tải tài liệu.";

    private bool IsLookupBusy { get; set; }
    private string LookupStatus { get; set; } = string.Empty;
    private bool LookupIsError { get; set; }

    private bool IsEnterprise => Model.LoaiTaiKhoan == 2;

    private string SiteKey => TurnstileConfiguration.Value.SiteKey;
    private bool HasTurnstileUiConfiguration =>
        !string.IsNullOrWhiteSpace(TurnstileConfiguration.Value.SiteKey);

    private bool HasTurnstileValidationConfiguration =>
        TurnstileConfiguration.Value.EnableValidation
        && !string.IsNullOrWhiteSpace(TurnstileConfiguration.Value.SiteKey)
        && !string.IsNullOrWhiteSpace(TurnstileConfiguration.Value.SecretKey);
    private string TurnstileRenderKey => $"register-{_turnstileRenderSeed}";

    protected override void OnParametersSet()
    {
        if (!string.Equals(_lastTurnstileReloadToken, RegisterTurnstileToken, StringComparison.Ordinal))
        {
            _lastTurnstileReloadToken = RegisterTurnstileToken;
            _shouldRenderTurnstile = true;
            _turnstileRenderSeed = Guid.NewGuid().ToString("N");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldRenderTurnstile && HasTurnstileUiConfiguration)
        {
            _shouldRenderTurnstile = false;
            await JSRuntime.InvokeVoidAsync("glcTurnstile.forceRenderRegister", "register-turnstile", SiteKey);
        }
    }

    private async Task SubmitAsync()
    {
        ErrorMessage = null;
        SuccessMessage = null;

        if (HasTurnstileValidationConfiguration && string.IsNullOrWhiteSpace(RegisterTurnstileToken))
        {
            ErrorMessage = "Vui lòng xác thực Turnstile trước khi gửi đăng ký.";
            return;
        }

        if (!ValidateBeforeSubmit())
        {
            return;
        }

        IsSubmitting = true;

        try
        {
            var turnstileToken = RegisterTurnstileToken;
            if (HasTurnstileValidationConfiguration && string.IsNullOrWhiteSpace(turnstileToken))
            {
                ErrorMessage = "Vui lòng xác thực bảo mật Cloudflare trước khi đăng ký.";
                return;
            }

            if (HasTurnstileValidationConfiguration)
            {
                var turnstileResult = await TurnstileValidationService.ValidateDetailedAsync(
                    turnstileToken!,
                    null,
                    CancellationToken.None);

                if (!turnstileResult.Success)
                {
                    ErrorMessage = string.IsNullOrWhiteSpace(turnstileResult.ErrorDetail)
                        ? "Xác thực Turnstile không thành công. Vui lòng thử lại."
                        : $"Xác thực Turnstile không thành công: {turnstileResult.ErrorDetail}";
                    _shouldRenderTurnstile = true;
                    _turnstileRenderSeed = Guid.NewGuid().ToString("N");
                    RegisterTurnstileToken = null;
                    return;
                }
            }

            Model.TenDangNhap = Model.Email;
            await LegacyCustomerPortalService.RegisterAccountAsync(Model);
            QueueRegistrationEmails(Model);
            SuccessMessage = "Hệ thống đã tiếp nhận yêu cầu đăng ký.";
            Model = new RegisterAccountModel();
