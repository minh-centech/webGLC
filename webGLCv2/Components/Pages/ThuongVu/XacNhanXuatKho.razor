@page "/thuong-vu/xacnhan-xuatkho"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "ThuongVu")]
@inject OnlineOrderService OnlineOrderService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Thương vụ - Xác nhận lệnh xuất kho</PageTitle>

<section class="page-shell">
    <header class="page-header">
        <div>
            <p class="page-kicker">ThuongVu Workspace</p>
            <h1>Xác nhận lệnh xuất kho</h1>
            <p class="page-subtitle">Vui lòng nhập số phiếu lệnh xuất kho để tác nghiệp.</p>
        </div>
    </header>

    <section class="workspace-card">
        <div class="section-heading">
            <h2>Tìm kiếm theo số phiếu lệnh xuất kho</h2>
            <p>Nhập số phiếu lệnh xuất kho để truy vấn thông tin.</p>
        </div>

        <form class="thuongvu-xacnhan" @onsubmit="HandleSearchSubmitAsync" @onsubmit:preventDefault="true">
            <div class="order-filter-grid">

                <div class="order-filter-field">
                    <label class="portal-label" for="receipt-no-input">
                        Số phiếu lệnh xuất kho
                    </label>

                    <input id="receipt-no-input"
                           class="portal-input order-filter-input"
                           @bind="SoLenhXuatKho"
                           @bind:event="oninput"
                           @onkeydown="OnInputKeyDown"
                           placeholder="Nhập số lệnh xuất kho..." />
                </div>

                <div class="order-filter-actions">
                    <button type="button"
                            class="clear-button"
                            @onclick="ClearSearch">
                        Xóa
                    </button>

                    <button type="submit"
                            class="portal-primary-action order-filter-button"
                            disabled="@IsSearching">
                        @(IsSearching ? "Đang tìm..." : "Tìm kiếm")
                    </button>

                    @if (LenhXuatKhoDetail?.ID is not null)
                    {
                        @if (LenhXuatKhoDetail.PheDuyet == true)
                        {
                            <span class="approve-badge">
                                <i class="bi bi-check-circle-fill"></i>
                                Đã phê duyệt
                            </span>
                        }
                        else
                        {
                            <button type="button"
                                    class="approve-button"
                                    @onclick="ApproveAsync">
                                <i class="bi bi-check-lg"></i>
                                Phê duyệt
                            </button>
                        }
                    }

                </div>

            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div style="margin-top:10px" class="portal-alert @(IsError ? "portal-alert-error" : "portal-alert-success")">@StatusMessage</div>
        }

        @if (LenhXuatKhoDetail?.ID is not null)
        {
            <div class="detail-card" style="margin-top:20px;">

                <div class="section-heading">
                    <h2>Thông tin lệnh xuất kho</h2>
                </div>

                <table class="portal-table dense">
                    <tbody>

                        <tr class="table-group">
                            <th colspan="2">Thông tin chi tiết lệnh xuất kho @LenhXuatKhoDetail.So</th>
                        </tr>

                        <tr>
                            <th>Trạng thái</th>
                            <td>
                                <span class="status-chip @(LenhXuatKhoDetail.PheDuyet == true ? "success" : "danger")">
                                    @(LenhXuatKhoDetail.PheDuyet == true ? "Đã phê duyệt" : "Chờ phê duyệt")
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <th>Người phê duyệt</th>
                            <td> <span class="status-chip warning">@(LenhXuatKhoDetail.NguoiPheDuyet ?? "-")</span></td>
                        </tr>

                        <tr>
                            <th>Ngày lập</th>
                            <td>@FormatDateTime(LenhXuatKhoDetail.NgayLap)</td>
                        </tr>
                
                        <tr>
                            <th>Ngày gia hạn cuối</th>
                            <td>@FormatDateTime(LenhXuatKhoDetail.NgayGiaHanCuoi)</td>
                        </tr>
                        
                        <tr>
                            <th>Mã số thuế</th>
                            <td>@(LenhXuatKhoDetail.MaSoThue ?? "-")</td>
                        </tr>

                        <tr>
                            <th>Tên khách hàng</th>
                            <td>@(LenhXuatKhoDetail.TenDanhMucKhachHang ?? "-")</td>
                        </tr>
                        
                        <tr>
                            <th>EDO</th>
                            <td>@(LenhXuatKhoDetail.EDO ?? "-")</td>
                        </tr>

                        <tr>
                            <th>Master Bill</th>
                            <td>@(LenhXuatKhoDetail.MasterBill ?? "-")</td>
                        </tr>

                        <tr>
                            <th>Số tờ khai</th>
                            <td>@(LenhXuatKhoDetail.SoToKhai ?? "-")</td>
                        </tr>

                        <tr>
                            <th>Số vận đơn</th>
                            <td>@(LenhXuatKhoDetail.SoVanDon ?? "-")</td>
                        </tr>

                        <tr>
                            <th>Số lượng kiện xuất</th>
                            <td>@(LenhXuatKhoDetail.SoLuongKienXuat)</td>
                        </tr>

                        <tr>
                            <th>Khối lượng xuất (Kg)</th>
                            <td>@(LenhXuatKhoDetail.KhoiLuongXuat)</td>
                        </tr>

                        <tr>
                            <th>CBM xuất</th>
                            <td>@(LenhXuatKhoDetail.CBMXuat)</td>
                        </tr>

                        <tr>
                            <th>Số Container</th>
                            <td>@(LenhXuatKhoDetail.SoContainer ?? "-")</td>
                        </tr>

                        <tr>
                            <th>Số lượng quá khổ</th>
                            <td>@(LenhXuatKhoDetail.SoLuongQuaKho)</td>
                        </tr>

                        <tr>
                            <th>Số lượng quá tải</th>
                            <td>@(LenhXuatKhoDetail.SoLuongQuaTai)</td>
                        </tr>

                        <tr>
                            <th>Hàng nguy hiểm</th>
                            <td>@(LenhXuatKhoDetail.HangNguyHiem == true ? "Có" : "Không")</td>
                        </tr>

                    </tbody>
                </table>
            </div>
        }
        else if (HasSearched && string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="portal-empty-inline" style="margin-top:18px; padding: 12px; background-color: #fdf2f2; border: 1px solid #f5c2c2; border-radius: 4px; color: #de3b3b; font-weight: 500;">
                ⚠️ Không tìm thấy biên nhận phù hợp.
            </div>
        }
    </section>
</section>

@code {
    private string SoLenhXuatKho { get; set; } = string.Empty;
    private bool IsSearching { get; set; }
    private bool HasSearched { get; set; }
    private bool IsError { get; set; }
    private string? StatusMessage { get; set; }
    private LenhXuatKhoHangNhapKhauDetail? LenhXuatKhoDetail { get; set; }

    private async Task OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private void ClearSearch()
    {
        SoLenhXuatKho = string.Empty;
        LenhXuatKhoDetail = null;
        StatusMessage = null;
        IsError = false;
        HasSearched = false;
    }

    private async Task SearchAsync()
    {
        HasSearched = true;
        IsError = false;
        StatusMessage = null;
        LenhXuatKhoDetail = null;

        if (string.IsNullOrWhiteSpace(SoLenhXuatKho))
        {
            IsError = true;
            StatusMessage = "Vui lòng nhập số lệnh xuất kho online.";
            return;
        }

        IsSearching = true;
        try
        {
            LenhXuatKhoDetail = await OnlineOrderService.LenhXuatKhoDetailAsync(SoLenhXuatKho.Trim());

            if (LenhXuatKhoDetail is null)
            {
                IsError = true;
                StatusMessage = $"Không tìm thấy thông tin lệnh xuất kho online: {SoLenhXuatKho.Trim()}.";
            }
            else
            {
                StatusMessage = $"Thông tin chi tiết lệnh xuất kho online:";
            }
        }
        catch (Exception ex)
        {
            IsError = true;
            StatusMessage = $"Đã có lỗi: {ex.Message}";
        }
        finally
        {
            IsSearching = false;
        }
    }

    private Task HandleSearchSubmitAsync()
        => SearchAsync();

    private async Task ApproveAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            string currUserEmail =
            authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
            ?? authState.User.Identity?.Name
            ?? string.Empty;
            await OnlineOrderService.ApproveLenhXuatKho(SoLenhXuatKho, "", currUserEmail);
            IsError = false;
            StatusMessage = $"Đã phê duyệt lệnh thành công";
            // Load lại dữ liệu
            await SearchAsync();

        }
        catch (Exception ex)
        {
            IsError = true;
            StatusMessage = $"Đã có lỗi khi phê duyệt: {ex.Message}";
        }

    }

    private static string FormatDateTime(DateTime? value)
         => value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "-";

    private static string FormatMoney(decimal value)
        => value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"));
}
