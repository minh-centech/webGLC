@page "/user/import-check"
@rendermode InteractiveServer
@attribute [Authorize]
@inject OnlineOrderService OnlineOrderService
@inject LegacyCustomerPortalService LegacyCustomerPortalService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using Microsoft.AspNetCore.Components
@using System.Globalization
@using System.Security.Claims
@using Microsoft.JSInterop

<PageTitle>Kiểm tra hàng nhập</PageTitle>

<section class="page-shell">
    <header class="page-header">
        <div>
            <p class="page-kicker">User Workspace</p>
            <h1>Kiểm tra hàng nhập</h1>
            <p class="page-subtitle">Tra cứu tình trạng hàng nhập theo HouseBill, Số tờ khai, Ngày tờ khai và Mã số hải quan để theo dõi tiếp nhận và thông quan.</p>
            <p class="page-subtitle" style="color:darkred">Lưu ý: Hệ thống hiện chỉ hỗ trợ làm lệnh trực tuyến đối với các HouseBill đi kèm một tờ khai hải quan duy nhất.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="portal-alert portal-alert-warning" style="margin-bottom: 16px;">@ErrorMessage</div>
    }

    <section class="workspace-card">
        <div class="section-heading">
            <h2>Tra cứu thông tin thông quan</h2>
            <p>Nhập House Bill, Số tờ khai, Ngày tờ khai và Mã số hải quan để lấy dữ liệu từ hải quan.</p>
        </div>

        <div class="field-grid">
            <div>
                <label class="portal-label" for="houseBill">House Bill <span style="color:red">(*)</span></label>
                <input id="houseBill" class="portal-input" @bind="HouseBill" @bind:event="oninput" placeholder="Nhập House Bill" />
            </div>
            <div>
                <label class="portal-label" for="declarationNumber">Số tờ khai <span style="color:red">(*)</span></label>
                <input id="declarationNumber"
                       class="portal-input"
                       @bind="DeclarationNumber"
                       @bind:event="oninput"
                       placeholder="Nhập Số tờ khai"
                       required />
            </div>
            @* <div>
                <label class="portal-label" for="declarationDate">Ngày tờ khai <span style="color:red">(*)</span></label>
                <input id="declarationDate"
                       class="portal-input"
                       value="@DeclarationDateText"
                       @oninput="OnDeclarationDateInput"
                       @onchange="OnDeclarationDateInput"
                       placeholder="dd/MM/yyyy"
                       inputmode="numeric"
                       required />
            </div>
            <div>
                <label class="portal-label" for="customsCode">Mã số hải quan <span style="color:red">(*)</span></label>
                <input id="customsCode"
                       class="portal-input"
                       @bind="CustomsCode"
                       @bind:event="oninput"
                       placeholder="Nhập Mã loại hình"
                       required />
            </div> *@
            <div class="search-actions-block">
                <button type="button" class="portal-primary-action" @onclick="SearchAsync" disabled="@IsSearching">
                    @(IsSearching ? "Đang lấy dữ liệu! Vui lòng đợi trong ít phút..." : "Tra cứu dữ liệu")
                </button>
            </div>
        </div>
    </section>

    @if (!HasDeclarationMismatch && (ThongQuanResult is not null || ChiTietResult is not null))
    {
        @if (ChiTietResult?.Success == true && ChiTietResult.ParsedData is not null)
        {
            <section class="workspace-card">
                <div class="section-heading">
                    <h2>Kết quả tra cứu tình trạng thông quan</h2>
                    <p>@GetResultSummary()</p>
                </div>

                <div class="workflow-grid">
                    <article class="workflow-card">
                        <div class="section-heading" style="display:flex; align-items:center; justify-content:space-between; gap: 12px;">
                            <h2>Tình trạng thông quan</h2>
                           
                            @if (CanShowCreateOnlineOrderButton)
                            {
                                <button type="button"
                                        class="portal-primary-action import-check-action-button"
                                        @onclick="OpenOnlineOrderAction">
                                    @(HasExistingOnlineOrder ? "Xem chi tiết" : "Tạo lệnh online")
                                </button>
                            }
                        </div>
                        <span class="status-chip @GetThongQuanClass(ThongQuanResult)">
                            @GetThongQuanLabel(ThongQuanResult)
                        </span>
                        @if (ThongQuanResult is not null && !string.IsNullOrWhiteSpace(ThongQuanResult.Message))
                        {
                            <div class="portal-alert portal-alert-warning" style="margin-top: 12px;">
                                @GetThongQuanMessage()
                            </div>
                        }
                    </article>

                    <article class="workflow-card" style="display:none;">
                        <div class="section-heading">
                            <h2>Chi tiết House Bill</h2>
                            <span class="status-chip @GetChiTietClass(ChiTietResult?.ParsedData)">
                                @GetChiTietLabel(ChiTietResult?.ParsedData)
                            </span>
                        </div>
                        <p class="workflow-message">@GetChiTietMessage()</p>
                    </article>
                </div>
            </section>
        }
    }

    @if (DetailRows.Count > 0)
    {
        <section class="workspace-card">

            <div class="section-heading" style="margin-bottom:14px;">
                <h2 style="margin-bottom:4px;">Thông tin chi tiết House Bill</h2>
                <p style="color:#6b7280;">Lấy dữ liệu thành công.</p>
            </div>

            <div class="table-shell" style="max-height:560px; overflow-y:auto;">

                <table style="width:100%; border-collapse:collapse; font-family:'Segoe UI',Arial,sans-serif; font-size:14px; background:#fff; border:1px solid #e5e7eb; border-radius:10px; overflow:hidden;">
                    <tbody>

                        @for (int i = 0; i < DetailRows.Count; i++)
                        {
                            var row = DetailRows[i];
                            var bgColor = i % 2 == 0 ? "#f8fafc" : "#ffffff";

                            <tr style="background:@bgColor;">
                                <td style="padding:12px 16px; width:35%; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">
                                    @row.Label
                                </td>

                                <td style="padding:12px 16px; color:#111827; border-bottom:1px solid #e5e7eb;">
                                    @row.Value
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>
        </section>
    }

    @if (false)
    {
    <section class="workspace-card">
        <div class="table-shell">
            <table class="portal-table dense">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Ngày nhận</th>
                        <th>Số MasterBill</th>
                        <th>Số HouseBill</th>
                        <th>Số lượng</th>
                        <th>Số khối</th>
                        <th>Trọng lượng</th>
                        <th>Số Container</th>
                        <th>Forwarder</th>
                        <th>Status</th>
                        <th>TK Hải quan</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Results.Count == 0)
                    {
                        <tr>
                            <td colspan="11">
                                <div class="portal-empty-inline">Chưa có kết quả phù hợp. Hãy nhập House Bill hoặc Số Cont để tìm kiếm.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @for (var index = 0; index < Results.Count; index++)
                        {
                            var item = Results[index];
                            <tr>
                                <td>@(index + 1)</td>
                                <td>@item.ReceivedDate.ToString("dd/MM/yyyy")</td>
                                <td>@item.MasterBill</td>
                                <td>@item.HouseBill</td>
                                <td>@item.Quantity</td>
                                <td>@item.Volume.ToString("N1")</td>
                                <td>@item.Weight.ToString("N0")</td>
                                <td>@item.ContainerNumber</td>
                                <td>@item.Forwarder</td>
                                <td>
                                    <span class="status-chip @GetStatusClass(item.Status)">@item.Status</span>
                                </td>
                                <td>@item.CustomsDeclaration</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
    }
</section>

@if (IsSearching)
{
    <div class="portal-modal-backdrop loading-overlay"
         aria-live="polite"
         aria-busy="true">

        <div class="portal-modal loading-modal">

            <div class="loading-spinner" aria-hidden="true"></div>

            <h3 class="loading-title">
                Đang kiểm tra tình trạng thông quan
            </h3>

            <div class="loading-alert">
                <span class="loading-alert-label">Chú ý:</span>
                Thông tin thông quan đang được đối chiếu với hệ thống Hải quan điện tử.
                Quá trình này có thể mất một vài phút tùy theo thời gian phản hồi từ hệ thống.
            </div>

        </div>
    </div>
}

@if (IsNoDataModalOpen)
    {
        <div class="portal-modal-backdrop" @onclick="CloseNoDataModal">
            <div class="portal-modal" @onclick:stopPropagation="true">
                <div>
                    <h3>Thông báo</h3>
                    <div class="portal-alert portal-alert-error" style="margin-top: 12px;">@NoDataModalMessage</div>
                </div>

                <div class="portal-modal-actions">
                    @if (CanShowExistingOnlineOrderButton)
                    {
                        <button type="button"
                                class="portal-primary-action"
                                @onclick="OpenExistingOnlineOrderAsync">
                            Xem chi tiết
                        </button>
                    }
                    <button type="button" class="portal-primary-action" @onclick="CloseNoDataModal">Đóng lại</button>
                </div>
        </div>
    </div>
}

@if (IsDeclarationMismatchModalOpen)
{
    <div class="portal-modal-backdrop" @onclick="CloseDeclarationMismatchModal">
        <div class="portal-modal" @onclick:stopPropagation="true">
            <div>
                <h3>Thông báo</h3>
                <div class="portal-alert portal-alert-error" style="margin-top: 12px;">@DeclarationMismatchMessage</div>
            </div>

            <div class="portal-modal-actions">
                <button type="button" class="portal-primary-action" @onclick="CloseDeclarationMismatchModal">Đóng lại</button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "houseBill")]
    private string? HouseBillFromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "soToKhai")]
    private string? DeclarationNumberFromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "containerNumber")]
    private string? LegacyDeclarationNumberFromQuery { get; set; }
    private string HouseBill { get; set; } = string.Empty;
    private string DeclarationNumber { get; set; } = string.Empty;
    private DateTime? DeclarationDate { get; set; }
    private string CustomsCode { get; set; } = string.Empty;
    private List<ImportCheckRecord> Results { get; set; } = [];
    private ThongQuanCheckResponse? ThongQuanResult { get; set; }
    private ChiTietHouseBillResponse? ChiTietResult { get; set; }
    private List<DetailRow> DetailRows { get; set; } = [];
    private string SearchMessage { get; set; } = string.Empty;
    private string ErrorMessage { get; set; } = string.Empty;
    private string NoDataModalMessage { get; set; } = string.Empty;
    private string DeclarationMismatchMessage { get; set; } = string.Empty;
    private long? ExistingOnlineOrderId { get; set; }
    private long CurrentUserId { get; set; }
    private bool AutoLoaded;
    private bool IsSearching;
    private bool IsNoDataModalOpen;
    private bool IsDeclarationMismatchModalOpen;
    private bool HasDeclarationMismatch;
    private bool _shouldInitDeclarationDatePicker = true;
    private bool HasExistingOnlineOrder => ExistingOnlineOrderId.HasValue;
    private bool CanShowExistingOnlineOrderButton
        => ExistingOnlineOrderId.HasValue
           && (ChiTietResult is null || ChiTietResult.Success == false || ChiTietResult.ParsedData is null || ChiTietResult.ParsedData.IsHoanThanh);
    private bool CanShowCreateOnlineOrderButton
        => ChiTietResult?.Success == true
           && ChiTietResult.ParsedData is not null
           && ThongQuanResult?.Success == true
           && !string.IsNullOrWhiteSpace(ThongQuanResult.Data?.SoToKhai);

    protected override async Task OnParametersSetAsync()
    {
        if (AutoLoaded)
        {
            return;
        }

        var queryHouseBill = HouseBillFromQuery?.Trim() ?? string.Empty;
        var queryDeclaration = DeclarationNumberFromQuery?.Trim()
            ?? LegacyDeclarationNumberFromQuery?.Trim()
            ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(queryHouseBill))
        {
            HouseBill = queryHouseBill;
        }

        if (!string.IsNullOrWhiteSpace(queryDeclaration))
        {
            DeclarationNumber = queryDeclaration;
        }

        if (string.IsNullOrWhiteSpace(queryHouseBill))
        {
            ErrorMessage = "Vui lòng nhập số House Bill trước khi tìm kiếm.";
            return;
        }

        AutoLoaded = true;
        await SearchAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUserId = long.TryParse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), out var parsedId) ? parsedId : 0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_shouldInitDeclarationDatePicker)
        {
            return;
        }

        _shouldInitDeclarationDatePicker = false;
        await JSRuntime.InvokeVoidAsync("orderDatePicker.initPickupDatePicker", "declarationDate");
    }

    private async Task SearchAsync()
    {
        var normalizedHouseBill = HouseBill.Trim();
        var normalizedDeclarationNumber = DeclarationNumber.Trim();
        //var normalizedDeclarationDate = DeclarationDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;
        //var normalizedCustomsCode = CustomsCode.Trim();

        SearchMessage = string.Empty;
        ErrorMessage = string.Empty;
        NoDataModalMessage = string.Empty;
        DeclarationMismatchMessage = string.Empty;
        IsNoDataModalOpen = false;
        IsDeclarationMismatchModalOpen = false;
        HasDeclarationMismatch = false;
        ThongQuanResult = null;
        ChiTietResult = null;
        DetailRows = [];
        Results = [];
        ExistingOnlineOrderId = null;

        if (string.IsNullOrWhiteSpace(normalizedHouseBill))
        {
            ErrorMessage = "Vui lòng nhập House Bill trước khi tìm kiếm.";
            return;
        }

        if (string.IsNullOrWhiteSpace(normalizedDeclarationNumber))
        {
            ErrorMessage = "Vui lòng nhập Số tờ khai trước khi tìm kiếm.";
            return;
        }

        IsSearching = true;

        try
        {
            if (!string.IsNullOrWhiteSpace(normalizedHouseBill))
            {
                HouseBill = normalizedHouseBill;
            }

            if (!string.IsNullOrWhiteSpace(normalizedDeclarationNumber))
            {
                DeclarationNumber = normalizedDeclarationNumber;
            }

            // if (!string.IsNullOrWhiteSpace(normalizedCustomsCode))
            // {
            //     CustomsCode = normalizedCustomsCode;
            // }

            try
            {
                ChiTietResult = await OnlineOrderService.GetChiTietHouseBillValidAsync(normalizedHouseBill);
            }
            catch
            {
                await ResolveExistingOnlineOrderAsync(normalizedHouseBill);
                OpenNoDataModal("House Bill không có dữ liệu hoặc bị lỗi.");
                return;
            }

            if (ChiTietResult is null || !ChiTietResult.Success || ChiTietResult.ParsedData is null)
            {
                await ResolveExistingOnlineOrderAsync(normalizedHouseBill);
                OpenNoDataModal(string.IsNullOrWhiteSpace(ChiTietResult?.Message)
                    ? "House Bill không tồn tại hoặc đã được xác nhận hoàn thành."
                    : ChiTietResult.Message);
                return;
            }

            try
            {
                ThongQuanResult = await OnlineOrderService.CheckThongQuanAsync(
                    normalizedHouseBill,
                    ChiTietResult.ParsedData?.SoContainer ?? string.Empty,
                    ChiTietResult.ParsedData);
            }
            catch (Exception ex)
            {
                ErrorMessage = AppendError(ErrorMessage, $"Không thể lấy tình trạng thông quan: {ex.Message}");
            }

            if (ThongQuanResult is null)
            {
                ErrorMessage = AppendError(ErrorMessage, "Không thể lấy tình trạng thông quan.");
                ThongQuanResult = null;
                ChiTietResult = null;
                DetailRows = [];
                Results = [];
                ExistingOnlineOrderId = null;
                SearchMessage = string.Empty;
                return;
            }

            if (!ThongQuanResult.Success)
            {
                ErrorMessage = AppendError(ErrorMessage, string.IsNullOrWhiteSpace(ThongQuanResult.Message)
                    ? "Không thể lấy tình trạng thông quan."
                    : ThongQuanResult.Message);
                ThongQuanResult = null;
                ChiTietResult = null;
                DetailRows = [];
                Results = [];
                ExistingOnlineOrderId = null;
                SearchMessage = string.Empty;
                return;
            }

            var customsDeclarationNumber = NormalizeComparisonValue(ThongQuanResult.Data?.SoToKhai);
            if (string.IsNullOrWhiteSpace(customsDeclarationNumber))
            {
                ErrorMessage = "Không lấy được số tờ khai từ Hải quan.";
                ThongQuanResult = null;
                ChiTietResult = null;
                DetailRows = [];
                Results = [];
                ExistingOnlineOrderId = null;
                SearchMessage = string.Empty;
                return;
            }

            if (!string.Equals(customsDeclarationNumber, NormalizeComparisonValue(normalizedDeclarationNumber), StringComparison.OrdinalIgnoreCase))
            {
                HasDeclarationMismatch = true;
                OpenDeclarationMismatchModal(
                    "Lỗi! Số tờ khai House Bill không khớp với dữ liệu Hải quan. Vui lòng kiểm tra và thử lại.");
                ThongQuanResult = null;
                ChiTietResult = null;
                DetailRows = [];
                Results = [];
                ExistingOnlineOrderId = null;
                SearchMessage = string.Empty;
                return;
            }

            try
            {
                ExistingOnlineOrderId = await LegacyCustomerPortalService.FindOnlineOrderIdByHouseBillAsync(CurrentUserId, normalizedHouseBill);
            }
            catch (Exception ex)
            {
                ErrorMessage = AppendError(ErrorMessage, $"Không thể kiểm tra lệnh online hiện có: {ex.Message}");
            }

            DetailRows = BuildDetailRows(ChiTietResult.ParsedData);
            Results = BuildSummaryRows(ThongQuanResult, ChiTietResult.ParsedData, normalizedHouseBill, normalizedDeclarationNumber);

            if (string.IsNullOrWhiteSpace(ErrorMessage))
            {
                SearchMessage = "Đã tải xong tình trạng thông quan và chi tiết House Bill.";
            }
        }
        finally
        {
            IsSearching = false;
        }
    }

    private static string AppendError(string current, string next)
        => string.IsNullOrWhiteSpace(current) ? next : $"{current} {next}";

    private void OpenNoDataModal(string message)
    {
        NoDataModalMessage = message;
        IsNoDataModalOpen = true;
    }

    private void CloseNoDataModal()
    {
        IsNoDataModalOpen = false;
        NoDataModalMessage = string.Empty;
    }

    private void OpenDeclarationMismatchModal(string message)
    {
        DeclarationMismatchMessage = message;
        IsDeclarationMismatchModalOpen = true;
    }

    private void CloseDeclarationMismatchModal()
    {
        IsDeclarationMismatchModalOpen = false;
        DeclarationMismatchMessage = string.Empty;
    }

    private async Task OpenOnlineOrderAction()
    {
        if (ExistingOnlineOrderId.HasValue)
        {
            NavigationManager.NavigateTo($"/user/orders/{ExistingOnlineOrderId.Value}");
            return;
        }

        await OpenNewOnlineOrderAsync();
    }

    private Task OpenExistingOnlineOrderAsync()
    {
        if (ExistingOnlineOrderId.HasValue)
        {
            NavigationManager.NavigateTo($"/user/orders/{ExistingOnlineOrderId.Value}");
        }

        return Task.CompletedTask;
    }

    private async Task ResolveExistingOnlineOrderAsync(string normalizedHouseBill)
    {
        try
        {
            ExistingOnlineOrderId = await LegacyCustomerPortalService.FindOnlineOrderIdByHouseBillAsync(CurrentUserId, normalizedHouseBill);
        }
        catch (Exception ex)
        {
            ErrorMessage = AppendError(ErrorMessage, $"Không thể kiểm tra lệnh online hiện có: {ex.Message}");
        }
    }

    private async Task OpenNewOnlineOrderAsync()
    {
        if (string.IsNullOrWhiteSpace(HouseBill.Trim()))
        {
            ErrorMessage = "Vui long nhap House Bill truoc khi tao lenh online.";
            return;
        }

        var parsedData = ChiTietResult?.ParsedData;
        var soContValue = parsedData?.SoContainer ?? string.Empty;
        var soVanDonValue = parsedData?.SoVanDon ?? HouseBill.Trim();
        var soToKhaiValue = ThongQuanResult?.Data?.SoToKhai ?? parsedData?.SoToKhai ?? DeclarationNumber.Trim();
        long? idCtLenhNhapKhoHangNhapKhauChiTiet = parsedData?.ID > 0
            ? (long)parsedData.ID
            : null;

        if (!idCtLenhNhapKhoHangNhapKhauChiTiet.HasValue || idCtLenhNhapKhoHangNhapKhauChiTiet.Value <= 0)
        {
            ErrorMessage = "Không tìm thấy IDctLenhNhapKhoHangNhapKhauChiTiet từ danh sách số vận đơn hợp lệ.";
            return;
        }

        var houseBill = Uri.EscapeDataString(HouseBill.Trim());
        var soCont = Uri.EscapeDataString(soContValue);
        var soVanDon = Uri.EscapeDataString(soVanDonValue);
        var soToKhai = Uri.EscapeDataString(soToKhaiValue);
        var idCt = Uri.EscapeDataString(idCtLenhNhapKhoHangNhapKhauChiTiet.Value.ToString(CultureInfo.InvariantCulture));
        var checksumPayload = BuildOrderLinkChecksumPayload(
            HouseBill.Trim(),
            soContValue,
            soVanDonValue,
            soToKhaiValue,
            idCtLenhNhapKhoHangNhapKhauChiTiet.Value);
        var hashResult = EverlinkChecksumHelper.CreateHash(checksumPayload);

        NavigationManager.NavigateTo($"/user/orders/new?houseBill={houseBill}&soCont={soCont}&soVanDon={soVanDon}&soToKhai={soToKhai}&idCtLenhNhapKhoHangNhapKhauChiTiet={idCt}&t={hashResult.t}&checksum={Uri.EscapeDataString(hashResult.hash)}");
    }

    private static string BuildOrderLinkChecksumPayload(
        string houseBill,
        string soCont,
        string soVanDon,
        string soToKhai,
        long idCtLenhNhapKhoHangNhapKhauChiTiet)
        => string.Join("|",
            NormalizeChecksumValue(houseBill),
            NormalizeChecksumValue(soCont),
            NormalizeChecksumValue(soVanDon),
            NormalizeChecksumValue(soToKhai),
            idCtLenhNhapKhoHangNhapKhauChiTiet.ToString(CultureInfo.InvariantCulture));

    private static string NormalizeChecksumValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? string.Empty : value.Trim();

    private async Task<long?> ResolveIdCtLenhNhapKhoHangNhapKhauChiTietAsync(string? soVanDon)
    {
        if (CurrentUserId <= 0)
        {
            return null;
        }

        var normalizedSoVanDon = soVanDon?.Trim();
        if (string.IsNullOrWhiteSpace(normalizedSoVanDon))
        {
            return null;
        }

        try
        {
            var result = await OnlineOrderService.GetLenhXuatKhoHangNhapKhauTempListAsync(CurrentUserId, normalizedSoVanDon);
            return result.Data.FirstOrDefault()?.ID;
        }
        catch
        {
            return null;
        }
    }

    private string GetResultSummary()
    {
        var houseBill = string.IsNullOrWhiteSpace(HouseBill) ? "-" : HouseBill;
        var declarationNumber = string.IsNullOrWhiteSpace(DeclarationNumber) ? "-" : DeclarationNumber;
        var declarationDate = DeclarationDate.HasValue
            ? DeclarationDate.Value.ToString("dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"))
            : "-";
        var customsCode = string.IsNullOrWhiteSpace(CustomsCode) ? "-" : CustomsCode;
        return $"House Bill: {houseBill} | Số tờ khai: {declarationNumber} | Ngày tờ khai: {declarationDate} | Mã số hải quan: {customsCode}";
    }

    private static string GetThongQuanClass(ThongQuanCheckResponse? result)
        => result switch
        {
            null => "neutral",
            { Success: true, IsThongQuan: true } => "success",
            { Success: true, IsThongQuan: false } => "warning",
            _ => "danger"
        };

    private static string GetThongQuanLabel(ThongQuanCheckResponse? result)
        => result switch
        {
            null => "Chưa tra cứu",
            { Success: true, IsThongQuan: true } => "Đã thông quan",
            { Success: true, IsThongQuan: false } => "Chưa thông quan",
            _ => "Lỗi! Vui lòng kiểm tra thông tin lỗi trả về từ Hệ thống của Hải Quan"
        };

    private string GetThongQuanMessage()
    {
        if (ThongQuanResult is null)
        {
            return "Chưa có dữ liệu tình trạng thông quan.";
        }

        return string.IsNullOrWhiteSpace(ThongQuanResult.Message)
            ? "Đã lấy thành công thông tin tình trạng thông quan."
            : ThongQuanResult.Message;
    }

    private static string GetChiTietClass(ChiTietHouseBillData? detail)
        => detail is null ? "neutral" : (detail.IsHoanThanh ? "success" : "warning");

    private static string GetChiTietLabel(ChiTietHouseBillData? detail)
        => detail is null ? "Kết nối tới hệ thống Hải Quan bị lỗi, Vui lòng thử lại sau 10 giây" : (detail.IsHoanThanh ? "Đã hoàn thành" : "Chưa hoàn thành");

    private string GetChiTietMessage()
    {
        if (ChiTietResult is null)
        {
            return "Hiện tại hệ thống chưa có dữ liệu chi tiết của House Bill này. Quý khách vui lòng kiểm tra lại sau!";
        }

        if (!string.IsNullOrWhiteSpace(ChiTietResult.Message))
        {
            return ChiTietResult.Message;
        }

        return ChiTietResult.ParsedData is null
            ? "Không lấy được thông tin Housebuild! Vui lòng thử lại."
            : "Tải dữ liệu House Bill thành công.";
    }

    private static List<ImportCheckRecord> BuildSummaryRows(
        ThongQuanCheckResponse? thongQuan,
        ChiTietHouseBillData? detail,
        string houseBill,
        string declarationNumber)
    {
        if (detail is null)
        {
            return [];
        }

        return
        [
            new ImportCheckRecord
            {
                ReceivedDate = detail.NgayNhapKho ?? detail.NgayTauDen ?? DateTime.Today,
                MasterBill = detail.MasterBill,
                HouseBill = detail.SoHouseBill,
                Quantity = detail.SoKien,
                Volume = detail.SoKhoi,
                Weight = detail.TrongLuong,
                ContainerNumber = detail.SoCont,
                Forwarder = detail.Forwarder,
                Status = thongQuan is not null
                    ? (thongQuan.Success ? (thongQuan.IsThongQuan ? "Đã thông quan" : "Chưa thông quan") : "Lỗi tra cứu")
                    : (detail.IsHoanThanh ? "Đã hoàn thành" : "Chưa hoàn thành"),
                CustomsDeclaration = string.IsNullOrWhiteSpace(detail.EDO)
                    ? (string.IsNullOrWhiteSpace(declarationNumber) ? houseBill : declarationNumber)
                    : detail.EDO
            }
        ];
    }

