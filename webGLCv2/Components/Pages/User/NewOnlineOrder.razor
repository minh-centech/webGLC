@page "/user/orders/new"
@rendermode InteractiveServer
@attribute [Authorize]
@inject OnlineOrderService OnlineOrderService
@inject LegacyCustomerPortalService LegacyCustomerPortalService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components
@using System.Security.Claims
@using System.Globalization

<PageTitle>Thêm lệnh online</PageTitle>

<section class="page-shell">
    <header class="page-header">
        <div>
            <p class="page-kicker">User Workspace</p>
            <h1>Thêm mới lệnh online</h1>
            <p class="page-subtitle">Khách hàng nhập đầy đủ thông tin để tạo lệnh online</p>
        </div>
        <button class="portal-secondary-action" @onclick="@(() => NavigationManager.NavigateTo("/user/orders"))">Quay lại danh sách</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(InfoMessage))
    {
        <div class="portal-toast @(InfoIsError ? "portal-toast-error" : "portal-toast-success")"
             role="@(InfoIsError ? "alert" : "status")"
             aria-live="@(InfoIsError ? "assertive" : "polite")">
            <div class="portal-toast-icon" aria-hidden="true">@(InfoIsError ? "!" : "✓")</div>
            <div class="portal-toast-body">@InfoMessage</div>
        </div>
    }

    <EditForm EditContext="@EditContext" OnValidSubmit="HandleSubmitAsync" FormName="new-online-order-form">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-grid">
            <section class="workspace-card">
                <div class="field-grid">
                    <div>
                        <label class="portal-label">Họ và tên</label>
                        <InputText class="portal-input" @bind-Value="Draft.CustomerName" />
                        <ValidationMessage For="@(() => Draft.CustomerName)" class="validation-message" />
                    </div>
                    <div>
                        <label class="portal-label">Số điện thoại</label>
                        <InputText class="portal-input" @bind-Value="Draft.PhoneNumber" />
                        <ValidationMessage For="@(() => Draft.PhoneNumber)" class="validation-message" />
                    </div>
                    <div>
                        <label class="portal-label">Số CMND</label>
                        <InputText class="portal-input" @bind-Value="Draft.IdentityNumber" />
                        <ValidationMessage For="@(() => Draft.IdentityNumber)" class="validation-message" />
                    </div>
                    <div>
                        <label class="portal-label">Số xe</label>
                        <InputText class="portal-input" @bind-Value="Draft.VehicleNumber" />
                        <ValidationMessage For="@(() => Draft.VehicleNumber)" class="validation-message" />
                    </div>

                    <div>
                        <label class="portal-label">Mã số thuế</label>
                        @if (IsEnterprise)
                        {
                            <select class="portal-input" value="@SelectedTaxCode" @onchange="OnTaxCodeSelectionChanged">
                                <option value="">Chọn mã số thuế theo tài khoản</option>
                                @foreach (var company in CustomerCompanies)
                                {
                                    <option value="@company.MaSoThue">@company.MaSoThue</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="input-action-row">
                                <input class="portal-input input-action-field tax-code-trigger"
                                       value="@Draft.TaxCode"
                                       readonly
                                       placeholder="Nhập mã số thuế"
                                       @onclick="OpenTaxLookupPopup"
                                       @onfocus="OpenTaxLookupPopup" />
                                <button type="button" class="portal-secondary-action" @onclick="OpenTaxLookupPopup">Tra cứu MST</button>
                            </div>
                        }
                        <ValidationMessage For="@(() => Draft.TaxCode)" class="validation-message" />
                    </div>
                    <div>
                        <label class="portal-label">Tên công ty</label>
                        <InputText class="portal-input" @bind-Value="Draft.CompanyName" readonly />
                    </div>
                    <div class="field-span-3">
                        <label class="portal-label">Địa chỉ</label>
                        <InputText class="portal-input" @bind-Value="Draft.CompanyAddress" readonly />
                    </div>
                    <div>
                        <label class="portal-label">Email</label>
                        <InputText class="portal-input" @bind-Value="Draft.CompanyEmail" readonly />
                    </div>

                    <div>
                        <label class="portal-label">House Bill</label>
                        <InputText class="portal-input" @bind-Value="Draft.HouseBill" />
                        <ValidationMessage For="@(() => Draft.HouseBill)" class="validation-message" />
                    </div>
                    <div>
                        <label class="portal-label">Ngày làm lệnh</label>
                        <input class="portal-input" value="@Draft.OrderDate.ToString("dd/MM/yyyy")" readonly />
                    </div>
                    <div>
                        <label class="portal-label">Số Cont</label>
                        <InputText disabled class="portal-input" @bind-Value="Draft.ContainerNumber" />
                        <ValidationMessage For="@(() => Draft.ContainerNumber)" class="validation-message" />
                    </div>
                    @* <div>
                        <label class="portal-label">Ngày dự kiến lấy hàng</label>
                        <input id="pickupDateInput" class="portal-input" value="@PickupDateText" @oninput="OnPickupDateInput" @onchange="OnPickupDateInput" placeholder="dd/MM/yyyy" />
                        <ValidationMessage For="@(() => Draft.PickupDate)" class="validation-message" />
                    </div> *@
                    <div>
                        <label class="portal-label">Số tờ khai</label>
                        <InputText disabled class="portal-input" @bind-Value="Draft.DeclarationNumber" />
                    </div>
                </div>
                <div class="form-actions new-order-form-actions" style="margin-top:20px">
                    <button type="submit" class="portal-primary-action">Lưu lệnh</button>
                    <button type="button" class="portal-secondary-action" @onclick="ResetForm">Thiết lập lại thông tin</button>
                </div>
            </section>
            
        </div>

       
    </EditForm>
</section>

@if (IsTaxLookupPopupOpen)
{
    <div class="portal-modal-backdrop" @onclick="CloseTaxLookupPopup">
        <div class="portal-modal" @onclick:stopPropagation="true" style="max-width:760px; width:min(100%, 760px);">
            <h3>Tra cứu mã số thuế</h3>
            <p>Nhập mã số thuế, bấm tìm kiếm và hệ thống sẽ tự động điền thông tin doanh nghiệp.</p>

            <div class="field-grid">
                <div class="field-card wide">
                    <label class="portal-label">Mã số thuế</label>
                    <div class="input-action-row" style="align-items:flex-end;">
                        <div class="input-action-row input-action-field" style="gap:8px; align-items:flex-end;">
                            <input class="portal-input input-action-field" @bind="TaxLookupInput" @bind:event="oninput" placeholder="Nhập mã số thuế" />
                            
                        </div>
                        <button type="button" class="portal-primary-action" disabled="@TaxLookupIsBusy" @onclick="SearchTaxLookupAsync">Tra cứu</button>
                        <button type="button" class="portal-secondary-action lookup-clear-action" disabled="@TaxLookupIsBusy" @onclick="ClearTaxLookupAsync" title="Xóa thông tin" aria-label="Xóa mã số thuế">Xóa mã số thuế</button>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(TaxLookupMessage))
            {
                <div class="portal-alert @(TaxLookupIsError ? "portal-alert-error" : TaxLookupIsWarning ? "portal-alert-warning" : "portal-alert-success")" style="margin-top:12px;">@TaxLookupMessage</div>
            }

            @if (TaxLookupResult.Count > 0)
            {
                <div class="table-shell" style="margin-top:16px; max-height:360px; overflow:auto;">
                    <table class="portal-table dense">
                        <tbody>
                            @foreach (var item in TaxLookupResult)
                            {
                                <tr>
                                    <td style="width:220px;">@item.Key</td>
                                    <td>@item.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="portal-modal-actions tax-lookup-actions" style="justify-content:flex-end; gap:12px; margin-top:16px;">
                @if (TaxLookupResult.Count > 0)
                {
                    <button type="button" class="portal-primary-action" @onclick="ApplyTaxLookupResultAsync" disabled="@TaxLookupIsBusy">Dùng dữ liệu này</button>
                }
                <button type="button" class="portal-secondary-action" @onclick="CloseTaxLookupPopup">Đóng</button>
            </div>
        </div>
    </div>
}

@code {
    private OnlineOrderDraft Draft { get; set; } = new();
    private EditContext EditContext { get; set; } = default!;
    private ValidationMessageStore ValidationMessages { get; set; } = default!;
    private string CurrentUserEmail { get; set; } = string.Empty;
    private long CurrentUserId { get; set; }
    private int CurrentUserAccountType { get; set; }
    private readonly List<LegacyCompanyProfile> CustomerCompanies = new();
    private string SelectedTaxCode { get; set; } = string.Empty;
    private string? InfoMessage { get; set; }
    private bool InfoIsError { get; set; }
    private string PickupDateText { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "houseBill")]
    private string? HouseBillFromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "soCont")]
    private string? SoContFromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "soVanDon")]
    private string? SoVanDonFromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "soToKhai")]
    private string? SoToKhaiFromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "idCtLenhNhapKhoHangNhapKhauChiTiet")]
    private string? IdCtLenhNhapKhoHangNhapKhauChiTietFromQuery { get; set; }
    private bool AppliedQueryDefaults { get; set; }
    private bool IsTaxLookupPopupOpen { get; set; }
    private bool TaxLookupIsBusy { get; set; }
    private bool TaxLookupIsError { get; set; }
    private bool TaxLookupIsWarning { get; set; }
    private string TaxLookupInput { get; set; } = string.Empty;
    private string? TaxLookupMessage { get; set; }
    private List<TaxLookupRow> TaxLookupResult { get; set; } = new();
    private bool IsEnterprise => CurrentUserAccountType == 2;

    protected override async Task OnInitializedAsync()
    {
        Draft.OrderDate = DateTime.Today;
        PickupDateText = string.Empty;
        InitializeEditContext();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUserEmail = authState.User.FindFirstValue(ClaimTypes.Email) ?? authState.User.Identity?.Name ?? string.Empty;
        CurrentUserId = long.TryParse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), out var parsedId) ? parsedId : 0;
        CurrentUserAccountType = int.TryParse(authState.User.FindFirstValue("account_type"), out var accountType) ? accountType : 1;
        await LoadCustomerCompaniesAsync();
        EnsureCompanyEmailFallback();
    }

    protected override Task OnParametersSetAsync()
    {
        if (AppliedQueryDefaults)
        {
            return Task.CompletedTask;
        }

        ApplyQueryDefaultsToDraft(markApplied: true);

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await JS.InvokeVoidAsync("orderDatePicker.initPickupDatePicker", "pickupDateInput");
    }

    private async Task HandleSubmitAsync()
    {
        if (CurrentUserId <= 0)
        {
            InfoMessage = "Khong xac dinh duoc tai khoan dang nhap.";
            InfoIsError = true;
            return;
        }

        Draft.OrderDate = DateTime.Today;
        SyncPickupDateFromText();

        if (Draft.PickupDate.HasValue && Draft.PickupDate.Value.Date < DateTime.Today)
        {
            InfoMessage = "Ngay lay hang phai tu ngay hien tai tro di.";
            InfoIsError = true;
            return;
        }

        var normalizedHouseBill = Draft.HouseBill?.Trim();
        var normalizedSoVanDon = SoVanDonFromQuery?.Trim();
        if (!Draft.IDctLenhNhapKhoHangNhapKhauChiTiet.HasValue || Draft.IDctLenhNhapKhoHangNhapKhauChiTiet.Value <= 0)
        {
            Draft.IDctLenhNhapKhoHangNhapKhauChiTiet = await ResolveIdCtLenhNhapKhoHangNhapKhauChiTietAsync(normalizedSoVanDon ?? normalizedHouseBill);
        }

        if (!Draft.IDctLenhNhapKhoHangNhapKhauChiTiet.HasValue || Draft.IDctLenhNhapKhoHangNhapKhauChiTiet.Value <= 0)
        {
            InfoMessage = "Khong tim thay IDctLenhNhapKhoHangNhapKhauChiTiet de luu lenh.";
            InfoIsError = true;
            return;
        }

        if (!string.IsNullOrWhiteSpace(normalizedHouseBill))
        {
            var existingOrders = await OnlineOrderService.GetOrdersAsync(
                CurrentUserId,
                houseBill: normalizedHouseBill,
                page: 1,
                pageSize: 1);

            if (existingOrders.Items.Any(order =>
                    string.Equals(order.HouseBill?.Trim(), normalizedHouseBill, StringComparison.OrdinalIgnoreCase)))
            {
                SetHouseBillValidationError($"House Bill {normalizedHouseBill} da ton tai. Vui long kiem tra lai truoc khi luu.");
                return;
            }
        }

        try
        {
            ClearHouseBillValidationError();
            var newOrderId = await OnlineOrderService.AddOrderAsync(CurrentUserId, Draft);
            NavigationManager.NavigateTo($"/user/orders/{newOrderId}", forceLoad: false);
        }
        catch (Exception ex)
        {
            InfoMessage = ex.Message;
            InfoIsError = true;
        }
    }

    private async Task LookupCompanyAsync()
    {
        var result = await OnlineOrderService.LookupCompanyAsync(Draft.TaxCode, CurrentUserEmail);
        InfoMessage = result.Message;
        InfoIsError = !result.Success;

        if (result.Success)
        {
            Draft.CompanyName = result.CompanyName;
            Draft.CompanyAddress = result.CompanyAddress;
        }
    }

    private async Task OpenTaxLookupPopup()
    {
        TaxLookupInput = Draft.TaxCode;
        TaxLookupMessage = null;
        TaxLookupIsError = false;
        TaxLookupIsWarning = false;
        TaxLookupResult.Clear();
        IsTaxLookupPopupOpen = true;

        if (!string.IsNullOrWhiteSpace(TaxLookupInput))
        {
            await SearchTaxLookupAsync();
        }
        else
        {
            TaxLookupMessage = "Vui lòng nhập mã số thuế trước khi tra cứu.";
            TaxLookupIsError = true;
            TaxLookupIsWarning = false;
        }
    }

    private async Task CloseTaxLookupPopup()
    {
        IsTaxLookupPopupOpen = false;
        TaxLookupIsBusy = false;
        TaxLookupMessage = null;
        TaxLookupIsError = false;
        TaxLookupIsWarning = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SearchTaxLookupAsync()
    {
        TaxLookupMessage = null;
        TaxLookupIsError = false;
        TaxLookupIsWarning = false;
        TaxLookupResult.Clear();

        var taxCode = TaxLookupInput.Trim();
        if (string.IsNullOrWhiteSpace(taxCode))
        {
            TaxLookupMessage = "Vui lòng nhập mã số thuế.";
            TaxLookupIsError = true;
            TaxLookupIsWarning = false;
            return;
        }

        TaxLookupIsBusy = true;
        try
        {
            var result = await OnlineOrderService.LookupCompanyByMaSoThueAsync(taxCode);
            if (result is null)
            {
                TaxLookupMessage = "Không tìm thấy dữ liệu phù hợp cho mã số thuế này.";
                TaxLookupIsError = true;
                TaxLookupIsWarning = false;
                return;
            }

            TaxLookupResult.Add(new TaxLookupRow("Mã số thuế", result.MaSoThue, result.CreateDate));
            TaxLookupResult.Add(new TaxLookupRow("Tên công ty", result.Ten, result.CreateDate));
            TaxLookupResult.Add(new TaxLookupRow("Địa chỉ", result.DiaChi, result.CreateDate));

            if (!string.IsNullOrWhiteSpace(result.Email))
            {
                TaxLookupResult.Add(new TaxLookupRow("Email", result.Email, result.CreateDate));
            }

            if (!string.IsNullOrWhiteSpace(result.SoDienThoai))
            {
                TaxLookupResult.Add(new TaxLookupRow("Số điện thoại", result.SoDienThoai, result.CreateDate));
            }

            if (!string.IsNullOrWhiteSpace(result.NguoiDaiDien))
            {
                TaxLookupResult.Add(new TaxLookupRow("Người đại diện", result.NguoiDaiDien, result.CreateDate));
            }

            if (!string.IsNullOrWhiteSpace(result.ChucVuNguoiDaiDien))
            {
                TaxLookupResult.Add(new TaxLookupRow("Chức vụ người đại diện", result.ChucVuNguoiDaiDien, result.CreateDate));
            }

            TaxLookupResult.Add(new TaxLookupRow("Ngày cập nhật", FormatVietnameseDate(result.CreateDate), result.CreateDate));

            TaxLookupMessage = "Quan trọng: Vui lòng kiểm tra kỹ thông tin bên dưới vì đây là dữ liệu dùng để xuất hóa đơn điện tử. Nếu có sai sót, xin vui lòng liên hệ với chúng tôi ngay lập tức để cập nhật.!";
            TaxLookupIsWarning = true;
            TaxLookupIsError = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            TaxLookupMessage = ex.Message;
            TaxLookupIsError = true;
            TaxLookupIsWarning = false;
        }
        finally
        {
            TaxLookupIsBusy = false;
        }
    }

    private async Task ClearTaxLookupAsync()
    {
        TaxLookupInput = string.Empty;
        TaxLookupResult.Clear();
        TaxLookupMessage = "Đã xoá dữ liệu tra cứu.";
        TaxLookupIsError = false;
        TaxLookupIsWarning = false;

        SelectedTaxCode = string.Empty;
        Draft.TaxCode = string.Empty;
        Draft.CompanyName = string.Empty;
        Draft.CompanyAddress = string.Empty;
        EnsureCompanyEmailFallback();
        Draft.PhoneNumber = string.Empty;

        EditContext.NotifyFieldChanged(FieldIdentifier.Create(() => Draft.TaxCode));
        EditContext.NotifyFieldChanged(FieldIdentifier.Create(() => Draft.CompanyName));
        EditContext.NotifyFieldChanged(FieldIdentifier.Create(() => Draft.CompanyAddress));
        EditContext.NotifyFieldChanged(FieldIdentifier.Create(() => Draft.CompanyEmail));
        EditContext.NotifyFieldChanged(FieldIdentifier.Create(() => Draft.PhoneNumber));

        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyTaxLookupResultAsync()
    {
        await ApplyTaxLookupResultToDraftAsync();
        await CloseTaxLookupPopup();
        InfoMessage = "Đã tự động điền thông tin doanh nghiệp từ MST. Vui lòng kiểm tra các thông tin trước khi lưu lệnh";
        InfoIsError = false;
        await InvokeAsync(StateHasChanged);
    }

    private Task ApplyTaxLookupResultToDraftAsync()
    {
        var taxCode = GetTaxLookupValue("mã số thuế");
        if (!string.IsNullOrWhiteSpace(taxCode))
        {
            SelectedTaxCode = taxCode;
            Draft.TaxCode = taxCode;
            EditContext.NotifyFieldChanged(FieldIdentifier.Create(() => Draft.TaxCode));
        }

        var companyName = GetTaxLookupValue("tên công ty");
        if (!string.IsNullOrWhiteSpace(companyName))
        {
            Draft.CompanyName = companyName;
            EditContext.NotifyFieldChanged(FieldIdentifier.Create(() => Draft.CompanyName));
        }

        var address = GetTaxLookupValue("địa chỉ");
        if (!string.IsNullOrWhiteSpace(address))
        {
            Draft.CompanyAddress = address;
            EditContext.NotifyFieldChanged(FieldIdentifier.Create(() => Draft.CompanyAddress));
        }

        var email = GetTaxLookupValue("email");
        if (!string.IsNullOrWhiteSpace(email))
        {
            Draft.CompanyEmail = email;
            EditContext.NotifyFieldChanged(FieldIdentifier.Create(() => Draft.CompanyEmail));
        }

        EnsureCompanyEmailFallback();

        var phone = GetTaxLookupValue("số điện thoại");
        if (!string.IsNullOrWhiteSpace(phone))
        {
            Draft.PhoneNumber = phone;
            EditContext.NotifyFieldChanged(FieldIdentifier.Create(() => Draft.PhoneNumber));
        }

        if (IsEnterprise && !string.IsNullOrWhiteSpace(taxCode))
        {
            var selectedCompany = CustomerCompanies.FirstOrDefault(company =>
                string.Equals(company.MaSoThue, taxCode, StringComparison.OrdinalIgnoreCase));

            if (selectedCompany is null)
            {
                CustomerCompanies.Insert(0, new LegacyCompanyProfile
                {
                    MaSoThue = taxCode,
                    TenDoanhNghiep = Draft.CompanyName,
                    DiaChi = Draft.CompanyAddress,
                    EmailDoanhNghiep = Draft.CompanyEmail
                });
            }
        }

        return Task.CompletedTask;
    }

    private string GetTaxLookupValue(string key)
    {
        var normalizedKey = NormalizeKey(key);
        var item = TaxLookupResult.FirstOrDefault(x => string.Equals(NormalizeKey(x.Key), normalizedKey, StringComparison.OrdinalIgnoreCase));
        return item?.Value ?? string.Empty;
    }

    private static string NormalizeKey(string value)
        => value.Trim().ToLowerInvariant().Replace(" ", "_");

    private sealed record TaxLookupRow(string Key, string Value, string UpdateDate);

    private static string FormatVietnameseDate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        return DateTime.TryParse(value, CultureInfo.GetCultureInfo("vi-VN"), DateTimeStyles.None, out var parsed)
            ? parsed.ToString("dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"))
            : value.Trim();
    }

    private async Task LoadCustomerCompaniesAsync()
    {
        CustomerCompanies.Clear();
        SelectedTaxCode = string.Empty;

        if (CurrentUserId <= 0)
        {
            return;
        }

        try
        {
            var companies = await LegacyCustomerPortalService.GetCompaniesByCustomerAsync(CurrentUserId.ToString(CultureInfo.InvariantCulture));
            CustomerCompanies.AddRange(companies.Where(company => !string.IsNullOrWhiteSpace(company.MaSoThue)));

            if (CustomerCompanies.Count == 1)
            {
                SelectCompany(CustomerCompanies[0]);
            }
        }
        catch
        {
            CustomerCompanies.Clear();
        }
    }

    private async Task OnTaxCodeSelectionChanged(ChangeEventArgs args)
    {
        SelectedTaxCode = args.Value?.ToString() ?? string.Empty;
        InfoMessage = null;
        InfoIsError = false;

        if (string.IsNullOrWhiteSpace(SelectedTaxCode))
        {
            Draft.TaxCode = string.Empty;
            Draft.CompanyName = string.Empty;
            Draft.CompanyAddress = string.Empty;
            Draft.CompanyEmail = CurrentUserEmail;
            return;
        }

        Draft.TaxCode = SelectedTaxCode;

        var matchedCompany = CustomerCompanies.FirstOrDefault(company =>
            string.Equals(company.MaSoThue, SelectedTaxCode, StringComparison.OrdinalIgnoreCase));

        if (matchedCompany is not null)
        {
            SelectCompany(matchedCompany);
            return;
        }

        await LookupCompanyAsync();
    }

    private void SelectCompany(LegacyCompanyProfile company)
    {
        SelectedTaxCode = company.MaSoThue;
        Draft.TaxCode = company.MaSoThue;
        Draft.CompanyName = company.TenDoanhNghiep;
        Draft.CompanyAddress = company.DiaChi;
        Draft.CompanyEmail = company.EmailDoanhNghiep;
        EnsureCompanyEmailFallback();
    }

    private void OnPickupDateInput(ChangeEventArgs args)
    {
        PickupDateText = args.Value?.ToString() ?? string.Empty;
        SyncPickupDateFromText();
    }

    private void SyncPickupDateFromText()
    {
        if (DateTime.TryParseExact(PickupDateText, "dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"), DateTimeStyles.None, out var parsedDate))
        {
            Draft.PickupDate = parsedDate;
            return;
        }

        Draft.PickupDate = null;
    }

    private void ResetForm()
    {
        Draft = new OnlineOrderDraft
        {
            OrderDate = DateTime.Today,
        };
        InitializeEditContext();
        ApplyQueryDefaultsToDraft(markApplied: false);
        SelectedTaxCode = string.Empty;
        PickupDateText = string.Empty;
        InfoMessage = null;
        InfoIsError = false;
        EnsureCompanyEmailFallback();
    }

    private void InitializeEditContext()
    {
        EditContext = new EditContext(Draft);
        ValidationMessages = new ValidationMessageStore(EditContext);
        EditContext.OnFieldChanged += HandleFieldChanged;
    }

    private void EnsureCompanyEmailFallback()
    {
        if (string.IsNullOrWhiteSpace(Draft.CompanyEmail))
        {
            Draft.CompanyEmail = CurrentUserEmail;
            EditContext?.NotifyFieldChanged(FieldIdentifier.Create(() => Draft.CompanyEmail));
        }
    }

    private void ApplyQueryDefaultsToDraft(bool markApplied)
    {
        var houseBill = HouseBillFromQuery?.Trim();
        var soCont = SoContFromQuery?.Trim();
        var soVanDon = SoVanDonFromQuery?.Trim();
        var soToKhai = SoToKhaiFromQuery?.Trim();
        var idCtLenhNhapKhoHangNhapKhauChiTiet = IdCtLenhNhapKhoHangNhapKhauChiTietFromQuery?.Trim();

        if (!string.IsNullOrWhiteSpace(houseBill))
        {
            Draft.HouseBill = houseBill;
        }

        if (!string.IsNullOrWhiteSpace(soCont))
        {
            Draft.ContainerNumber = soCont;
        }
        else if (!string.IsNullOrWhiteSpace(soVanDon))
        {
            Draft.ContainerNumber = soVanDon;
        }

        if (!string.IsNullOrWhiteSpace(soToKhai))
        {
            Draft.DeclarationNumber = soToKhai;
        }

        if (long.TryParse(idCtLenhNhapKhoHangNhapKhauChiTiet, out var parsedIdCt) && parsedIdCt > 0)
        {
            Draft.IDctLenhNhapKhoHangNhapKhauChiTiet = parsedIdCt;
        }

        if (markApplied && (
                !string.IsNullOrWhiteSpace(houseBill)
                || !string.IsNullOrWhiteSpace(soCont)
                || !string.IsNullOrWhiteSpace(soVanDon)
                || !string.IsNullOrWhiteSpace(soToKhai)
                || !string.IsNullOrWhiteSpace(idCtLenhNhapKhoHangNhapKhauChiTiet)))
        {
            AppliedQueryDefaults = true;
        }
    }

    private async Task<long?> ResolveIdCtLenhNhapKhoHangNhapKhauChiTietAsync(string? soVanDon)
    {
        if (CurrentUserId <= 0 || string.IsNullOrWhiteSpace(soVanDon))
        {
            return null;
        }

        try
        {
            var result = await OnlineOrderService.GetLenhXuatKhoHangNhapKhauTempListAsync(CurrentUserId, soVanDon.Trim());
            return result.Data.FirstOrDefault()?.ID;
        }
        catch
        {
            return null;
        }
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (e.FieldIdentifier.FieldName != nameof(OnlineOrderDraft.HouseBill))
        {
            return;
        }

        ClearHouseBillValidationError();
    }

    private void SetHouseBillValidationError(string message)
    {
        ValidationMessages.Clear(HouseBillFieldIdentifier);
        ValidationMessages.Add(HouseBillFieldIdentifier, message);
        EditContext.NotifyValidationStateChanged();
        InfoMessage = null;
        InfoIsError = false;
    }

    private void ClearHouseBillValidationError()
    {
        if (ValidationMessages is null || EditContext is null)
        {
            return;
        }

        ValidationMessages.Clear(HouseBillFieldIdentifier);
        EditContext.NotifyValidationStateChanged();
    }

    private FieldIdentifier HouseBillFieldIdentifier
        => FieldIdentifier.Create(() => Draft.HouseBill);
}
