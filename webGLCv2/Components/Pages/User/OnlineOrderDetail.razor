@page "/user/orders/{OrderId:long}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject OnlineOrderService OnlineOrderService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Globalization
@using System.Security.Claims

<PageTitle>Chi tiết lệnh online</PageTitle>

<section class="page-shell">
    <header class="page-header">
        <div>
            <p class="page-kicker">User Workspace</p>
            <h1>Chi tiết lệnh online</h1>
            <p class="page-subtitle">Hãy rà soát thông tin chính xác trước khi truy vấn theo số House Bill (HBL) hoặc số hiệu Container.</p>
        </div>
        <button class="portal-secondary-action no-print" @onclick="@(() => NavigationManager.NavigateTo("/user/orders"))">Quay lai danh sach</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="portal-alert portal-alert-error">@ErrorMessage</div>
    }
    else if (Order is null)
    {
        <div class="portal-empty-inline">Đang tải dữ liệu...</div>
    }
    else
    {
        <section class="workspace-card">
            <div class="section-heading">
                <h2>@Order.OrderCode</h2>
                <p>Trang thai hien tai: <span class="status-chip @GetStatusClass(Order.StatusCode)">@Order.Status</span></p>
            </div>

            <div class="field-grid">
                <div>
                    <label class="portal-label">Họ và tên</label>
                    <input class="portal-input" value="@Order.CustomerName" readonly />
                </div>
                <div>
                    <label class="portal-label">Số điện thoại</label>
                    <input class="portal-input" value="@Order.PhoneNumber" readonly />
                </div>
                <div>
                    <label class="portal-label">Số CMND/CCCD</label>
                    <input class="portal-input" value="@Order.IdentityNumber" readonly />
                </div>
                <div>
                    <label class="portal-label">Biển số xe</label>
                    <input class="portal-input" value="@Order.VehicleNumber" readonly />
                </div>
                <div>
                    <label class="portal-label">Mã số thuế</label>
                    <input class="portal-input" value="@Order.TaxCode" readonly />
                </div>
                <div>
                    <label class="portal-label">Tên công ty</label>
                    <input class="portal-input" value="@Order.CompanyName" readonly />
                </div>
                <div class="field-span-3">
                    <label class="portal-label">Địa chỉ doanh nghiệp</label>
                    <input class="portal-input" value="@Order.CompanyAddress" readonly />
                </div>
                <div>
                    <label class="portal-label">Email liên hệ</label>
                    <input class="portal-input" value="@Order.CompanyEmail" readonly />
                </div>
                <div>
                    <label class="portal-label">Số House Bill</label>
                    <input class="portal-input" value="@Order.HouseBill" readonly />
                </div>
                <div>
                    <label class="portal-label">Ngày làm lệnh</label>
                    <input class="portal-input" value="@(Order.OrderDate.ToString("dd/MM/yyyy HH:mm"))" readonly />
                </div>
                <div>
                    <label class="portal-label">Số hiệu Container</label>
                    <input class="portal-input" value="@Order.ContainerNumber" readonly />
                </div>
                <div>
                    <label class="portal-label">Ngày dự kiến lấy hàng</label>
                    <input class="portal-input" value="@(Order.PickupDate?.ToString("dd/MM/yyyy") ?? string.Empty)" readonly />
                </div>
                <div>
                    <label class="portal-label">Số tờ khai hải quan</label>
                    <input class="portal-input" value="@Order.DeclarationNumber" readonly />
                </div>
            </div>

            <div class="form-actions no-print">
                <button class="portal-primary-action" @onclick='() => RunWorkflowAsync("button")' disabled="@IsLoadingWorkflow">
                    @(IsLoadingWorkflow ? "Đang truy vấn..." : "Truy vấn thông tin")
                </button>
               @*  <button class="portal-secondary-action" @onclick="Query">Tra cứu import check</button> *@
            </div>

            @if (!string.IsNullOrWhiteSpace(WorkflowMessage))
            {
                <div class="portal-alert portal-alert-success" style="margin-top:12px;">@WorkflowMessage</div>
            }

            @if (Workflow is not null)
            {
                <section class="workflow-grid">
                    <article class="workflow-card">
                        <div class="section-heading">
                            <h2>1. Kiểm tra thông quan</h2>
                            <span class="status-chip @GetThongQuanClass(Workflow.ThongQuan)">@GetThongQuanLabel(Workflow.ThongQuan)</span>
                        </div>
                        <p class="workflow-message">@GetWorkflowMessage(Workflow.ThongQuan)</p>
                    </article>

                    <article class="workflow-card">
                        <div class="section-heading">
                            <h2>2. Phí lưu kho</h2>
                            <span class="status-chip @(HasPhiLuuKho ? "success" : "neutral")">@(HasPhiLuuKho ? "Đã lấy dữ liệu" : "Chưa có dữ liệu")</span>
                        </div>

                        @if (HasPhiLuuKho)
                        {
                            <div class="workflow-payment-row">
                                <span class="status-chip @GetPaymentStatusClass(Workflow.PhiLuuKho!.Data!.TrangThaiThanhToan)">
                                    @GetPaymentStatusLabel(Workflow.PhiLuuKho!.Data!.TrangThaiThanhToan)
                                </span>

                                @* @if (Workflow.PhiLuuKho!.Data!.TrangThaiThanhToan == 0)
                                {
                                    <button class="portal-primary-action" type="button" @onclick="ShowPaymentPopupAsync">
                                        Thanh toán
                                    </button>
                                } *@
                            </div>

                            

                            <div class="table-shell compact-table">
                                <table class="portal-table">
                                    <thead>
                                        <tr>
                                            <th>Mô tả</th>
                                            <th>Đơn vị tính</th>
                                            <th class="text-start">Số lượng</th>
                                            <th class="text-start">Đơn giá</th>
                                            <th class="text-start">Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Workflow.PhiLuuKho!.Data!.ChiTietHoaDon)
                                        {
                                            <tr>
                                                <td>@item.MoTa</td>
                                                <td>@item.DonViTinh</td>
                                                <td class="text-start">@FormatNumber(item.SoLuong)</td>
                                                <td class="text-start">@FormatMoney(item.DonGia)</td>
                                                <td class="text-start">@FormatMoney(item.ThanhTien)</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td><strong>Tạm tính</strong></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td class="text-start">@FormatMoney(GetPhiSubtotal(Workflow.PhiLuuKho!))</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Phí VAT (@FormatVatPercent(Workflow.PhiLuuKho!.Data!.Vat))</strong></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td class="text-start">@FormatMoney(GetPhiVatAmount(Workflow.PhiLuuKho!))</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Cộng phí + VAT</strong></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td class="text-start"><strong>@FormatMoney(GetPhiGrandTotal(Workflow.PhiLuuKho!))</strong></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            @if (Workflow.PhiLuuKho!.Data!.TrangThaiThanhToan == 0)
                            {
                                <div class="payment-warning-row">
                                    <div class="portal-alert portal-alert-warning payment-warning">
                                        <span class="payment-warning-icon" aria-hidden="true">!</span>
                                        <span>Vui lòng thanh toán qua QR bằng nút Thanh toán để lấy phiếu giao hàng.</span>
                                    </div>
                                    <button class="portal-primary-action payment-warning-action" type="button" @onclick="ShowPaymentPopupAsync">
                                        Thanh toán
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="workflow-message">@GetPhiLuuKhoMessage(Workflow)</p>
                        }
                    </article>

                    @if (IsOverdueOrder)
                    {
                        <article class="workflow-card workflow-card-overdue">
                            <div class="section-heading">
                                <h2>2b. Phí lưu kho quá hạn</h2>
                                <span class="status-chip @(HasPhiLuuKhoQuaHan ? "warning" : "neutral")">@(HasPhiLuuKhoQuaHan ? "Đã lấy dữ liệu" : "Chưa có dữ liệu")</span>
                            </div>

                            @if (HasPhiLuuKhoQuaHan)
                            {
                                <div class="workflow-payment-row">
                                    <span class="status-chip @GetPaymentStatusClass(Workflow.PhiLuuKhoQuaHan!.Data!.TrangThaiThanhToan)">
                                        @GetPaymentStatusLabel(Workflow.PhiLuuKhoQuaHan!.Data!.TrangThaiThanhToan)
                                    </span>
                                </div>

                                @if (false && Workflow.PhiLuuKhoQuaHan!.Data!.TrangThaiThanhToan == 0)
                                {
                                    <div class="payment-warning-row">
                                        <div class="portal-alert portal-alert-danger payment-warning">
                                            <span class="payment-warning-icon" aria-hidden="true">!</span>
                                            <span>Vui lòng thanh toán qua QR bằng nút Thanh toán để lấy phiếu giao hàng.</span>
                                        </div>
                                        <button class="portal-primary-action payment-warning-action" type="button" @onclick="ShowPaymentPopupAsync">
                                            Thanh toán
                                        </button>
                                    </div>
                                }

                                <div class="table-shell compact-table">
                                    <table class="portal-table">
                                        <thead>
                                            <tr>
                                                <th>Mô tả</th>
                                                <th>Đơn vị tính</th>
                                                <th class="text-start">Số lượng</th>
                                                <th class="text-start">Đơn giá</th>
                                                <th class="text-start">Thành tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Workflow.PhiLuuKhoQuaHan!.Data!.ChiTietHoaDon)
                                            {
                                                <tr>
                                                    <td>@item.MoTa</td>
                                                    <td>@item.DonViTinh</td>
                                                    <td class="text-start">@FormatNumber(item.SoLuong)</td>
                                                    <td class="text-start">@FormatMoney(item.DonGia)</td>
                                                    <td class="text-start">@FormatMoney(item.ThanhTien)</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td><strong>Tạm tính</strong></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td class="text-start">@FormatMoney(GetPhiSubtotal(Workflow.PhiLuuKhoQuaHan!))</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Phí VAT (@FormatVatPercent(Workflow.PhiLuuKhoQuaHan!.Data!.Vat))</strong></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td class="text-start">@FormatMoney(GetPhiVatAmount(Workflow.PhiLuuKhoQuaHan!))</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Cộng phí + VAT</strong></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td class="text-start"><strong>@FormatMoney(GetPhiGrandTotal(Workflow.PhiLuuKhoQuaHan!))</strong></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>

                                @if (Workflow.PhiLuuKhoQuaHan!.Data!.TrangThaiThanhToan == 0)
                                {
                                    <div class="payment-warning-row">
                                        <div class="portal-alert portal-alert-warning payment-warning">
                                            <span class="payment-warning-icon" aria-hidden="true">!</span>
                                            <span>Vui lòng thanh toán qua QR bằng nút Thanh toán để lấy phiếu giao hàng.</span>
                                        </div>
                                        <button class="portal-primary-action payment-warning-action" type="button" @onclick="ShowPaymentPopupAsync">
                                            Thanh toán
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="workflow-message">@GetPhiLuuKhoQuaHanMessage(Workflow)</p>
                            }
                        </article>
                    }

                    <article class="workflow-card workflow-card-wide">
                        <div class="section-heading">
                            <h2>3. Thông tin truy vấn</h2>
                            <span class="status-chip @(HasChiTietHouseBill ? "success" : "neutral")">@(HasChiTietHouseBill ? "Đã lấy dữ liệu" : "Chưa có dữ liệu")</span>
                        </div>

                        @if (HasChiTietHouseBill)
                        {
                            <div class="workflow-payment-row" style="margin-bottom:12px;">
                                <span class="status-chip @GetChiTietHouseBillStatusClass(Workflow.ChiTietHouseBill!.Data!.IsHoanThanh)">
                                    @GetChiTietHouseBillStatusLabel(Workflow.ChiTietHouseBill!.Data!.IsHoanThanh)
                                </span>
                                <span class="workflow-message" style="margin:0;">
                                    Trạng thái lấy trực tiếp từ API <strong>/ChiTietHouseBill</strong>.
                                </span>
                            </div>

                            <div class="field-grid compact-fields">
                                <div>
                                    <label class="portal-label">Thủ kho</label>
                                    <input class="portal-input" value="@Workflow.ChiTietHouseBill!.Data!.ThuKho" readonly />
                                </div>
                                <div>
                                    <label class="portal-label">Chủ hàng</label>
                                    <input class="portal-input" value="@Workflow.ChiTietHouseBill!.Data!.ChuHang" readonly />
                                </div>
                                <div>
                                    <label class="portal-label">Số House Bill</label>
                                    <input class="portal-input" value="@Workflow.ChiTietHouseBill!.Data!.SoHouseBill" readonly />
                                </div>
                                <div>
                                    <label class="portal-label">Số Cont</label>
                                    <input class="portal-input" value="@Workflow.ChiTietHouseBill!.Data!.SoCont" readonly />
                                </div>
                                <div>
                                    <label class="portal-label">Forwarder</label>
                                    <input class="portal-input" value="@Workflow.ChiTietHouseBill!.Data!.Forwarder" readonly />
                                </div>
                                <div>
                                    <label class="portal-label">Số kiện</label>
                                    <input class="portal-input" value="@Workflow.ChiTietHouseBill!.Data!.SoKien.ToString()" readonly />
                                </div>
                                <div>
                                    <label class="portal-label">Trọng lượng</label>
                                    <input class="portal-input" value="@(Workflow.ChiTietHouseBill!.Data!.TrongLuong.ToString("0.###"))" readonly />
                                </div>
                                <div>
                                    <label class="portal-label">Số khối</label>
                                    <input class="portal-input" value="@(Workflow.ChiTietHouseBill!.Data!.SoKhoi.ToString("0.###"))" readonly />
                                </div>
                                <div>
                                    <label class="portal-label">Tên tàu</label>
                                    <input class="portal-input" value="@Workflow.ChiTietHouseBill!.Data!.TenTau" readonly />
                                </div>
                                <div>
                                    <label class="portal-label">Số chuyến</label>
                                    <input class="portal-input" value="@Workflow.ChiTietHouseBill!.Data!.SoChuyen" readonly />
                                </div>
                                <div>
                                    <label class="portal-label">Ngày tàu cập</label>
                                    <input class="portal-input" value="@Workflow.ChiTietHouseBill!.Data!.NgayTauCap" readonly />
                                </div>
                            </div>
                        }
                    </article>
                </section>

                <div class="workflow-actions no-print">
                    @if (HasInvoiceDownload)
                    {
                        <a class="portal-primary-action" href="@Order!.InvoiceDownloadUrl" target="_blank" rel="noopener noreferrer">
                            Tải hóa đơn
                        </a>
                    }

                    @if (Workflow?.PhiLuuKho?.Data?.TrangThaiThanhToan == 2)
                    {
                        <button class="portal-secondary-action" @onclick="PrintDeliverySlipAsync">In phiếu giao hàng</button>
                    }
                </div>
            }
        </section>
    }
</section>

@if (IsPaymentPopupOpen)
{
    <div class="payment-modal-backdrop" @onclick="ClosePaymentPopupAsync">
        <div class="payment-modal" @onclick:stopPropagation="true">
            <div class="payment-modal-header">
                <div>
                    <p class="page-kicker">Thanh toán</p>
                    <h3>Quét mã QR để thanh toán</h3>
                </div>
                <button type="button" class="payment-modal-close" @onclick="ClosePaymentPopupAsync">×</button>
            </div>

            <div class="payment-modal-body">
                @if (IsLoadingPaymentInfo)
                {
                    <div class="portal-empty-inline">Đang lấy thông tin thanh toán...</div>
                }
                else if (!string.IsNullOrWhiteSpace(PaymentPopupMessage))
                {
                    <div class="portal-alert portal-alert-error">@PaymentPopupMessage</div>
                }
                else if (PaymentInfo?.Data is not null)
                {
                    <div class="payment-modal-grid">
                        <div class="payment-qr-card">
                            <img class="payment-qr-image" src="@GetQrCodeDataUrl(PaymentInfo.Data.QrCodeBase64)" alt="QR thanh toán" />
                            <p class="payment-qr-caption">Mở app ngân hàng và quét mã QR này.</p>
                        </div>

                        <div class="payment-details">
                            <div class="payment-detail-row">
                                <span>Số tiền</span>
                                <strong>@FormatMoney(PaymentInfo.Data.SoTien)</strong>
                            </div>
                            <div class="payment-detail-row">
                                <span>Số tài khoản</span>
                                <strong>@PaymentInfo.Data.SoTaiKhoan</strong>
                            </div>
                            <div class="payment-detail-row">
                                <span>Tên tài khoản</span>
                                <strong>@PaymentInfo.Data.TenTaiKhoan</strong>
                            </div>
                            <div class="payment-detail-row">
                                <span>Ngân hàng</span>
                                <strong>@PaymentInfo.Data.TenNganHang</strong>
                            </div>
                            <div class="payment-detail-row">
                                <span>Mã thanh toán</span>
                                <strong>@PaymentInfo.Data.IdPayment</strong>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="portal-alert portal-alert-error">Không có dữ liệu thanh toán.</div>
                }
            </div>

            <div class="payment-modal-footer">
                <button type="button" class="portal-secondary-action" @onclick="ClosePaymentPopupAsync">Đóng</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public long OrderId { get; set; }

    private long CurrentUserId;
    private OnlineOrderRecord? Order;
    private OnlineOrderWorkflowResult? Workflow;
    private bool IsLoadingWorkflow;
    private string? WorkflowMessage;
    private string? ErrorMessage;
    private bool IsPaymentPopupOpen;
    private bool IsLoadingPaymentInfo;
    private ThongTinThanhToanResponse? PaymentInfo;
    private string? PaymentPopupMessage;
    private int WorkflowRunSequence;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUserId = long.TryParse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), out var parsedId) ? parsedId : 0;

        if (CurrentUserId <= 0)
        {
            ErrorMessage = "Khong xac dinh duoc tai khoan dang nhap.";
            return;
        }

        Order = await OnlineOrderService.GetOrderByIdAsync(CurrentUserId, OrderId);

        if (Order is null)
        {
            ErrorMessage = "Khong tim thay lenh online.";
            return;
        }

        await RunWorkflowAsync("auto-init");
    }

    private void Query()
    {
        if (Order is null)
        {
            return;
        }

        var houseBill = Uri.EscapeDataString(Order.HouseBill ?? string.Empty);
        var containerNumber = Uri.EscapeDataString(Order.ContainerNumber ?? string.Empty);
        NavigationManager.NavigateTo($"/user/import-check?houseBill={houseBill}&containerNumber={containerNumber}");
    }

    private async Task RunWorkflowAsync(string source)
    {
        if (Order is null || IsLoadingWorkflow)
        {
            return;
        }

        WorkflowRunSequence++;
        var traceTag = $"{source}-{WorkflowRunSequence}";
        IsLoadingWorkflow = true;
        WorkflowMessage = null;
        Workflow = null;

        try
        {
            Console.WriteLine($"[{traceTag}] OnlineOrderDetail.RunWorkflowAsync start. OrderId={OrderId}");
            Workflow = await OnlineOrderService.RunOrderWorkflowAsync(
                OrderId,
                Order.HouseBill,
                Order.ContainerNumber,
                Order.PickupDate,
                Order.InvoiceDownloadUrl,
                traceTag);

            if (Workflow.ThongQuan is null)
            {
                WorkflowMessage = "Chưa thể kiểm tra thông quan.";
            }
            else if (Workflow.ThongQuan.Success && Workflow.ThongQuan.IsThongQuan)
            {
                WorkflowMessage = "Lệnh đã thông quan. Hệ thống đã tải phí lưu kho và thông tin truy vấn.";
            }
            else
            {
                WorkflowMessage = string.IsNullOrWhiteSpace(Workflow.ThongQuan.Message)
                    ? "Lệnh chưa thông quan."
                    : Workflow.ThongQuan.Message;
            }
        }
        catch (Exception ex)
        {
            WorkflowMessage = ex.Message;
            Console.WriteLine($"[{traceTag}] OnlineOrderDetail.RunWorkflowAsync error: {ex.Message}");
        }
        finally
        {
            Console.WriteLine($"[{traceTag}] OnlineOrderDetail.RunWorkflowAsync end.");
            IsLoadingWorkflow = false;
        }
    }

    private async Task PrintDeliverySlipAsync()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private static string GetStatusClass(int statusCode)
        => statusCode switch
        {
            5 => "success",
            3 => "success",
            4 => "warning",
            2 => "warning",
            1 => "pending",
            0 => "neutral",
            _ => "neutral"
        };

    private static string GetThongQuanClass(ThongQuanCheckResponse? response)
        => response?.Success == true
            ? response.IsThongQuan ? "success" : "danger"
            : "neutral";

    private static string GetThongQuanLabel(ThongQuanCheckResponse? response)
        => response is null
            ? "Chưa kiểm tra"
            : response.IsThongQuan ? "Đã thông quan" : "Chưa thông quan";

    private static string GetWorkflowMessage(ThongQuanCheckResponse? response)
        => response?.Message ?? "Chưa có phản hồi từ hệ thống.";

    private static string GetPaymentStatusClass(int trangThaiThanhToan)
        => trangThaiThanhToan switch
        {
            0 => "warning",
            1 => "pending",
            2 => "success",
            _ => "neutral"
        };

    private static string GetPaymentStatusLabel(int trangThaiThanhToan)
        => trangThaiThanhToan switch
        {
            0 => "Chưa thanh toán",
            1 => "Đang chờ xác nhận",
            2 => "Thanh toán thành công",
            _ => "Không xác định"
        };

    private static string GetChiTietHouseBillStatusClass(bool isHoanThanh)
        => isHoanThanh ? "success" : "warning";

    private static string GetChiTietHouseBillStatusLabel(bool isHoanThanh)
        => isHoanThanh ? "Đã hoàn thành" : "Chưa hoàn thành";

    private static string GetPhiLuuKhoMessage(OnlineOrderWorkflowResult? workflow)
    {
        if (workflow?.ThongQuan is null)
        {
            return "Chưa kiểm tra thông quan nên chưa gọi API phí lưu kho.";
        }

        if (!workflow.ThongQuan.Success)
        {
            return string.IsNullOrWhiteSpace(workflow.ThongQuan.Message)
                ? "Không thể kiểm tra thông quan nên chưa lấy được phí lưu kho."
                : workflow.ThongQuan.Message;
        }

        if (!workflow.ThongQuan.IsThongQuan)
        {
            return "Lệnh chưa thông quan nên hệ thống chưa gọi API phí lưu kho.";
        }

        if (workflow.PhiLuuKho is null)
        {
            return "Lệnh đã thông quan nhưng chưa nhận được dữ liệu phí lưu kho.";
        }

        if (!workflow.PhiLuuKho.Success)
        {
            return string.IsNullOrWhiteSpace(workflow.PhiLuuKho.Message)
                ? "Không lấy được dữ liệu phí lưu kho."
                : workflow.PhiLuuKho.Message;
        }

        return "Chưa có dữ liệu phí lưu kho.";
    }

    private bool HasPhiLuuKho
        => Workflow?.ThongQuan?.IsThongQuan == true
           && Workflow?.PhiLuuKho?.Success == true
           && Workflow.PhiLuuKho.Data is not null
           && Workflow.PhiLuuKho.Data.ChiTietHoaDon.Count > 0;

    private bool HasChiTietHouseBill
        => Workflow?.ThongQuan?.IsThongQuan == true
           && Workflow?.ChiTietHouseBill?.Success == true
           && Workflow.ChiTietHouseBill.Data is not null;

    private bool IsOverdueOrder
        => Workflow?.ChiTietHouseBill?.Data is not null
           && Workflow.ChiTietHouseBill.Data.IsHoanThanh == true
           && Order?.PickupDate.HasValue == true
           && Order.PickupDate.Value.Date < DateTime.Today
           && Workflow?.ThongQuan?.IsThongQuan == true;

    private bool HasPhiLuuKhoQuaHan
        => Workflow?.PhiLuuKhoQuaHan?.Success == true
           && Workflow.PhiLuuKhoQuaHan.Data is not null
           && Workflow.PhiLuuKhoQuaHan.Data.ChiTietHoaDon.Count > 0;

    private bool HasInvoiceDownload
        => !string.IsNullOrWhiteSpace(Order?.InvoiceDownloadUrl);

    private async Task ShowPaymentPopupAsync()
    {
        if (Order is null)
        {
            return;
        }

        IsPaymentPopupOpen = true;
        IsLoadingPaymentInfo = true;
        PaymentPopupMessage = null;
        PaymentInfo = null;

        try
        {
            PaymentInfo = await OnlineOrderService.GetThongTinThanhToanAsync(Order.HouseBill, Order.ContainerNumber);

            if (PaymentInfo is null || !PaymentInfo.Success || PaymentInfo.Data is null)
            {
                PaymentPopupMessage = string.IsNullOrWhiteSpace(PaymentInfo?.Message)
                    ? "Không lấy được thông tin thanh toán."
                    : PaymentInfo.Message;
            }
        }
        catch (Exception ex)
        {
            PaymentPopupMessage = ex.Message;
        }
        finally
        {
            IsLoadingPaymentInfo = false;
            StateHasChanged();
        }
    }

    private Task ClosePaymentPopupAsync()
    {
        IsPaymentPopupOpen = false;
        IsLoadingPaymentInfo = false;
        return Task.CompletedTask;
    }

    private static decimal GetPhiTotal(PhiLuuKhoResponse response)
    {
        var data = response.Data;
        if (data is null)
        {
            return 0m;
        }

        return data.ChiTietHoaDon.Sum(item => item.ThanhTien);
    }

    private static decimal GetPhiSubtotal(PhiLuuKhoResponse response)
        => GetPhiTotal(response);

    private static decimal GetPhiVatAmount(PhiLuuKhoResponse response)
    {
        var data = response.Data;
        if (data is null)
        {
            return 0m;
        }

        return GetPhiSubtotal(response) * data.Vat / 100m;
    }

    private static decimal GetPhiGrandTotal(PhiLuuKhoResponse response)
    {
        var data = response.Data;
        if (data is null)
        {
            return 0m;
        }

        return GetPhiSubtotal(response) + GetPhiVatAmount(response);
    }

    private static decimal GetPhiTotal(PhiLuuKhoQuaHanResponse response)
    {
        var data = response.Data;
        if (data is null)
        {
            return 0m;
        }

        return data.ChiTietHoaDon.Sum(item => item.ThanhTien);
    }

    private static decimal GetPhiSubtotal(PhiLuuKhoQuaHanResponse response)
        => GetPhiTotal(response);

    private static decimal GetPhiVatAmount(PhiLuuKhoQuaHanResponse response)
    {
        var data = response.Data;
        if (data is null)
        {
            return 0m;
        }

        return GetPhiSubtotal(response) * data.Vat / 100m;
    }

    private static decimal GetPhiGrandTotal(PhiLuuKhoQuaHanResponse response)
    {
        var data = response.Data;
        if (data is null)
        {
            return 0m;
        }

        return GetPhiSubtotal(response) + GetPhiVatAmount(response);
    }

    private static string GetPhiLuuKhoQuaHanMessage(OnlineOrderWorkflowResult? workflow)
    {
        if (workflow?.ThongQuan is null)
        {
            return "Chưa kiểm tra thông quan nên chưa gọi API phí lưu kho quá hạn.";
        }

        if (!workflow.ThongQuan.Success)
        {
            return string.IsNullOrWhiteSpace(workflow.ThongQuan.Message)
                ? "Không thể kiểm tra thông quan nên chưa lấy được phí lưu kho quá hạn."
                : workflow.ThongQuan.Message;
        }

        if (!workflow.ThongQuan.IsThongQuan)
        {
            return "Lệnh chưa thông quan nên hệ thống chưa gọi API phí lưu kho quá hạn.";
        }

        if (workflow.PhiLuuKhoQuaHan is null)
        {
            return "Lệnh đã quá hạn nhưng chưa nhận được dữ liệu phí lưu kho quá hạn.";
        }

        if (!workflow.PhiLuuKhoQuaHan.Success)
        {
            return string.IsNullOrWhiteSpace(workflow.PhiLuuKhoQuaHan.Message)
                ? "Không lấy được dữ liệu phí lưu kho quá hạn."
                : workflow.PhiLuuKhoQuaHan.Message;
        }

        return "Chưa có dữ liệu phí lưu kho quá hạn.";
    }

    private static string FormatVatPercent(decimal vat)
        => vat.ToString("0.##", CultureInfo.GetCultureInfo("vi-VN")) + "%";

    private static string FormatMoney(decimal amount)
        => string.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} VND", amount);

    private static string FormatNumber(decimal value)
        => value.ToString("0.###", CultureInfo.GetCultureInfo("vi-VN"));

    private static string GetQrCodeDataUrl(string base64)
    {
        var value = base64?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value.StartsWith("data:image", StringComparison.OrdinalIgnoreCase)
            ? value
            : $"data:image/png;base64,{value}";
    }
}
