@code {
    [Parameter]
    public long OrderId { get; set; }

    private long CurrentUserId;
    private OnlineOrderRecord? Order;
    private OnlineOrderWorkflowResult? Workflow;
    private bool IsLoadingWorkflow;
    private string? WorkflowMessage;
    private string? ErrorMessage;
    private bool IsLoadingPaymentInfo;
    private bool IsRefreshingReceipts;
    private CancellationTokenSource? _receiptPollingCts;
    private Task? _receiptPollingTask;
    private long _receiptTempDetailId;
    private LenhXuatKhoHangNhapKhauTempInsertResponse? PaymentInfo;
    private PaymentQrDecodedInfo? PaymentQrDetails;
    private string? PaymentPopupMessage;
    private bool IsReceiptPaymentPopupOpen;
    private bool IsLoadingReceiptPaymentInfo;
    private BienNhanThanhToanHangNhapKhauTempListItem? SelectedReceiptPaymentItem;
    private string? SelectedReceiptPaymentQrBase64;
    private PaymentQrDecodedInfo? SelectedReceiptPaymentQrDetails;
    private DotNetObjectReference<OnlineOrderDetail>? _receiptPaymentPopupDotNetRef;
    private string? ReceiptPaymentPopupMessage;
    private string? ActiveReceiptActionSo;
    private string? ActiveReceiptActionKind;
    private int WorkflowRunSequence;
    private bool IsPageLoading = true;
    private bool _pageLoadStarted;
    private StorageActionPopupMode? StorageActionMode;
    private bool IsStorageActionPopupOpen;
    private bool IsExecutingStorageAction;
    private bool _shouldInitStorageDatePicker;
    private bool _shouldAutoLoadStorageAction;
    private bool ShowPaymentConfirmDialog;
    private bool ShowReceiptPdfWarningDialog;
    private DateTime? StorageActionDate;
    private string StorageActionDateText = string.Empty;
    private string? StorageActionPopupMessage;
    private bool CanShowPaymentQrButton = true;
    private bool ShowLenhXuatPdfWarningDialog;
    private string? DownloadToastMessage;
    private bool DownloadToastIsError;
    private CancellationTokenSource? DownloadToastCts;

    private enum StorageActionPopupMode
    {
        Payment,
        Extend
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_pageLoadStarted)
        {
            _pageLoadStarted = true;
            await LoadPageAsync();
            return;
        }

        if (!IsStorageActionPopupOpen || !_shouldInitStorageDatePicker)
        {
            if (!IsStorageActionPopupOpen || !_shouldAutoLoadStorageAction)
            {
                return;
            }
        }

        if (_shouldInitStorageDatePicker)
        {
            _shouldInitStorageDatePicker = false;
            await JSRuntime.InvokeVoidAsync("orderDatePicker.initPickupDatePicker", "storageActionDateInput");
        }

        if (_shouldAutoLoadStorageAction)
        {
            _shouldAutoLoadStorageAction = false;
            await ExecuteStorageActionAsync();
        }
    }

    private async Task LoadPageAsync()
    {
        IsPageLoading = true;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            CurrentUserId = GetCurrentUserId(authState.User);

            if (CurrentUserId <= 0)
            {
                ErrorMessage = "Không xác định được tài khoản đăng nhập.";
                return;
            }

            Order = await OnlineOrderService.GetOrderByIdAsync(CurrentUserId, OrderId);

            if (Order is null)
            {
                ErrorMessage = "Không tìm thấy lệnh online.";
                return;
            }

            if (Order.UserId != CurrentUserId)
            {
                ErrorMessage = "Bạn không có quyền xem lệnh này.";
                Order = null;
                return;
            }

            await InvokeAsync(StateHasChanged);
            _ = InvokeAsync(() => RunWorkflowAsync("auto-init"));
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsPageLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Query()
    {
        if (Order is null)
        {
            return;
        }

        var houseBill = Uri.EscapeDataString(Order.HouseBill ?? string.Empty);
        var declarationNumber = Uri.EscapeDataString(Order.DeclarationNumber ?? string.Empty);
        NavigationManager.NavigateTo($"/user/import-check?houseBill={houseBill}&soToKhai={declarationNumber}");
    }

    private async Task RunWorkflowAsync(string source)
    {
        if (Order is null || IsLoadingWorkflow)
        {
            return;
        }

        WorkflowRunSequence++;
        var traceTag = $"{source}-{WorkflowRunSequence}";
        IsLoadingWorkflow = true;
        WorkflowMessage = null;
        Workflow = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            Console.WriteLine($"[{traceTag}] OnlineOrderDetail.RunWorkflowAsync start. OrderId={OrderId}, HouseBill={Order.HouseBill}, Container={Order.ContainerNumber}");
                Workflow = await OnlineOrderService.RunOrderWorkflowAsync(
                    idLenhOnline: OrderId,
                    idDanhMucKhachHangDoiLenh: CurrentUserId,
                    houseBill: Order.HouseBill,
                    soCont: Order.ContainerNumber,
                    idCtLenhNhapKhoHangNhapKhauChiTiet: Order.IDctLenhNhapKhoHangNhapKhauChiTiet,
                    pickupDate: Order.PickupDate,
                    pickupDateStr: Order.PickupDate?.ToString("yyyy/MM/dd"),
                    traceTag: traceTag);

            if (Workflow is not null)
            {
                Workflow.PhiLuuKho = null;
                Workflow.PhiLuuKhoQuaHan = null;
            }

            _receiptTempDetailId = Workflow?.ChiTietHouseBill?.ParsedData?.ID
                ?? Order.IDctLenhNhapKhoHangNhapKhauChiTiet;
            var chiTietHouseBillIdText = Workflow?.ChiTietHouseBill?.ParsedData is not null
                ? Workflow.ChiTietHouseBill.ParsedData.ID.ToString()
                : "null";
            Console.WriteLine($"[{traceTag}] Receipt temp detail id resolved to {_receiptTempDetailId} (ChiTietHouseBill.ID={chiTietHouseBillIdText}, Order.IDctLenhNhapKhoHangNhapKhauChiTiet={Order.IDctLenhNhapKhoHangNhapKhauChiTiet}).");

            if (Workflow?.ChiTietHouseBill?.ParsedData?.DaXacNhanHoanThanhXuatKho == 1)
            {
                Console.WriteLine($"[{traceTag}] DaXacNhanHoanThanhXuatKho=1, dang dong bo HoanThanh cho tblLenhOnlines.");

                if (Order.IsHoanThanh != true)
                {
                    try
                    {
                        await LegacyCustomerPortalService.MarkOrderAsCompletedAsync(Order, traceTag);
                        Order.IsHoanThanh = true;
                        if (Workflow.ChiTietHouseBill.ParsedData is not null)
                        {
                            Workflow.ChiTietHouseBill.ParsedData.IsHoanThanh = true;
                        }

                        Console.WriteLine($"[{traceTag}] Da cap nhat HoanThanh=true thanh cong.");
                    }
                    catch (Exception updateEx)
                    {
                        Console.WriteLine($"[{traceTag}] Cap nhat HoanThanh that bai: {updateEx.Message}");
                    }
                }
                else
                {
                    Console.WriteLine($"[{traceTag}] Bo qua cap nhat HoanThanh vi lenh da duoc danh dau hoan thanh.");
                }
            }

            //Bo check thong quan trong chi tiết
            // var thongQuan = Workflow?.ThongQuan;
            // if (thongQuan is null)
            // {
            //     WorkflowMessage = "Chưa có trạng thái thông quan.";
            // }
            // else if (thongQuan.Success && thongQuan.IsThongQuan)
            // {
            //     WorkflowMessage = "Lấy thông tin thành công.";
            // }
            // else
            // {
            //     WorkflowMessage = string.IsNullOrWhiteSpace(thongQuan.Message)
            //         ? "L?nh chua th?ng quan."
            //         : thongQuan.Message;
            // }
        }
        catch (Exception ex)
        {
            WorkflowMessage = ex.Message;
            Console.WriteLine($"[{traceTag}] OnlineOrderDetail.RunWorkflowAsync error: {ex.Message}");
        }
        finally
        {
            Console.WriteLine($"[{traceTag}] OnlineOrderDetail.RunWorkflowAsync end.");
            IsLoadingWorkflow = false;
            await InvokeAsync(StateHasChanged);
            await UpdateReceiptPollingStateAsync();
        }
    }

