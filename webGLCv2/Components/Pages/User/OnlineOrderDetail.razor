@page "/user/orders/{OrderId:long}"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IAsyncDisposable
@inject LegacyCustomerPortalService LegacyCustomerPortalService
@inject OnlineOrderService OnlineOrderService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Globalization
@using System.Security.Claims
@using System.Threading

<PageTitle>Chi tiết lệnh online</PageTitle>

<section class="page-shell">
    <header class="page-header">
        <div>
            <p class="page-kicker">User Workspace</p>
            <h1>Chi tiết lệnh online</h1>
            <p class="page-subtitle">Hãy rà soát thông tin chính xác trước khi truy vấn theo số House Bill (HBL) hoặc số hiệu Container.</p>
        </div>
        <button class="portal-secondary-action no-print" @onclick="@(() => NavigationManager.NavigateTo("/user/orders"))">Quay lại danh sách</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(DownloadToastMessage))
    {
        <div class="@GetDownloadToastClass()">
            <span class="portal-toast-icon">@GetDownloadToastIcon()</span>
            <span class="portal-toast-message">@DownloadToastMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="portal-alert portal-alert-error">@ErrorMessage</div>
    }
    else if (IsPageLoading)
    {
        <div class="portal-empty-inline">Đang mở trang chi tiết, vui lòng chờ giây lát...</div>
    }
    else
    {
        <section class="workspace-card">
            <div class="section-heading">
                <h2>@Order!.OrderCode</h2>
                <p>Trạng thái hiện tại: <span class="status-chip @GetStatusChipClass(Order.StatusCode)">@GetStatusLabel(Order.IsHoanThanh)</span></p>
            </div>

            <div class="field-grid">
                <div>
                    <label class="portal-label">Họ và tên</label>
                    <input class="portal-input" value="@Order.CustomerName" readonly />
                </div>
                <div>
                    <label class="portal-label">Số điện thoại</label>
                    <input class="portal-input" value="@Order.PhoneNumber" readonly />
                </div>
                <div>
                    <label class="portal-label">Số CMND/CCCD</label>
                    <input class="portal-input" value="@Order.IdentityNumber" readonly />
                </div>
                <div>
                    <label class="portal-label">Biển số xe</label>
                    <input class="portal-input" value="@Order.VehicleNumber" readonly />
                </div>
                <div>
                    <label class="portal-label">Mã số thuế</label>
                    <input class="portal-input" value="@Order.TaxCode" readonly />
                </div>
                <div>
                    <label class="portal-label">Tên công ty</label>
                    <input class="portal-input" value="@Order.CompanyName" readonly />
                </div>
                <div class="field-span-3">
                    <label class="portal-label">Địa chỉ doanh nghiệp</label>
                    <input class="portal-input" value="@Order.CompanyAddress" readonly />
                </div>
                <div>
                    <label class="portal-label">Email liên hệ</label>
                    <input class="portal-input" value="@Order.CompanyEmail" readonly />
                </div>
                <div>
                    <label class="portal-label">Số House Bill</label>
                    <input class="portal-input" value="@Order.HouseBill" readonly />
                </div>
                <div>
                    <label class="portal-label">Ngày làm lệnh</label>
                    <input class="portal-input" value="@(Order.OrderDate.ToString("dd/MM/yyyy HH:mm"))" readonly />
                </div>
                <div>
                    <label class="portal-label">Số hiệu Container</label>
                    <input class="portal-input" value="@Order.ContainerNumber" readonly />
                </div>
                @* <div>
                    <label class="portal-label">Ngày dự kiến lấy hàng</label>
                    <input class="portal-input" value="@(Order.PickupDate?.ToString("dd/MM/yyyy") ?? string.Empty)" readonly />
                </div> *@
                <div>
                    <label class="portal-label">Số tờ khai hải quan</label>
                    <input class="portal-input" value="@Order.DeclarationNumber" readonly />
                </div>
            </div>
            @*
            <div class="form-actions no-print">
                <button class="portal-primary-action query-info-button" @onclick='() => RunWorkflowAsync("button")' disabled="@IsLoadingWorkflow">
                    @(IsLoadingWorkflow ? "Đang truy vấn..." : "Truy vấn thông tin")
                </button>
            </div> *@

            <div class="form-actions no-print">

                <button class="portal-primary-action enhanced-action-btn"
                        @onclick='() => RunWorkflowAsync("button")'
                        disabled="@IsLoadingWorkflow">

                    @if (IsLoadingWorkflow)
                    {
                        <span class="btn-spinner"></span>
                        <span>Đang truy vấn...</span>
                    }
                    else
                    {
                        <i class="fas fa-search"></i>
                        <span>Truy vấn thông tin</span>
                    }

                </button>

            </div>


            @if (!string.IsNullOrWhiteSpace(WorkflowMessage))
            {
                <div class="portal-alert portal-alert-success" style="margin-top:12px;">@WorkflowMessage</div>
            }

            @if (Workflow is not null)
            {
                <section class="workflow-grid">
                    <article class="workflow-card" style="display:none;">
                        <div class="section-heading">
                            <h2>1. Kiểm tra thông quan</h2>
                            <span class="status-chip @GetThongQuanClass(Workflow.ThongQuan)">@GetThongQuanLabel(Workflow.ThongQuan)</span>
                        </div>
                        <p class="workflow-message">@GetWorkflowMessage(Workflow.ThongQuan)</p>
                    </article>

                    <article class="workflow-card" style="display:none;">
                        <div class="section-heading">
                            <h2>2. Phí lưu kho</h2>
                            <span class="status-chip @(HasPhiLuuKho ? "success" : "neutral")">@(HasPhiLuuKho ? "Đã lấy dữ liệu" : "Chưa có dữ liệu")</span>
                        </div>

                        @if (HasPhiLuuKho)
                        {
                            <div class="workflow-payment-row">
                                <span class="status-chip @GetPaymentStatusClass(Workflow.PhiLuuKho!.Data!.TrangThaiThanhToan)">
                                    @*  @GetPaymentStatusLabel(Workflow.PhiLuuKho!.Data!.TrangThaiThanhToan) *@
                                    Chọn nút Thanh toán QRCode để lấy mã thanh toán
                                </span>

                                @* @if (Workflow.PhiLuuKho!.Data!.TrangThaiThanhToan == 0)
                                {
                                    <button class="portal-primary-action" type="button" @onclick="ShowPaymentPopupAsync">
                                        Thanh toán
                                    </button>
                                } *@
                            </div>

                            

                            <div class="workflow-payment-row" style="margin-bottom:12px; gap:12px; flex-wrap:wrap;">
                                <span class="workflow-message" style="margin:0;">
                                    Ngày nhập kho: <strong>@FormatDateTime(GetChiTietHouseBillFromApi()?.NgayNhapKho)</strong>
                                </span>
                                <span class="workflow-message" style="margin:0;">
                                    Ngày gia hạn cuối: <strong>@FormatDateTime(GetChiTietHouseBillFromApi()?.NgayGiaHanCuoi)</strong>
                                </span>
                            </div>

                            <div class="workflow-payment-row no-print" style="margin-bottom:12px; gap:12px; flex-wrap:wrap;">
                                <button type="button" class="portal-primary-action" @onclick="() => OpenStorageActionPopup(StorageActionPopupMode.Payment)">
                                    Thanh toán
                                </button>
                                @if (CanShowExtendAction)
                                {
                                    <button type="button" class="portal-secondary-action" @onclick="() => OpenStorageActionPopup(StorageActionPopupMode.Extend)">
                                        Gia hạn
                                    </button>
                                }
                            </div>

                            <div class="table-shell compact-table">
                                <table class="portal-table">
                                    <thead>
                                        <tr>
                                            <th>Diễn giải 222</th>
                                            <th>Đơn vị tính</th>
                                            <th class="text-end">Đơn giá</th>
                                            <th class="text-end">Tiền hàng</th>
                                            <th class="text-end">Thuế suất</th>
                                            <th class="text-end">Tiền thuế</th>
                                            <th class="text-end">Tổng tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Workflow.PhiLuuKho!.Data!.ChiTietHoaDon)
                                        {
                                            <tr>
                                                <td>@item.MoTa</td>
                                                <td>@item.DonViTinh</td>
                                                <td class="text-end">@FormatMoney(item.DonGia)</td>
                                                <td class="text-end">@FormatMoney(item.TienHangThucTe)</td>
                                                <td class="text-end">@FormatVatPercent(item.ThueSuat)</td>
                                                <td class="text-end">@FormatMoney(item.TienThue)</td>
                                                <td class="text-end">@FormatMoney(item.TongTien)</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="text-success fw-semibold">
                                            <td colspan="3"><strong>Tổng cộng</strong></td>
                                            <td class="text-end"><strong>@FormatMoney(GetPhiSubtotal(Workflow.PhiLuuKho!))</strong></td>
                                            <td></td>
                                            <td class="text-end"><strong>@FormatMoney(GetPhiVatAmount(Workflow.PhiLuuKho!))</strong></td>
                                            <td class="text-end"><strong>@FormatMoney(GetPhiGrandTotal(Workflow.PhiLuuKho!))</strong></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            @if (Workflow.PhiLuuKho!.Data!.TrangThaiThanhToan == 0)
                            {
                                <div class="payment-warning-row">
                                    <div class="portal-alert portal-alert-warning payment-warning">
                                        <span class="payment-warning-icon" aria-hidden="true">!</span>
                                        <span>Vui lòng thanh toán qua QR bằng nút Thanh toán để lấy phiếu giao hàng.</span>
                                    </div>
                                    <button class="portal-primary-action payment-warning-action" type="button" @onclick="ShowPaymentPopupAsync">
                                        Thanh toán
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="workflow-message">@GetPhiLuuKhoMessage(Workflow)</p>
                        }
                    </article>

                    @if (IsOverdueOrder)
                    {
                        <article class="workflow-card workflow-card-overdue" style="display:none;">
                            <div class="section-heading">
                                <h2>2b. Phí lưu kho quá hạn</h2>
                                <span class="status-chip @(HasPhiLuuKhoQuaHan ? "warning" : "neutral")">@(HasPhiLuuKhoQuaHan ? "Đã lấy dữ liệu" : "Chưa có dữ liệu")</span>
                            </div>

                            @if (HasPhiLuuKhoQuaHan)
                            {
                                <div class="workflow-payment-row">
                                    <span class="status-chip @GetPaymentStatusClass(Workflow.PhiLuuKhoQuaHan!.Data!.TrangThaiThanhToan)">
                                        @GetPaymentStatusLabel(Workflow.PhiLuuKhoQuaHan!.Data!.TrangThaiThanhToan)
                                    </span>
                                </div>

                                @if (false && Workflow.PhiLuuKhoQuaHan!.Data!.TrangThaiThanhToan == 0)
                                {
                                    <div class="payment-warning-row">
                                        <div class="portal-alert portal-alert-danger payment-warning">
                                            <span class="payment-warning-icon" aria-hidden="true">!</span>
                                            <span>Vui lòng thanh toán qua QR bằng nút Thanh toán để lấy phiếu giao hàng.</span>
                                        </div>
                                        <button class="portal-primary-action payment-warning-action" type="button" @onclick="ShowPaymentPopupAsync">
                                            Thanh toán
                                        </button>
                                    </div>
                                }

                                <div class="table-shell compact-table">
                                    <table class="portal-table">
                                        <thead>
                                            <tr>
                                                <th>Mô tả</th>
                                                <th>Đơn vị tính</th>
                                                <th class="text-end">Số lượng</th>
                                                <th class="text-end">Đơn giá</th>
                                                <th class="text-end">Thành tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Workflow.PhiLuuKhoQuaHan!.Data!.ChiTietHoaDon)
                                            {
                                                <tr>
                                                    <td>@item.MoTa</td>
                                                    <td>@item.DonViTinh</td>
                                                    <td class="text-end">@FormatNumber(item.SoLuong)</td>
                                                    <td class="text-end">@FormatMoney(item.DonGia)</td>
                                                    <td class="text-end">@FormatMoney(item.ThanhTien)</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td><strong>Tạm tính</strong></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td class="text-end">@FormatMoney(GetPhiSubtotal(Workflow.PhiLuuKhoQuaHan!))</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Phí VAT (@FormatVatPercent(Workflow.PhiLuuKhoQuaHan!.Data!.Vat))</strong></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td class="text-end">@FormatMoney(GetPhiVatAmount(Workflow.PhiLuuKhoQuaHan!))</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Cộng phí + VAT</strong></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td class="text-end"><strong>@FormatMoney(GetPhiGrandTotal(Workflow.PhiLuuKhoQuaHan!))</strong></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>

                                @if (Workflow.PhiLuuKhoQuaHan!.Data!.TrangThaiThanhToan == 0)
                                {
                                    <div class="payment-warning-row">
                                        <div class="portal-alert portal-alert-warning payment-warning">
                                            <span class="payment-warning-icon" aria-hidden="true">!</span>
                                            <span>Vui lòng thanh toán qua QR bằng nút Thanh toán để lấy phiếu giao hàng.</span>
                                        </div>
                                        <button class="portal-primary-action payment-warning-action" type="button" @onclick="ShowPaymentPopupAsync">
                                            Thanh toán
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="workflow-message">@GetPhiLuuKhoQuaHanMessage(Workflow)</p>
                            }
                        </article>
                    }

                    @if (HasConfirmedWarehouseCompletion)
                    {
                        <article class="workflow-card workflow-card-wide" style="order:-2; background: linear-gradient(180deg, #f0fdf4 0%, #ecfdf5 100%); border: 1px solid #86efac; box-shadow: 0 12px 28px rgba(34, 197, 94, 0.12);">
                            <div class="section-heading">
                                <h2 style="color:#166534; font-weight:800; letter-spacing:-0.02em;">
                                    <i class="fas fa-check-circle" aria-hidden="true" style="color:#16a34a; margin-right:8px;"></i>
                                    Xác nhận hoàn thành xuất kho
                                </h2>
                                <span class="status-chip success" style="background:#16a34a; color:#fff; border-color:#16a34a; font-weight:700;">Đã xác nhận</span>
                            </div>
                            <p class="workflow-message" style="margin:0; color:#14532d; font-weight:700; font-size:1.02rem;">
                                Housebill đã xác nhận hoàn thành.
                            </p>
                        </article>
                    }

                    <article class="workflow-card workflow-card-wide" style="order:-1;">
                        <div class="section-heading">
                            <h2>Thông tin chi tiết hàng hoá</h2>
                            <span class="status-chip @(HasChiTietHouseBill ? "success" : HasChiTietHouseBillEmptyData ? "danger" : "neutral")">
                                @(HasChiTietHouseBill ? "Đã lấy dữ liệu thành công" : HasChiTietHouseBillEmptyData ? "Không có dữ liệu" : "Không có dữ liệu chi tiết cho housebill")
                            </span>
                        </div>

                        @if (HasChiTietHouseBillEmptyData)
                        {
                            <div class="portal-empty-state compact" style="margin-top:12px;">
                                <div class="portal-empty-icon">0</div>
                                <h2>Không có dữ liệu chi tiết cho housebill</h2>
                                <p>API Thông tin chi tiết hàng hoá trả về rỗng. Không có dữ liệu để hiển thị.</p>
                            </div>
                        }
                        else if (HasChiTietHouseBill)
                        {
                            <div class="workflow-payment-row" style="margin-bottom:12px;">
                            </div>

                            <div class="table-shell compact-table query-table-scroll">
                                <table class="portal-table">
                                    <thead>
                                        <tr>
                                            <th>Trường</th>
                                            <th>Giá trị</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var chiTiet = GetChiTietHouseBillFromApi();
                                        }
                                        @if (chiTiet is null)
                                        {
                                            <tr><td colspan="2">Không có dữ liệu chi tiết hàng hoá.</td></tr>
                                        }
                                        else
                                        {
                                            <tr style="background:#f8fafc;">
                                                <td style="padding:12px 16px; width:35%; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">
                                                    Số vận đơn
                                                </td>
                                                <td style="padding:12px 16px; color:#111827; border-bottom:1px solid #e5e7eb;">
                                                    @chiTiet.SoVanDon
                                                </td>
                                            </tr>

                                            <tr>
                                                <td style="padding:12px 16px; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">
                                                    Số container
                                                </td>
                                                <td style="padding:12px 16px; color:#111827; border-bottom:1px solid #e5e7eb;">
                                                    @chiTiet.SoContainer
                                                </td>
                                            </tr>

                                            <tr style="background:#f8fafc;">
                                                <td style="padding:12px 16px; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">
                                                    Master Bill
                                                </td>
                                                <td style="padding:12px 16px; color:#111827; border-bottom:1px solid #e5e7eb;">
                                                    @chiTiet.MasterBill
                                                </td>
                                            </tr>

                                            @* 
                                            <tr>
                                                <td style="padding:12px 16px; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">
                                                    Số seal
                                                </td>
                                                <td style="padding:12px 16px; color:#111827; border-bottom:1px solid #e5e7eb;">
                                                    @chiTiet.SoSeal
                                                </td>
                                            </tr> 
                                            *@

                                            <tr>
                                                <td style="padding:12px 16px; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">
                                                    Mã đại lý
                                                </td>
                                                <td style="padding:12px 16px; color:#111827; border-bottom:1px solid #e5e7eb;">
                                                    @chiTiet.MaDanhMucDaiLy
                                                </td>
                                            </tr>

                                            <tr style="background:#f8fafc;">
                                                <td style="padding:12px 16px; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">
                                                    Chủ hàng
                                                </td>
                                                <td style="padding:12px 16px; color:#111827; border-bottom:1px solid #e5e7eb;">
                                                    @chiTiet.TenChuHang
                                                </td>
                                            </tr>

                                            <tr>
                                                <td style="padding:12px 16px; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">
                                                    EDO
                                                </td>
                                                <td style="padding:12px 16px; color:#111827; border-bottom:1px solid #e5e7eb;">
                                                    @chiTiet.EDO
                                                </td>
                                            </tr>

                                            <tr style="background:#f8fafc;">
                                                <td style="padding:12px 16px; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">
                                                    Số lượng kiện nhập
                                                </td>
                                                <td style="padding:12px 16px; color:#059669; font-weight:600; border-bottom:1px solid #e5e7eb;">
                                                    @FormatNumber(chiTiet.SoLuongKienNhap)
                                                </td>
                                            </tr>

                                            <tr>
                                                <td style="padding:12px 16px; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">
                                                    CBM nhập
                                                </td>
                                                <td style="padding:12px 16px; color:#059669; font-weight:600; border-bottom:1px solid #e5e7eb;">
                                                    @FormatNumber(chiTiet.CBMNhap)
                                                </td>
                                            </tr>

                                            <tr style="background:#f8fafc;">
                                                <td style="padding:12px 16px; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">
                                                    Khối lượng nhập
                                                </td>
                                                <td style="padding:12px 16px; color:#059669; font-weight:700; border-bottom:1px solid #e5e7eb;">
                                                    @FormatNumber(chiTiet.KhoiLuongNhap)
                                                </td>
                                            </tr>

                                            <tr>
                                                <td style="padding:12px 16px; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">
                                                    Tên tàu
                                                </td>
                                                <td style="padding:12px 16px; color:#111827; border-bottom:1px solid #e5e7eb;">
                                                    @chiTiet.TenTau
                                                </td>
                                            </tr>

                                            <tr style="background:#f8fafc;">
                                                <td style="padding:12px 16px; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">
                                                    Số chuyến
                                                </td>
                                                <td style="padding:12px 16px; color:#111827; border-bottom:1px solid #e5e7eb;">
                                                    @chiTiet.SoChuyen
                                                </td>
                                            </tr>

                                            <tr>
                                                <td style="padding:12px 16px; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">
                                                    Ngày tàu đến
                                                </td>
                                                <td style="padding:12px 16px; color:#111827; border-bottom:1px solid #e5e7eb;">
                                                    @FormatDateTime(chiTiet.NgayTauDen)
                                                </td>
                                            </tr>

                                            <tr style="background:#f8fafc;">
                                                <td style="padding:12px 16px; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">
                                                    Hàng quá khổ
                                                </td>
                                                <td style="padding:12px 16px; color:#111827; border-bottom:1px solid #e5e7eb;">
                                                    @FormatYesNo(chiTiet.HangQuaKho)
                                                </td>
                                            </tr>

                                            <tr>
                                                <td style="padding:12px 16px; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">
                                                    Hàng quá tải
                                                </td>
                                                <td style="padding:12px 16px; color:#111827; border-bottom:1px solid #e5e7eb;">
                                                    @FormatYesNo(chiTiet.HangQuaTai)
                                                </td>
                                            </tr>

                                            <tr style="background:#f8fafc;">
                                                <td style="padding:12px 16px; font-weight:600; color:#374151;">
                                                    Ngày nhập kho
                                                </td>
                                                <td style="padding:12px 16px; color:#111827;">
                                                    @FormatDateTime(chiTiet.NgayNhapKho)
                                                </td>
                                            </tr>
                                            
                                            @* <tr><td>Mô tả hàng hóa</td><td>@chiTiet.MoTaHangHoa</td></tr>
                                            <tr><td>Mã danh mục đơn vị tính</td><td>@chiTiet.MaDanhMucDonViTinh</td></tr> *@
