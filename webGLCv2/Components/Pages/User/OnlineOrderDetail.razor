    private async Task ConfirmPaymentAsync()
    {
        if (Order is null)
        {
            return;
        }

        ShowPaymentConfirmDialog = false;
        SyncStorageActionDateFromText();
        await InvokeAsync(StateHasChanged);

        IsLoadingPaymentInfo = true;
        PaymentPopupMessage = null;
        PaymentInfo = null;
        PaymentQrDetails = null;

        try
        {
            var chiTiet = GetChiTietHouseBillForPayment();
            if (chiTiet is null)
            {
                PaymentPopupMessage = "Không lấy được dữ liệu chi tiết để tiếp tục thanh toán.";
                return;
            }

            var ngayGiaHan = StorageActionDate ?? chiTiet.NgayGiaHanCuoi ?? chiTiet.NgayNhapKho ?? Order.PickupDate ?? DateTime.Today;
            chiTiet.NgayGiaHanCuoi = ngayGiaHan;
            var currentUserId = CurrentUserId > 0 ? CurrentUserId : GetCurrentUserId((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);

            if (Workflow?.PhiLuuKho?.Data is null)
            {
                await ExecuteStorageActionAsync();
            }

            if (Workflow?.PhiLuuKho?.Data is null)
            {
                PaymentPopupMessage = Workflow?.PhiLuuKho?.Message
                    ?? StorageActionPopupMessage
                    ?? "Không thể tính cước thanh toán.";
                return;
            }

            PaymentInfo = await OnlineOrderService.InsertLenhXuatKhoHangNhapKhauTempAsync(
                Order,
                chiTiet,
                Workflow.PhiLuuKho,
                ngayGiaHan,
                currentUserId);

            if (PaymentInfo is not null && !string.IsNullOrWhiteSpace(PaymentInfo.QRCodeThanhToan))
            {
                CanShowPaymentQrButton = false;
                try
                {
                    await Task.Delay(500);
                    await RefreshPaymentDocumentsAsync(ngayGiaHan);
                    await LegacyCustomerPortalService.UpdateOrderPickupDateAsync(Order, ngayGiaHan);
                    var refreshedOrder = await OnlineOrderService.GetOrderByIdAsync(CurrentUserId, OrderId);
                    if (refreshedOrder is not null)
                    {
                        if (refreshedOrder.UserId != CurrentUserId)
                        {
                            ErrorMessage = "Bạn không có quyền xem lệnh này.";
                            Order = null;
                            return;
                        }

                        Order = refreshedOrder;
                    }
                    else
                    {
                        Order.PickupDate = ngayGiaHan.Date;
                    }

                    try
                    {
                        await RefreshPaymentDocumentsAsync(ngayGiaHan);
                    }
                    catch (Exception refreshEx)
                    {
                        Console.WriteLine($"[PaymentWorkflowRefresh] {refreshEx.Message}");
                    }

                    WorkflowMessage = $"Đã cập nhật ngày lấy hàng dự kiến thành {FormatDateTime(Order.PickupDate)}.";
                }
                catch (Exception updateEx)
                {
                    WorkflowMessage = $"Đã tạo QR, nhưng không cập nhật được ngày lấy hàng: {updateEx.Message}";
                    Console.WriteLine($"[PaymentUpdate] {updateEx.Message}");
                }

                PaymentQrDetails = await JSRuntime.InvokeAsync<PaymentQrDecodedInfo?>(
                    "paymentQr.decodeFromBase64Image",
                    PaymentInfo.QRCodeThanhToan);
            }

            _ = UpdateReceiptPollingStateAsync();
        }
        catch (Exception ex)
        {
            PaymentPopupMessage = ex.Message;
        }
        finally
        {
            IsLoadingPaymentInfo = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task ClosePaymentPopupAsync()
    {
        IsLoadingPaymentInfo = false;
        PaymentPopupMessage = null;
        PaymentInfo = null;
        PaymentQrDetails = null;
        ShowPaymentConfirmDialog = false;
        return Task.CompletedTask;
    }

    private async Task RefreshPaymentDocumentsAsync(DateTime? selectedNgayGiaHan = null)
    {
        if (Order is null)
        {
            return;
        }

        var chiTiet = GetChiTietHouseBillFromApi();
        if (chiTiet is null)
        {
            return;
        }

        if (selectedNgayGiaHan.HasValue)
        {
            chiTiet.NgayGiaHanCuoi = selectedNgayGiaHan.Value;
        }

        var currentUserId = CurrentUserId > 0
            ? CurrentUserId
            : GetCurrentUserId((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);

        var lenhXuatKhoTemps = await OnlineOrderService.GetLenhXuatKhoHangNhapKhauTempListAsync(currentUserId, Order.HouseBill);
        var bienNhanTemps = lenhXuatKhoTemps.Success
            ? await OnlineOrderService.GetBienNhanThanhToanHangNhapKhauTempListAsync(chiTiet.ID, currentUserId)
            : new BienNhanThanhToanHangNhapKhauTempListResponse
            {
                Success = false,
                Message = lenhXuatKhoTemps.Message
            };

        Workflow ??= new OnlineOrderWorkflowResult();
        Workflow.LenhXuatKhoHangNhapKhauTemps = lenhXuatKhoTemps;
        Workflow.BienNhanThanhToanHangNhapKhauTemps = bienNhanTemps;
    }

    private static decimal GetPhiTotal(PhiLuuKhoResponse response)
    {
        var data = response.Data;
        if (data is null)
        {
            return 0m;
        }

        return data.ChiTietHoaDon.Sum(item => item.TienHangThucTe);
    }

    private static decimal GetPhiSubtotal(PhiLuuKhoResponse response)
        => GetPhiTotal(response);

    private static decimal GetPhiVatAmount(PhiLuuKhoResponse response)
    {
        var data = response.Data;
        if (data is null)
        {
            return 0m;
        }

        var explicitVat = data.ChiTietHoaDon.Sum(item => item.TienThue);
        return explicitVat > 0m
            ? explicitVat
            : GetPhiSubtotal(response) * data.Vat / 100m;
    }

    private static decimal GetPhiGrandTotal(PhiLuuKhoResponse response)
    {
        var data = response.Data;
        if (data is null)
        {
            return 0m;
        }

        var explicitGrandTotal = data.ChiTietHoaDon.Sum(item => item.TongTien);
        return explicitGrandTotal > GetPhiSubtotal(response)
            ? explicitGrandTotal
            : GetPhiSubtotal(response) + GetPhiVatAmount(response);
    }

