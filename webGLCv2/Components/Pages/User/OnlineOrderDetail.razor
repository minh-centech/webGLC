    private async Task LoadReceiptPaymentQrDetailsAsync(string qrBase64)
    {
        try
        {
            var decoded = await JSRuntime.InvokeAsync<PaymentQrDecodedInfo?>(
                "paymentQr.decodeFromBase64Image",
                qrBase64);

            if (!IsReceiptPaymentPopupOpen || !string.Equals(SelectedReceiptPaymentQrBase64, qrBase64, StringComparison.Ordinal))
            {
                return;
            }

            SelectedReceiptPaymentQrDetails = decoded;
            if (SelectedReceiptPaymentQrDetails is null)
            {
                ReceiptPaymentPopupMessage = "Không thể đọc thông tin từ mã QR thanh toán.";
            }
        }
        catch (Exception ex)
        {
            if (!IsReceiptPaymentPopupOpen || !string.Equals(SelectedReceiptPaymentQrBase64, qrBase64, StringComparison.Ordinal))
            {
                return;
            }

            ReceiptPaymentPopupMessage = ex.Message;
        }
        finally
        {
            if (IsReceiptPaymentPopupOpen && string.Equals(SelectedReceiptPaymentQrBase64, qrBase64, StringComparison.Ordinal))
            {
                IsLoadingReceiptPaymentInfo = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

