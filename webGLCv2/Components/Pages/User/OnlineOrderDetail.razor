        ShowPaymentConfirmDialog = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(500);
        Console.WriteLine($"[ReceiptPaymentPopup] Opening JS popup for receipt {item.So} after delay");
        try
        {
            _receiptPaymentPopupDotNetRef ??= DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync(
                "paymentQr.showReceiptPaymentPopup",
                new
                {
                    base64 = item.QRCodeThanhToan,
