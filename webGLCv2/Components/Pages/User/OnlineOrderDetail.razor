    private DateTime? GetCurrentNgayGiaHanForExtend()
        => GetLenhXuatKhoTemp()?.NgayGiaHan;

    private static bool IsCreateAction(LenhXuatKhoHangNhapKhauTempListItem temp)
    {
        if (!temp.NgayGiaHan.HasValue)
        {
            return true;
        }

        if (!temp.NgayLap.HasValue)
        {
            return true;
        }

        return temp.NgayGiaHan.Value.Date == temp.NgayLap.Value.Date;
    }

    private static bool IsExtendAction(LenhXuatKhoHangNhapKhauTempListItem temp)
    {
        if (!temp.NgayGiaHan.HasValue || !temp.NgayLap.HasValue)
        {
            return false;
        }

        return temp.NgayGiaHan.Value != temp.NgayLap.Value;
    }

    private void OpenStorageActionPopup(StorageActionPopupMode mode)
    {
        if (Order is null)
        {
            return;
        }

        StorageActionMode = mode;
        PaymentInfo = null;
        PaymentQrDetails = null;
        PaymentPopupMessage = null;
        StorageActionPopupMessage = null;
        WorkflowMessage = null;

        var extendDate = GetCurrentNgayGiaHanForExtend()?.Date.AddDays(1);
        StorageActionDate = mode == StorageActionPopupMode.Payment
            ? DateTime.Today
            : extendDate.HasValue && extendDate.Value < DateTime.Today
                ? DateTime.Today
                : extendDate ?? DateTime.Today.AddDays(1);
        StorageActionDateText = StorageActionDate.HasValue
            ? StorageActionDate.Value.ToString("dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"))
            : string.Empty;
        IsStorageActionPopupOpen = true;
        _shouldInitStorageDatePicker = true;
        _shouldAutoLoadStorageAction = mode == StorageActionPopupMode.Payment
            || mode == StorageActionPopupMode.Extend;
    }

    private void CloseStorageActionPopup()
    {
        IsStorageActionPopupOpen = false;
        IsExecutingStorageAction = false;
        StorageActionPopupMessage = null;
        StorageActionMode = null;
        StorageActionDateText = string.Empty;
        _shouldInitStorageDatePicker = false;
        _shouldAutoLoadStorageAction = false;
        PaymentQrDetails = null;
        ShowPaymentConfirmDialog = false;
        ShowLenhXuatPdfWarningDialog = false;
        ShowReceiptPdfWarningDialog = false;
    }

    private async Task OnStorageActionDateInput(ChangeEventArgs args)
    {
        StorageActionDateText = args.Value?.ToString() ?? string.Empty;
        SyncStorageActionDateFromText();

        if (StorageActionMode == StorageActionPopupMode.Payment)
        {
            PaymentInfo = null;
            PaymentQrDetails = null;
            PaymentPopupMessage = null;
        }

        if (!IsStorageActionPopupOpen || !StorageActionDate.HasValue)
        {
            return;
        }

        await ExecuteStorageActionAsync();
    }

    private void SyncStorageActionDateFromText()
    {
        if (DateTime.TryParseExact(
                StorageActionDateText,
                "dd/MM/yyyy",
                CultureInfo.GetCultureInfo("vi-VN"),
                DateTimeStyles.None,
                out var parsedDate))
        {
            StorageActionDate = parsedDate;
            return;
        }

        StorageActionDate = null;
    }

    private async Task ExecuteStorageActionAsync()
    {
        if (Order is null)
        {
            return;
        }

        if (!StorageActionDate.HasValue)
        {
            StorageActionPopupMessage = "Vui lòng nhập ngày.";
            return;
        }

        IsExecutingStorageAction = true;
        StorageActionPopupMessage = null;

        try
        {
            var ngayGiaHan = StorageActionDate.Value.ToString("yyyy/MM/dd", CultureInfo.InvariantCulture);
            var response = await OnlineOrderService.GetPhiLuuKhoAsync(Order.HouseBill, ngayGiaHan);

            Workflow ??= new OnlineOrderWorkflowResult();
            Workflow.PhiLuuKho = response;

            if (!response.Success)
            {
                StorageActionPopupMessage = response.Message;
                WorkflowMessage = response.Message;
                return;
            }

            if (StorageActionMode == StorageActionPopupMode.Payment
                || StorageActionMode == StorageActionPopupMode.Extend)
            {
                CanShowPaymentQrButton = true;
            }

            WorkflowMessage = StorageActionMode == StorageActionPopupMode.Extend
                ? "Đã tải dữ liệu phí gia hạn và phí lưu kho."
                : "Đã tải dữ liệu thành công.";
        }
        catch (Exception ex)
        {
            StorageActionPopupMessage = ex.Message;
        }
        finally
        {
            IsExecutingStorageAction = false;
            await InvokeAsync(StateHasChanged);
        }
    }

