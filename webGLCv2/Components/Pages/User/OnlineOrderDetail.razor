    private async Task UpdateReceiptPollingStateAsync()
    {
        if (!HasUnpaidReceiptItems())
        {
            Console.WriteLine($"{GetReceiptPollingLogPrefix()} no unpaid receipts found, stopping polling.");
            await StopReceiptPollingAsync();
            return;
        }

        if (_receiptPollingTask is not null && !_receiptPollingTask.IsCompleted)
        {
            Console.WriteLine($"{GetReceiptPollingLogPrefix()} polling already running, skip start.");
            return;
        }

        Console.WriteLine($"{GetReceiptPollingLogPrefix()} unpaid receipts detected ({GetUnpaidReceiptItemCount()} items), starting polling.");
        await StartReceiptPollingAsync();
    }

    private async Task StartReceiptPollingAsync()
    {
        await StopReceiptPollingAsync();

        if (!HasUnpaidReceiptItems())
        {
            Console.WriteLine($"{GetReceiptPollingLogPrefix()} no unpaid receipts at start, polling not started.");
            return;
        }

        _receiptPollingCts = new CancellationTokenSource();
        Console.WriteLine($"{GetReceiptPollingLogPrefix()} polling loop created.");
        _receiptPollingTask = PollReceiptPaymentsAsync(_receiptPollingCts);
    }

    private async Task StopReceiptPollingAsync()
    {
        var receiptPollingCts = _receiptPollingCts;
        _receiptPollingCts = null;
        _receiptPollingTask = null;

        if (receiptPollingCts is null)
        {
            Console.WriteLine($"{GetReceiptPollingLogPrefix()} polling already stopped.");
            return;
        }

        try
        {
            Console.WriteLine($"{GetReceiptPollingLogPrefix()} cancelling polling loop.");
            await receiptPollingCts.CancelAsync();
        }
        catch
        {
        }

        receiptPollingCts.Dispose();
    }

    private async Task PollReceiptPaymentsAsync(CancellationTokenSource receiptPollingCts)
    {
        var cancellationToken = receiptPollingCts.Token;

        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            Console.WriteLine($"{GetReceiptPollingLogPrefix()} loop started, interval=2s.");

            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                Console.WriteLine($"{GetReceiptPollingLogPrefix()} tick fired, unpaid={GetUnpaidReceiptItemCount()}, loading={IsLoadingWorkflow || IsLoadingPaymentInfo || IsLoadingReceiptPaymentInfo || IsExecutingStorageAction}.");

                if (IsLoadingWorkflow || IsLoadingPaymentInfo || IsLoadingReceiptPaymentInfo || IsExecutingStorageAction)
                {
                    Console.WriteLine($"{GetReceiptPollingLogPrefix()} tick skipped because page is busy.");
                    continue;
                }

                if (!HasUnpaidReceiptItems())
                {
                    Console.WriteLine($"{GetReceiptPollingLogPrefix()} no unpaid receipts remain, stopping loop.");
                    break;
                }

                Console.WriteLine($"{GetReceiptPollingLogPrefix()} refreshing receipt temp list from API.");
                await RefreshReceiptPaymentsAsync();

                if (!HasUnpaidReceiptItems())
                {
                    Console.WriteLine($"{GetReceiptPollingLogPrefix()} all receipts are paid after refresh, stopping loop.");
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            try
            {
                receiptPollingCts.Dispose();
            }
            catch
            {
            }

            if (ReferenceEquals(_receiptPollingCts, receiptPollingCts))
            {
                _receiptPollingCts = null;
            }

            Console.WriteLine($"{GetReceiptPollingLogPrefix()} loop ended.");
        }
    }

    private async Task RefreshReceiptPaymentsAsync()
    {
        if (Order is null || CurrentUserId <= 0)
        {
            Console.WriteLine($"{GetReceiptPollingLogPrefix()} cannot refresh because order/current user is missing.");
            return;
        }

        if (IsRefreshingReceipts)
        {
            Console.WriteLine($"{GetReceiptPollingLogPrefix()} refresh already running, skip click.");
            return;
        }

        IsRefreshingReceipts = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            if (_receiptTempDetailId <= 0)
            {
                _receiptTempDetailId = Workflow?.ChiTietHouseBill?.ParsedData?.ID
                    ?? Order.IDctLenhNhapKhoHangNhapKhauChiTiet;
                Console.WriteLine($"{GetReceiptPollingLogPrefix()} resolved receipt temp detail id during refresh: {_receiptTempDetailId}.");
            }

            if (_receiptTempDetailId <= 0)
            {
                Console.WriteLine($"{GetReceiptPollingLogPrefix()} skip refresh because receipt temp detail id is 0.");
                return;
            }

            Console.WriteLine($"{GetReceiptPollingLogPrefix()} calling ListTemp with IDctLenhNhapKhoHangNhapKhauChiTiet={_receiptTempDetailId}, IDDanhMucKhachHangDoLenh={CurrentUserId}.");
            var response = await OnlineOrderService.GetBienNhanThanhToanHangNhapKhauTempListAsync(
                _receiptTempDetailId,
                CurrentUserId);

            if (!response.Success)
            {
                Console.WriteLine($"{GetReceiptPollingLogPrefix()} API returned failure: {response.Message}");
                return;
            }

            var statusSummary = response.Data.Count == 0
                ? "(empty)"
                : string.Join(", ", response.Data.Select(item => $"{item.So}:{(item.DaThanhToan ? "paid" : "unpaid")}"));

            await InvokeAsync(() =>
            {
                Workflow ??= new OnlineOrderWorkflowResult();
                Workflow.BienNhanThanhToanHangNhapKhauTemps = response;
                Console.WriteLine($"{GetReceiptPollingLogPrefix()} API refresh success, unpaid={GetUnpaidReceiptItemCount()}, total={response.Data.Count}, statuses={statusSummary}.");
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"{GetReceiptPollingLogPrefix()} refresh failed: {ex.Message}");
        }
        finally
        {
            IsRefreshingReceipts = false;
            await InvokeAsync(StateHasChanged);
        }
    }

