            }

            return IsExtendAction(lenhXuatKhoTemp);
        }
    }

    private bool CanShowCreateAction
    {
        get
        {
            if (HasCompletedWarehouseAction)
            {
                return false;
            }

            var lenhXuatKhoTemps = Workflow?.LenhXuatKhoHangNhapKhauTemps;
            if (lenhXuatKhoTemps?.Success == true && lenhXuatKhoTemps.Data.Count == 0)
            {
                return true;
            }

            var lenhXuatKhoTemp = GetLenhXuatKhoTemp();
            if (lenhXuatKhoTemp is null)
            {
                return lenhXuatKhoTemps?.Success == true;
            }

            if (IsExtendAction(lenhXuatKhoTemp))
            {
                return false;
            }

            return IsCreateAction(lenhXuatKhoTemp);
        }
    }

