    private static string GetQrCodeDataUrl(string base64)
    {
        var value = base64?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value.StartsWith("data:image", StringComparison.OrdinalIgnoreCase)
            ? value
            : $"data:image/png;base64,{value}";
    }

    private sealed class PaymentQrDecodedInfo
    {
        public bool Success { get; set; }

        public string? ErrorMessage { get; set; }

        public string? RawPayload { get; set; }

        public string? BankName { get; set; }

        public string? BankBin { get; set; }

        public string? AccountNumber { get; set; }

        public decimal? Amount { get; set; }

        public string? TransferContent { get; set; }
    }

    private async Task CopyPaymentQrValueAsync(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync("paymentQr.copyText", value);
    }

    private async Task DownloadQrImageAsync(string? base64, string? receiptNo)
    {
        if (string.IsNullOrWhiteSpace(base64))
        {
            return;
        }

        var safeReceiptNo = string.IsNullOrWhiteSpace(receiptNo)
            ? "qr-thanh-toan"
            : new string(receiptNo.Trim().Where(ch => !Path.GetInvalidFileNameChars().Contains(ch)).ToArray());

        if (string.IsNullOrWhiteSpace(safeReceiptNo))
        {
            safeReceiptNo = "qr-thanh-toan";
        }

        await JSRuntime.InvokeVoidAsync(
            "paymentQr.downloadFile",
            $"qr-{safeReceiptNo}.png",
            "image/png",
            base64);
    }

    private static long GetCurrentUserId(ClaimsPrincipal user)
    {
        var claimValue = user.FindFirstValue("id_khachhang_doilenh")
            ?? user.FindFirstValue(ClaimTypes.NameIdentifier);

        return long.TryParse(claimValue, out var parsedId) ? parsedId : 0;
    }
}

