@page "/user/orders"
@rendermode InteractiveServer
@attribute [Authorize]
@inject OnlineOrderService OnlineOrderService
@inject LegacyCustomerPortalService LegacyCustomerPortalService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Security.Claims
@using System.Globalization

<PageTitle>Lệnh online</PageTitle>

<section class="page-shell">
    <header class="page-header">
        <div>
            <p class="page-kicker">User Workspace</p>
            <h1>Lệnh online</h1>
            <p class="page-subtitle">Theo dõi và quản lý tập trung các lệnh trực tuyến. Dễ dàng tra cứu dữ liệu bằng bộ lọc ngày và công cụ tìm kiếm đa năng (HBL, Cont).</p>
        </div>
        <div class="header-actions">
            @* <button type="button" class="portal-primary-action" @onclick="@(() => NavigationManager.NavigateTo("/user/orders/new"))">Thêm mới</button> *@
            <button type="button" class="portal-secondary-action" @onclick="RefreshDataAsync">Làm mới dữ liệu</button>
        </div>
    </header>

    <section class="workspace-card">
        <form @formname="user-orders-filter-form" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
            <div class="order-filter-panel">
                <div class="order-filter-grid">
                    <div class="order-filter-field">
                        <label class="portal-label">Số House Bill</label>
                        <input class="portal-input order-filter-input" @bind="HouseBillFilter" placeholder="Nhập số House Bill..." />
                    </div>
                    <div class="order-filter-field">
                        <label class="portal-label">Số hiệu Container</label>
                        <input class="portal-input order-filter-input" @bind="ContainerNumberFilter" placeholder="Nhập số hiệu Cont..." />
                    </div>
                    <div class="order-filter-field">
                        <label class="portal-label">Mã số thuế</label>
                        <input class="portal-input order-filter-input" @bind="TaxCodeFilter" placeholder="Nhập mã số thuế..." />
                    </div>
                    <div class="order-filter-field">
                        <label class="portal-label">Từ ngày</label>
                        <input class="portal-input order-filter-input"
                               id="orders-from-date-input"
                               type="text"
                               value="@FromDateText"
                               placeholder="dd/MM/yyyy"
                               @oninput="OnFromDateInput" />
                    </div>
                    <div class="order-filter-field">
                        <label class="portal-label">Đến ngày</label>
                        <input class="portal-input order-filter-input"
                               id="orders-to-date-input"
                               type="text"
                               value="@ToDateText"
                               placeholder="dd/MM/yyyy"
                               @oninput="OnToDateInput" />
                    </div>
                    <div class="order-filter-actions">
                        <button type="submit" class="portal-primary-action order-filter-button">
                            <i class="icon-search"></i> Tìm kiếm
                        </button>
                    </div>
                </div>
            </div>
        </form>

        <div class="table-shell">
            <table class="portal-table dense">
                <thead>
                    <tr>
                        <th>Biển số/ Mã lệnh</th>
                        <th>Ngày lập lệnh</th>
                        <th>Ngày dự kiến lấy</th>
                        <th>House Bill</th>
                        <th>Khách hàng</th>
                        <th>Mã ST/ Tên DN</th>
                        <th>Số hiệu Cont</th>
                        <th>Số tờ khai</th>
                        <th>Trạng thái thanh toán</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Orders.Count == 0)
                    {
                        <tr>
                            <td colspan="9">
                                <div class="portal-empty-inline">
                                    Không tìm thấy lệnh trực tuyến nào trong khoảng thời gian đã chọn.
                                    <br />Vui lòng chọn chức năng <strong>"Kiểm tra hàng nhập"</strong> để khởi tạo.
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var order in Orders)
                        {
                            <tr class="@GetRowClass(order)">
                                <td>
                                    <div class="cell-title">@order.VehicleNumber</div>
                                    <div class="cell-subtitle">@order.OrderCode</div>
                                </td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(order.PickupDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>@order.HouseBill</td>
                                <td>@order.CustomerName</td>
                                <td>
                                    <div class="cell-title">@order.TaxCode</div>
                                    <div class="cell-subtitle">@order.CompanyName</div>
                                </td>
                                <td>@order.ContainerNumber</td>
                                <td>@order.DeclarationNumber</td>
                                <td>
                                    <span class="status-chip @GetPaymentStatusClass(order)">
                                        @GetPaymentStatusLabel(order)
                                    </span>
                                </td>
                                <td >
                                    <span style="display: inline-flex; align-items: center; gap: 8px; border: none;">
                                        <button type="button"
                                            class="portal-primary-action small" @onclick="@(() => ViewDetail(order.Id))">
                                        Xem chi tiết
                                    </button>

                                    @{
                                        if (GetPaymentStatusLabel(order) == "Chưa có biên nhận")
                                        {
                                            <button type="button" title="Xóa lệnh"
                                                    class="portal-danger-action"
                                                    style="display: inline-flex; align-items: center; gap: 6px; background-color: #dc2626; color: white; border: none; padding: 8px 10px; border-radius: 12px; cursor: pointer; font-weight: 500;"
                                                    @onclick="() => DeleteLenhOnLine(order)">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="flex-shrink: 0;">
                                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5Ref 0v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                                </svg>
                                                Xóa
                                            </button>
                                        }
                                    }
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <footer class="workspace-footer">
            <div class="footer-summary">
                <span>Tổng cộng: <strong>@TotalCount</strong> lệnh</span>
                <label class="portal-label pager-label">Hiển thị</label>
                <select class="portal-input pager-size-select" @bind="PageSize" @bind:after="HandlePageSizeChangedAsync">
                    <option value="10">10 dòng</option>
                    <option value="20">20 dòng</option>
                    <option value="50">50 dòng</option>
                </select>
            </div>
            <div class="footer-pagination">
                <button type="button" class="portal-secondary-action pager-button" @onclick="PreviousPageAsync" disabled="@IsFirstPage">Trang trước</button>
                <span>Trang <strong>@CurrentPage</strong> / @TotalPages</span>
                <button type="button" class="portal-secondary-action pager-button" @onclick="NextPageAsync" disabled="@IsLastPage">Trang sau</button>
            </div>
        </footer>
    </section>
</section>

@* --- POPUP CONFIRMATION  --- *@
@if (isDeleteShowing)
{
    <div class="simple-popup-overlay">
        <div class="simple-popup-card">
            <h3 class="simple-popup-title">Xác nhận xóa</h3>
            <p class="simple-popup-text">Bạn có chắc chắn muốn xóa lệnh: <strong>@idLenhOnline</strong>?</p>

            <div class="simple-popup-actions">
                <button type="button" class="btn-simple-cancel" @onclick="CloseDeleteModal" disabled="@isDeleting">
                    Hủy
                </button>
                <button type="button" class="btn-simple-confirm" @onclick="ConfirmDeleteAsync" disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <span>Đang xóa...</span>
                    }
                    else
                    {
                        <span>Đồng ý</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string CurrentUserKey = "anonymous";
    private long CurrentUserId;
    private DateTime FromDate = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime ToDate = new(DateTime.Today.Year, DateTime.Today.Month, DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month));
    private string FromDateText = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("dd/MM/yyyy");
    private string ToDateText = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month)).ToString("dd/MM/yyyy");
    private string HouseBillFilter = string.Empty;
    private string ContainerNumberFilter = string.Empty;
    private string TaxCodeFilter = string.Empty;
    private List<OnlineOrderRecord> Orders = new();
    private int TotalCount;
    private int PageSize = 10;
    private int CurrentPage = 1;
    private bool _shouldInitDatePickers = true;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)PageSize));
    private bool IsFirstPage => CurrentPage <= 1;
    private bool IsLastPage => CurrentPage >= TotalPages;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUserKey = authState.User.Identity?.Name ?? "customer";
        CurrentUserId = long.TryParse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), out var parsedId) ? parsedId : 0;
        await LoadOrdersAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldInitDatePickers)
        {
            _shouldInitDatePickers = false;
            await JSRuntime.InvokeVoidAsync("orderDatePicker.initPickupDatePicker", "orders-from-date-input");
            await JSRuntime.InvokeVoidAsync("orderDatePicker.initPickupDatePicker", "orders-to-date-input");
        }
    }

    private async Task RefreshDataAsync()
    {
        if (CurrentUserId <= 0)
        {
            return;
        }

        //await OnlineOrderService.SeedDefaultsAsync(CurrentUserId);
        await LoadOrdersAsync();
    }

    private async Task SearchAsync()
    {
        SyncDatesFromText();
        if (ToDate < FromDate)
        {
            ToDate = FromDate;
            ToDateText = FormatDate(ToDate);
        }

        CurrentPage = 1;
        await LoadOrdersAsync();
    }

    private async Task HandlePageSizeChangedAsync()
    {
        CurrentPage = 1;
        await LoadOrdersAsync();
    }

    private async Task PreviousPageAsync()
    {
        if (!IsFirstPage)
        {
            CurrentPage--;
            await LoadOrdersAsync();
        }
    }

    private async Task NextPageAsync()
    {
        if (!IsLastPage)
        {
            CurrentPage++;
            await LoadOrdersAsync();
        }
    }

    private async Task LoadOrdersAsync()
    {
        SyncDatesFromText();
        if (CurrentUserId <= 0)
        {
            Orders = new List<OnlineOrderRecord>();
            TotalCount = 0;
            return;
        }

        var result = await OnlineOrderService.GetOrdersAsync(
            CurrentUserId,
            FromDate,
            ToDate,
            HouseBillFilter,
            ContainerNumberFilter,
            TaxCodeFilter,
            CurrentPage,
            PageSize);

        Orders = result.Items.ToList();
        TotalCount = result.TotalCount;
        CurrentPage = result.Page <= 0 ? 1 : result.Page;
    }

    private void OnFromDateInput(ChangeEventArgs args)
    {
        FromDateText = args.Value?.ToString() ?? string.Empty;
        _shouldInitDatePickers = true;
    }

    private void OnToDateInput(ChangeEventArgs args)
    {
        ToDateText = args.Value?.ToString() ?? string.Empty;
        _shouldInitDatePickers = true;
    }

    private void SyncDatesFromText()
    {
        if (DateTime.TryParseExact(FromDateText, "dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"), DateTimeStyles.None, out var fromDate))
        {
            FromDate = fromDate;
            FromDateText = FormatDate(FromDate);
        }
        else
        {
            FromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            FromDateText = FormatDate(FromDate);
        }

        if (DateTime.TryParseExact(ToDateText, "dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"), DateTimeStyles.None, out var toDate))
        {
            ToDate = toDate;
            ToDateText = FormatDate(ToDate);
        }
        else
        {
            ToDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month));
            ToDateText = FormatDate(ToDate);
        }
    }

    private static string FormatDate(DateTime value)
        => value.ToString("dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"));

    private static string GetStatusClass(int statusCode)
        => statusCode switch
        {
            5 => "success",
            3 => "success",
            4 => "warning",
            2 => "warning",
            1 => "pending",
            0 => "neutral",
            _ => "neutral"
        };

    private static string GetPaymentStatusClass(int statusCode)
        => statusCode switch
        {
            2 => "success",
            0 => "pending",
            1 => "warning",
            _ => "neutral"
        };

    private static string GetRowClass(OnlineOrderRecord order)
    {
        var today = DateTime.Today;
        var pickupDate = order.PickupDate?.Date;

        if (order.IsHoanThanh)
        {
            return "order-row-completed";
        }

        if (pickupDate.HasValue && pickupDate.Value < today && order.StatusCode == 0)
        {
            return "order-row-overdue";
        }

        return "order-row-pending";
    }

    private static string GetPaymentStatusClass(OnlineOrderRecord order)
    {
        if (order.SoBienNhanDaThanhToan <= 0 && order.SoBienNhanChuaThanhToan <= 0)
        {
            return "warning";
        }

        if (order.SoBienNhanChuaThanhToan > 0)
        {
            return "danger";
        }

        if (order.SoBienNhanDaThanhToan > 0)
        {
            return "success";
        }

        return "neutral";
    }

    private static string GetPaymentStatusLabel(OnlineOrderRecord order)
    {
        if (order.SoBienNhanDaThanhToan <= 0 && order.SoBienNhanChuaThanhToan <= 0)
        {
            return "Chưa có biên nhận";
        }

        if (order.SoBienNhanChuaThanhToan > 0)
        {
            return "Chưa thanh toán";
        }

        if (order.SoBienNhanDaThanhToan > 0)
        {
            return "Đã thanh toán";
        }

        return "Không xác định";
    }

    private void ViewDetail(string orderId)
    {
        NavigationManager.NavigateTo($"/user/orders/{orderId}");
    }

    private bool isDeleteShowing = false;
    private bool isDeleting = false;
    private long idLenhOnline ;
    private async Task DeleteLenhOnLine(OnlineOrderRecord order)
    {
        isDeleteShowing = true; // Mở popup
        idLenhOnline = order.SequenceNumber;

    }

    private void CloseDeleteModal()
    {
        isDeleteShowing = false; // Đóng popup
        StateHasChanged();
    }

    private async Task ConfirmDeleteAsync()
    {
        isDeleting = true;

        // Gọi API Xóa
        try
        {
            isDeleting = true; // Kích hoạt loading
            StateHasChanged();

            var result = await LegacyCustomerPortalService.DeleteLenhOnline(idLenhOnline);

            // 1. KIỂM TRA LỖI (Theo gói tin mẫu: Status == 1 là BỊ LỖI)
            if (result != null && result.Status == 1)
            {
                // Bắn alert hiển thị lỗi từ SQL/Stored Procedure gửi về
                await JSRuntime.InvokeVoidAsync("alert", "Lỗi từ hệ thống: " + result.ErrorMsg);

                isDeleting = false; // Tắt trạng thái loading để người dùng có thể ấn lại hoặc ấn Hủy
                return; // Dừng lại ở đây, KHÔNG đóng form confirm
            }

            // 2. XỬ LÝ KHI XÓA THÀNH CÔNG (Khi Status != 1, ví dụ bằng 0 hoặc thành công)
            //await JS.InvokeVoidAsync("alert", "Xóa biên nhận và lệnh xuất kho tạm thành công!");

            isDeleteShowing = false; // Đóng popup confirm
            idLenhOnline = -1;     // Reset dữ liệu tạm

            //Cập nhật lại dữ liệu
            await LoadOrdersAsync();

            // Cập nhật lại danh sách hiển thị trên UI của bạn tại đây nếu cần

        }
        catch (HttpRequestException httpEx)
        {
            string errorMsg = $"Lỗi kết nối máy chủ ({httpEx.StatusCode}). Vui lòng thử lại!";
            await JSRuntime.InvokeVoidAsync("alert", errorMsg);
            isDeleting = false; // Tắt loading khi lỗi mạng
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error: " + ex.Message);
            await JSRuntime.InvokeVoidAsync("alert", $"Có lỗi xảy ra: {ex.Message}");
            isDeleting = false; // Tắt loading khi lỗi code
        }
        finally
        {
            isDeleting = false;
            isDeleteShowing = false; // Xóa xong tự đóng popup
            await InvokeAsync(StateHasChanged);
        }

    }
}
