    private async Task UpdatePersonalPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(AccountEmail))
        {
            FeedbackMessage = "Không xác định được email tài khoản để đổi mật khẩu.";
            FeedbackIsError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(PersonalPasswordModel.CurrentPassword)
            || string.IsNullOrWhiteSpace(PersonalPasswordModel.NewPassword)
            || string.IsNullOrWhiteSpace(PersonalPasswordModel.ConfirmNewPassword))
        {
            FeedbackMessage = "Vui lòng nhập đủ mật khẩu cũ, mật khẩu mới và xác nhận mật khẩu mới.";
            FeedbackIsError = true;
            return;
        }

        if (!string.Equals(PersonalPasswordModel.NewPassword, PersonalPasswordModel.ConfirmNewPassword, StringComparison.Ordinal))
        {
            FeedbackMessage = "Mật khẩu mới và xác nhận mật khẩu mới không khớp.";
            FeedbackIsError = true;
            return;
        }

        IsChangingPersonalPassword = true;
        FeedbackMessage = null;

        try
        {
            await LegacyCustomerPortalService.ChangePasswordAsync(
                AccountEmail,
                PersonalPasswordModel.CurrentPassword,
                PersonalPasswordModel.NewPassword,
                PersonalPasswordModel.ConfirmNewPassword);

            FeedbackMessage = "Đã đổi mật khẩu cá nhân thành công.";
            FeedbackIsError = false;

            PersonalPasswordModel.CurrentPassword = string.Empty;
            PersonalPasswordModel.NewPassword = string.Empty;
            PersonalPasswordModel.ConfirmNewPassword = string.Empty;
        }
        catch (Exception ex)
        {
            FeedbackMessage = ex.Message;
            FeedbackIsError = true;
        }
        finally
        {
            IsChangingPersonalPassword = false;
        }
    }

