    private static string DisplayValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? "Chưa cập nhật" : value;

    private static string GetCompanyApprovalStatusText(LegacyCompanyProfile company)
        => company.IsActive ? "Đã duyệt" : "Chờ duyệt";

    private static string GetCompanyApprovalStatusClass(LegacyCompanyProfile company)
        => company.TrangThai switch
        {
            1 => "success",
            -1 => "neutral",
            0 => "pending",
            _ => company.IsActive ? "success" : "pending"
        };

