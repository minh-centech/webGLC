@page "/user/profile"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject LegacyCustomerPortalService LegacyCustomerPortalService
@inject OnlineOrderService OnlineOrderService

<PageTitle>Quản lý thông tin</PageTitle>

<section class="page-shell">
    <header class="page-header">
        <div>
            <p class="page-kicker">User Workspace</p>
            <h1>Quản lý thông tin</h1>
            <p class="page-subtitle">Theo dõi thông tin doanh nghiệp đã đăng ký hoặc tạo mới doanh nghiệp gắn với tài khoản hiện tại.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="portal-alert portal-alert-error">@ErrorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(FeedbackMessage))
    {
        <div class="portal-alert @(FeedbackIsError ? "portal-alert-error" : "portal-alert-success")">@FeedbackMessage</div>
    }

    @if (IsLoading)
    {
        <section class="workspace-card">
            <div class="portal-empty-state compact">
                <div class="portal-empty-icon">...</div>
                <h2>Đang tải thông tin</h2>
                <p>Hệ thống đang đồng bộ hồ sơ doanh nghiệp của tài khoản.</p>
            </div>
        </section>
    }
    else if (AccountType == 2)
    {
        <section class="workspace-card">
            <div class="section-heading">
                <h2>Thông tin doanh nghiệp đã đăng ký</h2>
                <p>Bạn có thể cập nhật thông tin doanh nghiệp bên dưới. Mã số thuế được cố định và không thể thay đổi.</p>
            </div>

            @if (CurrentCompany is null)
            {
                <div class="portal-empty-state compact">
                    <div class="portal-empty-icon">0</div>
                    <h2>Chưa có hồ sơ doanh nghiệp</h2>
                    <p>Tài khoản doanh nghiệp này hiện chưa có bản ghi doanh nghiệp đi kèm trong dữ liệu cũ.</p>
                </div>
            }
            else
            {
                <EditForm Model="EnterpriseProfileModel" OnValidSubmit="UpdateEnterpriseProfileAsync" FormName="enterprise-profile-form">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="portal-alert portal-alert-error" />

                    <div class="field-grid">
                        <div class="field-card">
                            <label class="portal-label" for="EnterpriseName">Tên doanh nghiệp</label>
                            <InputText id="EnterpriseName" class="portal-input" @bind-Value="EnterpriseProfileModel.CompanyName" />
                            <ValidationMessage For="@(() => EnterpriseProfileModel.CompanyName)" class="validation-message" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="EnterpriseTaxCode">Mã số thuế</label>
                            <InputText id="EnterpriseTaxCode" class="portal-input" @bind-Value="EnterpriseProfileModel.TaxCode" disabled />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="EnterpriseEmail">Email doanh nghiệp</label>
                            <InputText id="EnterpriseEmail" class="portal-input" @bind-Value="EnterpriseProfileModel.CompanyEmail" />
                            <ValidationMessage For="@(() => EnterpriseProfileModel.CompanyEmail)" class="validation-message" />
                        </div>

                        <div class="field-card field-span-3">
                            <label class="portal-label" for="EnterpriseAddress">Địa chỉ</label>
                            <InputText id="EnterpriseAddress" class="portal-input" @bind-Value="EnterpriseProfileModel.CompanyAddress" />
                            <ValidationMessage For="@(() => EnterpriseProfileModel.CompanyAddress)" class="validation-message" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="EnterprisePhone">Số điện thoại</label>
                            <InputText id="EnterprisePhone" class="portal-input" @bind-Value="EnterpriseProfileModel.CompanyPhone" />
                            <ValidationMessage For="@(() => EnterpriseProfileModel.CompanyPhone)" class="validation-message" />
                        </div>

                       @*  <div class="field-card">
                            <label class="portal-label" for="EnterpriseFax">Số fax</label>
                            <InputText id="EnterpriseFax" class="portal-input" @bind-Value="EnterpriseProfileModel.CompanyFax" />
                        </div> *@

                        <div class="field-card">
                            <label class="portal-label" for="EnterpriseBusinessLicense">Số giấy phép kinh doanh</label>
                            <InputText id="EnterpriseBusinessLicense" class="portal-input" @bind-Value="EnterpriseProfileModel.BusinessLicenseNumber" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="EnterpriseIssueDate">Ngày cấp</label>
                            <InputDate id="EnterpriseIssueDate" class="portal-input" @bind-Value="EnterpriseProfileModel.IssueDate" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="EnterpriseIssuePlace">Nơi cấp</label>
                            <InputText id="EnterpriseIssuePlace" class="portal-input" @bind-Value="EnterpriseProfileModel.IssuePlace" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="EnterpriseRepresentative">Đại diện có thẩm quyền</label>
                            <InputText id="EnterpriseRepresentative" class="portal-input" @bind-Value="EnterpriseProfileModel.AuthorizedRepresentative" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="EnterpriseRepresentativeTitle">Chức vụ</label>
                            <InputText id="EnterpriseRepresentativeTitle" class="portal-input" @bind-Value="EnterpriseProfileModel.RepresentativeTitle" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="EnterpriseBillingEmail">Email xuất hóa đơn</label>
                            <InputText id="EnterpriseBillingEmail" class="portal-input" @bind-Value="EnterpriseProfileModel.BillingEmail" />
                            <ValidationMessage For="@(() => EnterpriseProfileModel.BillingEmail)" class="validation-message" />
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="portal-primary-action" disabled="@IsSubmitting">
                            @(IsSubmitting ? "Đang cập nhật..." : "Lưu thông tin doanh nghiệp")
                        </button>
                    </div>
                </EditForm>
            }
        </section>

        @if (CurrentCompany is not null)
        {
            <section class="workspace-card" style="margin-top: 16px;">
                <div class="section-heading">
                    <h2>Đổi mật khẩu doanh nghiệp</h2>
                    <p>Nhập mật khẩu cũ, mật khẩu mới và xác nhận mật khẩu mới để cập nhật ngay.</p>
                </div>

                <div class="field-grid">
                    <div class="field-card">
                        <label class="portal-label" for="EnterpriseCurrentPassword">Mật khẩu cũ</label>
                        <InputText id="EnterpriseCurrentPassword" type="password" class="portal-input" @bind-Value="EnterpriseProfileModel.CurrentPassword" />
                    </div>

                    <div class="field-card">
                        <label class="portal-label" for="EnterpriseNewPassword">Mật khẩu mới</label>
                        <InputText id="EnterpriseNewPassword" type="password" class="portal-input" @bind-Value="EnterpriseProfileModel.NewPassword" />
                    </div>

                    <div class="field-card">
                        <label class="portal-label" for="EnterpriseConfirmNewPassword">Nhập lại mật khẩu mới</label>
                        <InputText id="EnterpriseConfirmNewPassword" type="password" class="portal-input" @bind-Value="EnterpriseProfileModel.ConfirmNewPassword" />
                    </div>
                </div>

                <div class="form-actions" style="margin-top: 12px;">
                    <button type="button" class="portal-secondary-action portal-password-action" disabled="@IsChangingEnterprisePassword" @onclick="UpdateEnterprisePasswordAsync">
                        @(IsChangingEnterprisePassword ? "Đang đổi mật khẩu..." : "Đổi mật khẩu")
                    </button>
                </div>
            </section>
        }
    }
    else
    {
        <section class="workspace-card">
            <div class="section-heading">
                <h2>Thông tin tài khoản cá nhân</h2>
                <p>Cập nhật họ và tên, số điện thoại và xem email cá nhân hiện tại.</p>
            </div>

            <EditForm Model="PersonalProfileModel" OnValidSubmit="UpdatePersonalInfoAsync" FormName="personal-profile-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="portal-alert portal-alert-error" />

                <div class="field-grid">
                    <div class="field-card">
                        <label class="portal-label" for="PersonalFullName">Họ và tên</label>
                        <InputText id="PersonalFullName" class="portal-input" @bind-Value="PersonalProfileModel.FullName" />
                        <ValidationMessage For="@(() => PersonalProfileModel.FullName)" class="validation-message" />
                    </div>

                    <div class="field-card">
                        <label class="portal-label" for="PersonalPhone">Số điện thoại</label>
                        <InputText id="PersonalPhone" class="portal-input" @bind-Value="PersonalProfileModel.PhoneNumber" />
                        <ValidationMessage For="@(() => PersonalProfileModel.PhoneNumber)" class="validation-message" />
                    </div>

                    <div class="field-card">
                        <label class="portal-label" for="PersonalEmail">Email cá nhân</label>
                        <input id="PersonalEmail" class="portal-input" value="@AccountEmail" readonly />
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="portal-primary-action" disabled="@IsSubmitting">
                        @(IsSubmitting ? "Đang cập nhật..." : "Cập nhật thông tin")
                    </button>
                </div>
            </EditForm>
        </section>

        <section class="workspace-card" style="margin-top: 16px;">
            <div class="section-heading">
                <h2>Đổi mật khẩu</h2>
                <p>Nhập mật khẩu cũ và mật khẩu mới để thay đổi mật khẩu đăng nhập.</p>
            </div>

            <EditForm Model="PersonalPasswordModel" OnValidSubmit="UpdatePersonalPasswordAsync" FormName="personal-password-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="portal-alert portal-alert-error" />

                <div class="field-grid">
                    <div class="field-card">
                        <label class="portal-label" for="PersonalCurrentPassword">Mật khẩu cũ</label>
                        <InputText id="PersonalCurrentPassword" type="password" class="portal-input" @bind-Value="PersonalPasswordModel.CurrentPassword" />
                    </div>

                    <div class="field-card">
                        <label class="portal-label" for="PersonalNewPassword">Mật khẩu mới</label>
                        <InputText id="PersonalNewPassword" type="password" class="portal-input" @bind-Value="PersonalPasswordModel.NewPassword" />
                    </div>

                    <div class="field-card">
                        <label class="portal-label" for="PersonalConfirmNewPassword">Nhập lại mật khẩu mới</label>
                        <InputText id="PersonalConfirmNewPassword" type="password" class="portal-input" @bind-Value="PersonalPasswordModel.ConfirmNewPassword" />
                    </div>
                </div>

                <div class="form-actions" style="margin-top: 12px;">
                    <button type="submit" class="portal-secondary-action portal-password-action" disabled="@IsChangingPersonalPassword">
                        @(IsChangingPersonalPassword ? "Đang đổi mật khẩu..." : "Đổi mật khẩu")
                    </button>
                </div>
            </EditForm>
        </section>

        <section class="workspace-card">
            <div class="section-heading">
                <div>
                    <h2>Tạo mới doanh nghiệp</h2>
                    <p>Tài khoản cá nhân có thể tạo thêm nhiều hồ sơ doanh nghiệp để phục vụ nghiệp vụ sau này.</p>
                </div>
                <button type="button" class="portal-secondary-action" @onclick="ToggleCreateCompanySection">
                    @(IsCreateCompanyExpanded ? "−" : "+")
                </button>
            </div>

            @if (IsCreateCompanyExpanded)
            {
                <EditForm Model="FormModel" OnValidSubmit="CreateCompanyAsync" FormName="personal-company-form">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="portal-alert portal-alert-error" />

                    <div class="field-grid">
                        <div class="field-card field-span-3">
                            <label class="portal-label" for="TenDoanhNghiep">Tên doanh nghiệp</label>
                            <InputText id="TenDoanhNghiep" class="portal-input" @bind-Value="FormModel.TenDoanhNghiep" />
                            <ValidationMessage For="@(() => FormModel.TenDoanhNghiep)" class="validation-message" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="MaSoThue">Mã số thuế</label>
                            <InputText id="MaSoThue" class="portal-input" @bind-Value="FormModel.MaSoThue" />
                            <ValidationMessage For="@(() => FormModel.MaSoThue)" class="validation-message" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="EmailDoanhNghiep">Email doanh nghiệp</label>
                            <InputText id="EmailDoanhNghiep" class="portal-input" @bind-Value="FormModel.EmailDoanhNghiep" />
                            <ValidationMessage For="@(() => FormModel.EmailDoanhNghiep)" class="validation-message" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="EmailDoanhNghiep">Email nhận hoá đơn</label>
                            <InputText id="EmailDoanhNghiep" class="portal-input" @bind-Value="FormModel.EmailDoanhNghiep" />
                            <ValidationMessage For="@(() => FormModel.EmailDoanhNghiep)" class="validation-message" />
                        </div>

                        <div class="field-card field-span-3">
                            <label class="portal-label" for="DiaChi">Địa chỉ</label>
                            <InputText id="DiaChi" class="portal-input" @bind-Value="FormModel.DiaChi" />
                            <ValidationMessage For="@(() => FormModel.DiaChi)" class="validation-message" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="SoDienThoaiDoanhNghiep">Số điện thoại doanh nghiệp</label>
                            <InputText id="SoDienThoaiDoanhNghiep" class="portal-input" @bind-Value="FormModel.SoDienThoaiDoanhNghiep" />
                            <ValidationMessage For="@(() => FormModel.SoDienThoaiDoanhNghiep)" class="validation-message" />
                        </div>

                       @*  <div class="field-card">
                            <label class="portal-label" for="SoFax">Số fax</label>
                            <InputText id="SoFax" class="portal-input" @bind-Value="FormModel.SoFax" />
                        </div> *@

                        <div class="field-card">
                            <label class="portal-label" for="GiayPhepKinhDoanh">Số giấy phép kinh doanh</label>
                            <InputText id="GiayPhepKinhDoanh" class="portal-input" @bind-Value="FormModel.GiayPhepKinhDoanh" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="NgayCap">Ngày cấp</label>
                            <InputDate id="NgayCap" class="portal-input" @bind-Value="FormModel.NgayCap" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="NoiCap">Nơi cấp</label>
                            <InputText id="NoiCap" class="portal-input" @bind-Value="FormModel.NoiCap" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="DaiDienCoThamQuyen">Đại diện có thẩm quyền</label>
                            <InputText id="DaiDienCoThamQuyen" class="portal-input" @bind-Value="FormModel.DaiDienCoThamQuyen" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="ChucVu">Chức vụ</label>
                            <InputText id="ChucVu" class="portal-input" @bind-Value="FormModel.ChucVu" />
                        </div>

                       @*  <div class="field-card">
                            <label class="portal-label" for="DoanhNghiepCongTyDuocUyQuyen">Doanh nghiệp/công ty được ủy quyền</label>
                            <InputText id="DoanhNghiepCongTyDuocUyQuyen" class="portal-input" @bind-Value="FormModel.DoanhNghiepCongTyDuocUyQuyen" />
                        </div> *@

                        <div class="field-card">
                            <label class="portal-label" for="TenDangNhapDangKyDichVu">Tên đăng nhập đăng ký dịch vụ</label>
                            <InputText id="TenDangNhapDangKyDichVu" class="portal-input" @bind-Value="FormModel.TenDangNhapDangKyDichVu" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="EmailXuatHoaDon">Email xuất hóa đơn</label>
                            <InputText id="EmailXuatHoaDon" class="portal-input" @bind-Value="FormModel.EmailXuatHoaDon" />
                            <ValidationMessage For="@(() => FormModel.EmailXuatHoaDon)" class="text-danger" />
                        </div>

                        <div class="field-card">
                            <label class="portal-label" for="SoCMNDCanCuoc">Số CMND/CCCD</label>
                            <InputText id="SoCMNDCanCuoc" class="portal-input" @bind-Value="FormModel.SoCMNDCanCuoc" />
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="portal-primary-action" disabled="@IsSubmitting">
                            @(IsSubmitting ? "Đang tạo..." : "Tạo mới doanh nghiệp")
                        </button>
                    </div>
                </EditForm>
            }
        </section>

        @if (Companies.Count > 0)
        {
            <section class="workspace-card">
                <div class="section-heading">
                    <h2>Doanh nghiệp đã tạo</h2>
                    <p>Các hồ sơ doanh nghiệp đã gắn với tài khoản cá nhân này.</p>
                </div>

                <div class="table-shell">
                    <table class="portal-table">
                        <thead>
                            <tr>
                                <th>Tên doanh nghiệp</th>
                                <th>Mã số thuế</th>
                                <th>Điện thoại</th>
                                <th>Email</th>
                                <th>Email xuất hóa đơn</th>
                                <th>Thao tác</th>
                                <th>Trạng thái duyệt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var company in Companies)
                            {
                                <tr>
                                    <td>@company.TenDoanhNghiep</td>
                                    <td>@company.MaSoThue</td>
                                    <td>@company.SoDienThoaiDoanhNghiep</td>
                                    <td>@company.EmailDoanhNghiep</td>
                                    <td>@company.EmailXuatHoaDon</td>
                                    <td>
                                        <button type="button" class="portal-secondary-action" @onclick="() => OpenCompanyEditPopup(company)">Sửa</button>
                                    </td>
                                    <td>
                                        <span class="status-chip @GetCompanyApprovalStatusClass(company)">@GetCompanyApprovalStatusText(company)</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</section>

@if (IsCompanyEditPopupOpen && EditingCompany is not null)
{
    <div class="portal-modal-backdrop" @onclick="CloseCompanyEditPopup">
        <div class="portal-modal" @onclick:stopPropagation="true">
            <div>
                <h3>Sửa doanh nghiệp</h3>
                <p>Cập nhật thông tin doanh nghiệp cho tài khoản cá nhân đang đăng nhập.</p>
            </div>

            <EditForm Model="CompanyEditModel" OnValidSubmit="SaveCompanyEditAsync" FormName="company-edit-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="portal-alert portal-alert-error" />

                <div class="field-grid">
                    <div class="field-card field-span-3">
                        <label class="portal-label" for="EditCompanyName">Tên doanh nghiệp</label>
                        <InputText id="EditCompanyName" class="portal-input" @bind-Value="CompanyEditModel.CompanyName" />
                        <ValidationMessage For="@(() => CompanyEditModel.CompanyName)" class="validation-message" />
                    </div>

                    <div class="field-card">
                        <label class="portal-label" for="EditCompanyPhone">Điện thoại</label>
                        <InputText id="EditCompanyPhone" class="portal-input" @bind-Value="CompanyEditModel.CompanyPhone" />
                        <ValidationMessage For="@(() => CompanyEditModel.CompanyPhone)" class="validation-message" />
                    </div>

                    <div class="field-card">
                        <label class="portal-label" for="EditCompanyEmail">Email xuất hóa đơn</label>
                        <InputText id="EditCompanyEmail" class="portal-input" @bind-Value="CompanyEditModel.CompanyEmail" />
                        <ValidationMessage For="@(() => CompanyEditModel.CompanyEmail)" class="validation-message" />
                    </div>

                    <div class="field-card field-span-3">
                        <label class="portal-label" for="EditCompanyAddress">Địa chỉ</label>
                        <InputText id="EditCompanyAddress" class="portal-input" @bind-Value="CompanyEditModel.CompanyAddress" />
                        <ValidationMessage For="@(() => CompanyEditModel.CompanyAddress)" class="validation-message" />
                    </div>
                </div>

                <div class="portal-modal-actions">
                    <button type="button" class="portal-secondary-action" @onclick="CloseCompanyEditPopup">Hủy</button>
                    <button type="submit" class="portal-primary-action" disabled="@IsCompanySaving">
                        @(IsCompanySaving ? "Đang lưu..." : "Lưu thay đổi")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private readonly UserCompanyFormModel FormModel = new();
    private readonly PersonalProfileFormModel PersonalProfileModel = new();
    private readonly PersonalPasswordFormModel PersonalPasswordModel = new();
    private readonly EnterpriseProfileFormModel EnterpriseProfileModel = new();
    private readonly List<LegacyCompanyProfile> Companies = new();
    private LegacyCompanyProfile? CurrentCompany;
    private LegacyCompanyProfile? EditingCompany;
    private readonly CompanyEditFormModel CompanyEditModel = new();
    private string AccountId = string.Empty;
    private int AccountType;
    private string AccountEmail = string.Empty;
    private bool IsLoading = true;
    private bool IsSubmitting;
    private bool IsChangingPersonalPassword;
    private bool IsChangingEnterprisePassword;
    private bool IsCreateCompanyExpanded;
    private bool IsCompanyEditPopupOpen;
    private bool IsCompanySaving;
    private string? ErrorMessage;
    private string? FeedbackMessage;
    private bool FeedbackIsError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            AccountId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            AccountType = int.TryParse(user.FindFirst("account_type")?.Value, out var parsedAccountType) ? parsedAccountType : 1;
            AccountEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? user.Identity?.Name ?? string.Empty;

            Companies.Clear();
            if (!string.IsNullOrWhiteSpace(AccountId))
            {
                Companies.AddRange(await LegacyCustomerPortalService.GetCompaniesByCustomerAsync(AccountId));

                var accountDetails = await LegacyCustomerPortalService.GetAccountDocumentsAsync(AccountId);

                Console.WriteLine($"AccountId: {AccountId}");
                Console.WriteLine($"accountDetails: {accountDetails.Email}");
                if (AccountType == 1)
                {
                    PersonalProfileModel.FullName = accountDetails.Name;
                    PersonalProfileModel.PhoneNumber = accountDetails.Phone;
                    PersonalProfileModel.BillingEmail = string.IsNullOrWhiteSpace(accountDetails.BillingEmail)
                        ? accountDetails.Email
                        : accountDetails.BillingEmail;
                }

                AccountEmail = string.IsNullOrWhiteSpace(accountDetails.Email)
                    ? AccountEmail
                    : accountDetails.Email;
                Console.WriteLine($"AccountEmail: {AccountEmail}");
            }

            CurrentCompany = Companies.FirstOrDefault();

            if (AccountType == 2 && CurrentCompany is not null)
            {
                EnterpriseProfileModel.CompanyName = CurrentCompany.TenDoanhNghiep ?? string.Empty;
                EnterpriseProfileModel.TaxCode = CurrentCompany.MaSoThue ?? string.Empty;
                EnterpriseProfileModel.CompanyEmail = CurrentCompany.EmailDoanhNghiep ?? string.Empty;
                EnterpriseProfileModel.CompanyAddress = CurrentCompany.DiaChi ?? string.Empty;
                EnterpriseProfileModel.CompanyPhone = CurrentCompany.SoDienThoaiDoanhNghiep ?? string.Empty;
                EnterpriseProfileModel.CompanyFax = CurrentCompany.SoFax ?? string.Empty;
                EnterpriseProfileModel.BusinessLicenseNumber = CurrentCompany.GiayPhepKinhDoanh ?? string.Empty;
                EnterpriseProfileModel.IssueDate = CurrentCompany.NgayCap;
                EnterpriseProfileModel.IssuePlace = CurrentCompany.NoiCap ?? string.Empty;
                EnterpriseProfileModel.AuthorizedRepresentative = CurrentCompany.DaiDienCoThamQuyen ?? string.Empty;
                EnterpriseProfileModel.RepresentativeTitle = CurrentCompany.ChucVu ?? string.Empty;
                EnterpriseProfileModel.BillingEmail = CurrentCompany.EmailXuatHoaDon ?? string.Empty;
            }

            EnterpriseProfileModel.CurrentPassword = string.Empty;
            EnterpriseProfileModel.NewPassword = string.Empty;
            EnterpriseProfileModel.ConfirmNewPassword = string.Empty;
            PersonalPasswordModel.CurrentPassword = string.Empty;
            PersonalPasswordModel.NewPassword = string.Empty;
            PersonalPasswordModel.ConfirmNewPassword = string.Empty;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

